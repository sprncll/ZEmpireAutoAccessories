<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Workstation GC, not Server GC. Server GC is the ASP.NET Core default
         and reserves a heap per core, which assumes a machine with gigabytes
         to spare. Shared hosting gives this app 256 MB, and generating a PDF
         receipt - native rendering, fonts, images - is the spike that would
         meet the ceiling. A shop with a few people on it at once never needs
         what Server GC buys, so the trade is free here. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>

    <!-- Out-of-process, not the in-process default. On shared hosting the
         sites share one IIS application pool, and the in-process model loads
         the app INTO that pool's worker - which the host does not allow,
         because one tenant's app would then sit inside a process shared with
         everyone else's. SmarterASP.NET says so in its own publishing guide.

         The cost is a local reverse-proxy hop per request, which is not
         measurable next to the trip from the Philippines to the datacentre.
         On a host that permits in-process - a VPS, Azure, IIS you own -
         delete this line to get it back. -->
    <AspNetCoreHostingModel>OutOfProcess</AspNetCoreHostingModel>
  </PropertyGroup>

  <!-- App_Data holds what the SHOP owns: the cut sizes it measured, the
       per-product measures, the stock postings, the proof-of-payment files.
       Publishing it would copy the repository's copy over the shop's own on
       every redeploy, so a bug fix would silently revert their cut sizes.
       It is uploaded once, by hand, and left alone thereafter. -->
  <ItemGroup>
    <Content Remove="App_Data\**" />
    <None Include="App_Data\**" CopyToOutputDirectory="Never" CopyToPublishDirectory="Never" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Database\" />
    <Folder Include="ViewModels\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="8.0.8" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.8" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.0.8" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="8.0.8">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="QuestPDF" Version="2024.10.3" />
  </ItemGroup>

</Project>

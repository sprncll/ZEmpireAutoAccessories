@model ZEmpireAutoAccessories.Models.Customer

@{
    ViewData["Title"] = "New Customer";
}

<style>

    .form-label {
        font-weight: 600;
        font-size: 13.5px;
        color: #0b0b0c;
    }
</style>

<div class="zx-page-head">
    <h1>New Customer</h1>
</div>
<p class="zx-page-sub">Add a customer record before registering their vehicles.</p>

<div class="zx-card padded narrow">
    <form asp-action="Create" method="post" class="zx-form">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

        @{
            var lastName = ViewData["LastName"] as string ?? string.Empty;
            var firstName = ViewData["FirstName"] as string ?? string.Empty;
        }

        @* Last name first, because that is the order a customer gives it at a
           counter. The column holds one name and PersonName puts these back
           together, so nothing downstream changes. *@
        <div class="row g-3 align-items-start">
            <div class="col-lg-7">
                <label class="form-label mb-1">Full name</label>
                <div class="row g-2">
                    <div class="col-sm-6">
                        <input type="text" id="lastName" name="lastName" class="form-control"
                               value="@lastName" maxlength="80" autofocus
                               placeholder="Dela Cruz" autocomplete="family-name" required />
                        <div class="form-text">Last name</div>
                        @Html.ValidationMessage("lastName", null, new { @class = "text-danger" })
                    </div>
                    <div class="col-sm-6">
                        <input type="text" id="firstName" name="firstName" class="form-control"
                               value="@firstName" maxlength="60"
                               placeholder="Juan" autocomplete="given-name" required />
                        <div class="form-text">First name</div>
                        @Html.ValidationMessage("firstName", null, new { @class = "text-danger" })
                    </div>
                </div>
            </div>

            <div class="col-lg-5">
                <label for="ContactNumber" class="form-label mb-1">Contact number</label>
                <div class="input-group">
                    <span class="input-group-text">+63</span>
                    <input type="text" id="ContactNumber" name="ContactNumber"
                           class="form-control" placeholder="9121231231"
                           value="@PhoneNumber.ToLocalDigits(Model.ContactNumber)"
                           inputmode="numeric" maxlength="10" autocomplete="tel" required />
                </div>
                <div class="form-text">Ten digits beginning 9. One number, one customer.</div>
                <span asp-validation-for="ContactNumber" class="text-danger"></span>
            </div>
        </div>

        <div class="mt-3">
            <span asp-validation-for="FullName" class="text-danger"></span>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn-zx">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2Z" /><path d="M17 21v-8H7v8" /><path d="M7 3v5h8" /></svg>
                Save
            </button>
            <a href="@BackLink.For(Context.Request, Url.Action("Index"))" class="btn btn-outline-secondary">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Stored as +63 then ten digits, so the box beside the +63 holds the
        // ten and nothing else. A pasted "0912 123 1231" or "+63 912 123 1231"
        // is reduced to those ten digits as it lands, rather than refused.
        (function () {
            var contact = document.getElementById('ContactNumber');
            if (!contact) { return; }

            function tidy() {
                var digits = contact.value.replace(/\D/g, '');

                if (digits.length === 12 && digits.indexOf('63') === 0) { digits = digits.slice(2); }
                else if (digits.length === 11 && digits.charAt(0) === '0') { digits = digits.slice(1); }

                digits = digits.slice(0, 10);
                if (digits !== contact.value) { contact.value = digits; }
            }

            contact.addEventListener('input', tidy);
            // Paste fires before the box holds the new text, so read it after.
            contact.addEventListener('paste', function () { setTimeout(tidy, 0); });
        })();
    </script>
}
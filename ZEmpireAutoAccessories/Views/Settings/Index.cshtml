@model ZEmpireAutoAccessories.Models.ShopSettings

@{
    ViewData["Title"] = "Settings";
    var success = TempData["Success"] as string;
}

<div class="zx-page-head">
    <h1>Settings</h1>
</div>
<p class="zx-page-sub">
    What the shop is called, what it charges tax at, and when stock counts as low. These were written
    into the code; changing them here changes every document and every list at once.
</p>

@if (!string.IsNullOrEmpty(success))
{
    <div class="alert alert-success py-2 px-3">@success</div>
}

<div class="zx-card padded narrow">
    <form asp-action="Index" method="post" class="zx-form">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

        <h6 class="section-head">The shop</h6>
        <p class="section-sub">Printed at the top of every quotation, job order, invoice and receipt.</p>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="ShopName" class="form-label"></label>
                <input asp-for="ShopName" class="form-control" maxlength="120" />
                <span asp-validation-for="ShopName" class="text-danger"></span>
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="Tagline" class="form-label"></label>
                <input asp-for="Tagline" class="form-control" maxlength="120" />
                <div class="form-text">The line under the name. Leave it empty for none.</div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="Address" class="form-label"></label>
                <input asp-for="Address" class="form-control" maxlength="200" placeholder="Unit 3, Rizal Avenue, Olongapo City" />
            </div>
            <div class="col-md-3 mb-3">
                <label asp-for="ContactNumber" class="form-label"></label>
                <input asp-for="ContactNumber" class="form-control" maxlength="60" placeholder="+63 912 123 1231" />
            </div>
            <div class="col-md-3 mb-3">
                <label asp-for="TaxId" class="form-label"></label>
                <input asp-for="TaxId" class="form-control" maxlength="40" placeholder="000-000-000-000" />
                @* A VAT-registered business prints its TIN on every sales
                   invoice and official receipt. The PDFs could not before. *@
                <div class="form-text">Printed on the invoices.</div>
            </div>
        </div>

        <h6 class="section-head">Tax</h6>
        <p class="section-sub">
            Prices in this system are VAT-inclusive: the figure on the board is the figure the customer
            hands over, and the VAT is worked back out of it. Set the rate to 0 if the shop is not
            VAT-registered.
        </p>

        <div class="row">
            <div class="col-md-4 mb-3">
                <label asp-for="VatPercent" class="form-label"></label>
                <div class="input-group">
                    <input asp-for="VatPercent" type="number" step="0.01" min="0" max="100" class="form-control" />
                    <span class="input-group-text">%</span>
                </div>
                <span asp-validation-for="VatPercent" class="text-danger"></span>
                <div class="form-text">12% since 2006. BIR sets it, not this system.</div>
            </div>
        </div>

        <h6 class="section-head">Low stock</h6>
        <p class="section-sub">
            When a product starts showing as <span class="badge badge-low">Low Stock</span> on the
            inventory list and on the dashboard. Counted goods and film are asked separately, because
            five pieces of something and five centimetres of film are not the same kind of nearly-out.
        </p>

        <div class="row">
            <div class="col-md-4 mb-3">
                <label asp-for="LowStockPieces" class="form-label"></label>
                <div class="input-group">
                    <input asp-for="LowStockPieces" type="number" step="1" min="1" class="form-control" />
                    <span class="input-group-text">pcs</span>
                </div>
                <span asp-validation-for="LowStockPieces" class="text-danger"></span>
            </div>
            <div class="col-md-4 mb-3">
                <label asp-for="LowStockMetres" class="form-label"></label>
                <div class="input-group">
                    <input asp-for="LowStockMetres" type="number" step="0.5" min="0.5" class="form-control" />
                    <span class="input-group-text">m</span>
                </div>
                <span asp-validation-for="LowStockMetres" class="text-danger"></span>
                <div class="form-text">Film and tint, which the shelf holds in metres.</div>
            </div>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn-zx">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2Z"/><path d="M17 21v-8H7v8"/><path d="M7 3v5h8"/></svg>
                Save settings
            </button>
            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
        </div>
    </form>
</div>

<style>
    .section-head { font-size: 13px; font-weight: 700; text-transform: uppercase; letter-spacing: .5px;
                    color: #6b7280; margin-top: 6px; }
    .section-head:not(:first-of-type) { margin-top: 26px; padding-top: 20px; border-top: 1px solid #eef0f4; }
    .section-sub { font-size: 12.5px; color: #7b8290; margin: -2px 0 14px; max-width: 70ch; }
    .badge-low { background: rgba(245,158,11,.15); color: #b45309; font-weight: 600; }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

@model IEnumerable<ZEmpireAutoAccessories.Models.VwQuotationSummary>

@{
    ViewData["Title"] = "Quotations Report";
    var from = ViewData["From"] as DateOnly?;
    var to = ViewData["To"] as DateOnly?;
    var status = ViewData["Status"] as string;
    var total = (decimal)ViewData["Total"]!;
}

<style>
    .zx-page-head h1 { font-family:'Oswald',system-ui,sans-serif; font-weight:700; font-size:22px; margin:0 0 18px; color:#0b0b0c; }
    .report-tabs { display:flex; gap:8px; margin-bottom:18px; flex-wrap:wrap; }
    .report-tabs a { padding:7px 16px; border-radius:999px; font-size:13.5px; font-weight:600; color:#4b5563;
                     background:#fff; border:1px solid #e8ebf0; text-decoration:none; }
    .report-tabs a.active, .report-tabs a:hover { background:#0b0b0c; color:#fff; border-color:#0b0b0c; }
    .zx-card { background:#fff; border:1px solid #e8ebf0; border-radius:14px; overflow:hidden; }
    .zx-table thead { background:#0b0b0c; color:#fff; }
    .zx-table thead th { border-bottom:none; font-weight:600; font-size:13px; text-transform:uppercase; letter-spacing:.3px; }
    .zx-table td, .zx-table th { vertical-align:middle; }
    .totals-row td { font-weight:600; }
    .btn-zx { background:var(--zx-red); border-color:var(--zx-red); color:#fff; font-weight:600; }
    .btn-zx:hover { background:var(--zx-red2); border-color:var(--zx-red2); color:#fff; }
    .btn-pdf { display:inline-flex; align-items:center; gap:7px; background:#0b0b0c; border-color:#0b0b0c; color:#fff; font-weight:600; }
    .btn-pdf:hover { background:#262626; border-color:#262626; color:#fff; }
    .badge-draft { background:rgba(148,163,184,.2); color:#64748b; font-weight:600; }
    .badge-converted { background:rgba(34,197,94,.15); color:#15803d; font-weight:600; }
    .badge-cancelled { background:rgba(239,68,68,.15); color:#b91c1c; font-weight:600; }
    .badge-expired { background:rgba(245,158,11,.15); color:#b45309; font-weight:600; }
</style>

<div class="zx-page-head">
    <h1>Quotations Report</h1>
</div>

<div class="report-tabs">
    <a asp-action="Index">Overview</a>
    <a asp-action="Sales">Sales</a>
    <a asp-action="JobOrders">Job Orders</a>
    <a asp-action="ServiceInvoices">Service Invoices</a>
    <a asp-action="Quotations" class="active">Quotations</a>
</div>

<form method="get" class="row g-2 align-items-end mb-3">
    <div class="col-auto">
        <label class="form-label">From</label>
        <input type="date" name="from" class="form-control" value="@from?.ToString("yyyy-MM-dd")" />
    </div>
    <div class="col-auto">
        <label class="form-label">To</label>
        <input type="date" name="to" class="form-control" value="@to?.ToString("yyyy-MM-dd")" />
    </div>
    <div class="col-auto">
        <label class="form-label">Status</label>
        <select name="status" class="form-select">
            <option value="">All</option>
            <option value="Draft" selected="@(status == "Draft")">Draft</option>
            <option value="Converted" selected="@(status == "Converted")">Converted</option>
            <option value="Expired" selected="@(status == "Expired")">Expired</option>
        </select>
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-zx">Filter</button>
        <a asp-action="Quotations" class="btn btn-outline-secondary">Clear</a>
        <a asp-action="QuotationsPdf" asp-route-from="@from?.ToString("yyyy-MM-dd")" asp-route-to="@to?.ToString("yyyy-MM-dd")" asp-route-status="@status" class="btn btn-pdf">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8Z"/><path d="M14 2v6h6"/></svg>
            Generate PDF
        </a>
    </div>
</form>

<div class="zx-card">
    <div class="table-responsive">
    <table class="table zx-table mb-0">
        <thead>
            <tr>
                <th>Number</th>
                <th>Date</th>
                <th>Customer</th>
                <th>Status</th>
                <th>Converted To</th>
                <th>Prepared By</th>
                <th>Total</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.QuotationNumber</td>
                    <td>@item.QuotationDate.ToString("MMM d, yyyy")</td>
                    <td>@(item.CustomerName ?? "—")</td>
                    @* The same two states the quotation screens show, read
                       from the job order rather than the stored text. *@
                    <td>
                        <span class="badge @QuotationStatuses.BadgeClass(item.Status, item.ConvertedJobOrderID != null)">
                            @QuotationStatuses.Display(item.Status, item.ConvertedJobOrderID != null)
                        </span>
                    </td>
                    <td>@(item.ConvertedJobOrderNumber ?? "—")</td>
                    <td>@(item.PreparedBy ?? "—")</td>
                    <td>@("₱" + item.TotalAmount.ToString("N2"))</td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="7" class="text-center text-muted py-4">No quotations found for this range.</td>
                </tr>
            }
            <tr class="totals-row">
                <td colspan="6" class="text-end">Total</td>
                <td>@("₱" + total.ToString("N2"))</td>
            </tr>
        </tbody>
    </table>
    </div>
</div>

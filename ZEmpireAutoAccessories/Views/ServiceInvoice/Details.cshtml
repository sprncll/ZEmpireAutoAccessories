@model ZEmpireAutoAccessories.Models.ServiceInvoice

@{
    ViewData["Title"] = "Service Invoice Details";

    // sales.Warranty.ServiceInvoiceDetailID points back at these lines, so each
    // one can show its cover or offer to create it. Only for users holding the
    // Warranty module, since WarrantyController enforces it anyway.
    var warrantyByLine = ViewData["WarrantyByLine"] as Dictionary<int, ZEmpireAutoAccessories.Models.Warranty>
                         ?? new Dictionary<int, ZEmpireAutoAccessories.Models.Warranty>();
    var canUseWarranty = User.HasClaim(AppClaims.ModuleAccess, "Warranty");

    var canEditPrice = AppRoles.CanEditCatalogPrices(User);

    var rollProducts = ViewData["RollProducts"] as HashSet<int> ?? new HashSet<int>();
    var stockByProduct = ViewData["StockByProduct"] as Dictionary<int, decimal> ?? new Dictionary<int, decimal>();

    // Settled means the money is in: Paid, or Refunded after having been.
    var settled = Model.Status == "Paid" || Model.Status == "Refunded";

    // A down payment: something has been handed over, and it is less than
    // the invoice comes to.
    //
    // Strictly less, deliberately. Before down payments were allowed,
    // CK_ServiceInvoice_Math forced AmountPaid to equal the total on every
    // row, paid or not, so an untouched Pending invoice still carries the
    // full figure. Reading that as money taken would put a payment on screen
    // that nobody made; a real deposit is always short of the total.
    var deposit = !settled && Model.AmountPaid > 0m && Model.AmountPaid < Model.TotalAmount
        ? Model.AmountPaid
        : 0m;

    // The 12% inside the total, worked out once for the whole page.
    var vat = Vat.Breakdown(Model.TotalAmount);

    // Everything except cash is charged the exact total, so there is nothing
    // to type and no change to work out.
    var settlesExactly = PaymentModes.SettlesExactly(Model.PaymentMode?.PaymentModeName);
    var payments = ViewData["Payments"] as List<ServiceInvoicePayment>;
    var paymentTakers = ViewData["PaymentTakers"] as Dictionary<string, string> ?? new();
    var payModes = ViewData["PayModes"] as List<PaymentMode>;
}

<style>
    .pay-form { display:flex; align-items:flex-end; gap:22px; flex-wrap:wrap; }
    .pay-due { display:flex; flex-direction:column; gap:2px; }
    .pay-label { font-size:12.5px; font-weight:600; text-transform:uppercase; letter-spacing:.3px; color:#7b8290; }
    .pay-total { font-size:26px; font-weight:700; font-variant-numeric:tabular-nums; color:#0b0b0c; }
    .pay-field { min-width:190px; }
    .pay-change { font-size:22px; font-weight:700; font-variant-numeric:tabular-nums; color:#15803d; padding-top:2px; }
    .pay-change.is-short { color:#b91c1c; }
    .pay-vat { font-size:12px; color:#7b8290; }
    @@media (max-width: 575.98px) { .pay-form { gap:14px; } .pay-field { min-width:0; flex:1 1 100%; } }
    dt { color:#7b8290; font-weight:600; font-size:12.5px; text-transform:uppercase; letter-spacing:.3px; }
    dd { margin-bottom:14px; font-size:15px; color:#0b0b0c; }
    .badge-paid { background:rgba(34,197,94,.15); color:#15803d; font-weight:600; }
    .badge-pending { background:rgba(148,163,184,.2); color:#64748b; font-weight:600; }
    .badge-cancelled { background:rgba(239,68,68,.15); color:#b91c1c; font-weight:600; }
    .badge-refunded { background:rgba(245,158,11,.15); color:#b45309; font-weight:600; }
    .totals-row td { font-weight:600; }
    .status-actions form { display:inline; margin-right:8px; }
    .zx-page-head .btn-outline-secondary { display:inline-flex; align-items:center; gap:7px; }
    .btn-pdf { display:inline-flex; align-items:center; gap:7px; background:#0b0b0c; border-color:#0b0b0c; color:#fff; font-weight:600; }
    .btn-pdf:hover { background:#262626; border-color:#262626; color:#fff; }
    #removeLineModal .modal-content { border-radius:14px; border:none; }
    #removeLineModal .modal-title { font-family:'Oswald',system-ui,sans-serif; font-weight:700; font-size:19px; }
</style>


@* What a payment just did - "Down payment of P30,000.00 recorded.
   P37,000.00 still due." - which was being set and never shown. *@
@if (TempData["Success"] is string done)
{
    <div class="alert alert-success">@done</div>
}
@if (TempData["StatusError"] is string statusError)
{
    <div class="alert alert-danger">
        @statusError
        @if (TempData["StatusErrorFix"] as string == "CutSize")
        {
            @* The message names the screen; this is the door to it. *@
            <div class="mt-2">
                <a class="btn btn-sm btn-outline-danger"
                   asp-controller="CutSize" asp-action="Index" zx-return>
                    Open Cut Sizes
                </a>
            </div>
        }
    </div>
}
<div class="zx-page-head">
    <h1>Invoice @Model.InvoiceNumber</h1>
    <div>
        <a class="btn btn-outline-secondary" asp-action="Edit" asp-route-id="@Model.ServiceInvoiceID">Edit</a>
        <a class="btn btn-pdf" asp-action="Pdf" asp-route-id="@Model.ServiceInvoiceID" target="_blank">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8Z"/><path d="M14 2v6h6"/></svg>
            Generate PDF
        </a>
    </div>
</div>

<div class="zx-card padded">
    <dl class="row mb-3">
        <dt class="col-sm-3">Customer</dt>
        <dd class="col-sm-9">@Model.Customer.FullName</dd>

        <dt class="col-sm-3">Vehicle</dt>
        <dd class="col-sm-9">@(Model.Vehicle != null ? $"{Model.Vehicle.PlateNumber ?? "No Plate"} — {Model.Vehicle.Brand} {Model.Vehicle.Model}" : "—")</dd>

        <dt class="col-sm-3">Job Order</dt>
        <dd class="col-sm-9">@(Model.JobOrder?.JobOrderNumber ?? "—")</dd>

        <dt class="col-sm-3">Payment Mode</dt>
        <dd class="col-sm-9">@(Model.PaymentMode?.PaymentModeName ?? "—")</dd>

        <dt class="col-sm-3">Invoice Date</dt>
        <dd class="col-sm-9">@Model.InvoiceDate.ToString("MMM d, yyyy")</dd>

        <dt class="col-sm-3">Status</dt>
        <dd class="col-sm-9"><span class="badge badge-@Model.Status.ToLower()">@Model.Status</span></dd>

        <dt class="col-sm-3">Sub Total</dt>
        <dd class="col-sm-9">@Money.Peso(Model.SubTotal)</dd>

        <dt class="col-sm-3">Discount</dt>
        <dd class="col-sm-9">@Money.Peso(Model.DiscountAmount)</dd>

        @if (Model.TaxAmount > 0)
        {
            @* Older invoices were written with a figure typed into Tax, which
               CK_ServiceInvoice_Math adds to the total. Shown so the total
               still adds up on screen. *@
            <dt class="col-sm-3">Tax entered separately</dt>
            <dd class="col-sm-9">@Money.Peso(Model.TaxAmount)</dd>
        }

        <dt class="col-sm-3">Total Amount</dt>
        <dd class="col-sm-9"><strong>@Money.Peso(Model.TotalAmount)</strong></dd>

        @* Prices are quoted VAT-inclusive, so the 12% is worked out of the
           total rather than added to it - the same split a BIR sales invoice
           prints. Nothing here is stored; see Models/Vat.cs. *@
        <dt class="col-sm-3">VATable Sales</dt>
        <dd class="col-sm-9">@Money.Peso(vat.VatableSales)</dd>

        <dt class="col-sm-3">VAT (@Vat.RateLabel)</dt>
        <dd class="col-sm-9">
            @Money.Peso(vat.Amount)
            <span class="text-muted">- included in the total above</span>
        </dd>

        @* CK_ServiceInvoice_Math ties ChangeAmount to AmountPaid minus the
           total, and CK_ServiceInvoice_Change keeps that at or above zero, so
           an unpaid invoice still carries AmountPaid equal to its total.
           Showing that figure would claim money had been taken. *@
        <dt class="col-sm-3">Amount Paid</dt>
        <dd class="col-sm-9">
            @if (settled)
            {
                @Money.Peso(Model.AmountPaid)
            }
            else if (deposit > 0m)
            {
                @Money.Peso(deposit)
                <span class="text-muted">- down payment</span>
            }
            else
            {
                <span class="text-muted">Not yet paid</span>
            }
        </dd>

        @* The balance is what is left after a deposit, not the invoice
           total over again: an invoice with 10,000 against 32,000 owes
           22,000, and saying 32,000 here while the payment box below says
           22,000 is the kind of disagreement nobody should have to settle
           with a calculator. *@
        <dt class="col-sm-3">@(settled ? "Change" : "Balance Due")</dt>
        <dd class="col-sm-9">
            @(settled
                ? Money.Peso(Model.ChangeAmount)
                : Money.Peso(Model.TotalAmount - deposit))
        </dd>

        @if (!string.IsNullOrEmpty(Model.Remarks))
        {
            <dt class="col-sm-3">Remarks</dt>
            <dd class="col-sm-9">@Model.Remarks</dd>
        }
    </dl>

    <div class="status-actions">
        @* There is no Take payment button here. Money changes hands in the
           payment box below, which sits on this same page and is the only
           place that can take it - a second button that only scrolled down to
           it read as a second way to pay, and left two things on screen
           called the same thing. *@
        @if (Model.Status != "Pending")
        {
            <form asp-action="SetStatus" method="post">
                <input type="hidden" name="id" value="@Model.ServiceInvoiceID" />
                <input type="hidden" name="status" value="Pending" />
                <button type="submit" class="btn btn-sm btn-outline-secondary">Mark Pending</button>
            </form>
        }
        @if (Model.Status != "Refunded")
        {
            <form asp-action="SetStatus" method="post">
                <input type="hidden" name="id" value="@Model.ServiceInvoiceID" />
                <input type="hidden" name="status" value="Refunded" />
                <button type="submit" class="btn btn-sm btn-outline-secondary">Mark Refunded</button>
            </form>
        }
        @if (Model.Status != "Cancelled")
        {
            <form asp-action="SetStatus" method="post">
                <input type="hidden" name="id" value="@Model.ServiceInvoiceID" />
                <input type="hidden" name="status" value="Cancelled" />
                <button type="submit" class="btn btn-sm btn-outline-secondary">Cancel Invoice</button>
            </form>
        }
    </div>
</div>

@if (payments is { Count: > 0 })
{
    @* Each payment as it was taken - a down payment, the balance, a refund -
       with when, how and by whom. The running Amount Paid above is the sum. *@
    <div class="zx-card padded">
        <h6 class="mb-3">Payments</h6>
        <div class="table-responsive">
            <table class="table zx-table mb-0">
                <thead>
                    <tr>
                        <th>Date &amp; Time</th>
                        <th>What</th>
                        <th>Paid by</th>
                        <th>Taken by</th>
                        <th class="text-end">Tendered</th>
                        <th class="text-end">Change</th>
                        <th class="text-end pe-3">Amount</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in payments)
                    {
                        <tr>
                            <td>@p.PaymentDate.ToString("MMM d, yyyy h:mm tt")</td>
                            <td>@(p.Notes ?? p.Kind)</td>
                            <td>@p.PaymentMode?.PaymentModeName</td>
                            <td>@(paymentTakers.TryGetValue(p.UserId, out var taker) ? taker : "—")</td>
                            <td class="text-end">@(p.AmountTendered is { } t ? Money.Peso(t) : "—")</td>
                            <td class="text-end">@(p.AmountTendered != null ? Money.Peso(p.ChangeAmount) : "—")</td>
                            <td class="text-end pe-3 @(p.Amount < 0 ? "text-danger" : "")">@Money.Peso(p.Amount)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@if (!settled)
{
    <div class="zx-card padded" id="takePayment">
        @{
            var balanceDue = Model.TotalAmount - Model.AmountPaid;
            var hasDeposit = Model.AmountPaid > 0m && balanceDue > 0m;
        }
        @* "Payment" above, "Take payment" on the button: the screen used to
           say Take payment three times - a button in the header that only
           scrolled down here, this heading, and the button that actually
           takes it. One of them does the work. *@
        <h6 class="mb-1">Payment</h6>
        <p class="zx-page-sub mb-3" style="margin-top:0;">
            Enter what the customer handed over. Less than the balance is taken as a
            down payment and the invoice stays Pending; the balance or more settles it.
        </p>
        @if (hasDeposit)
        {
            <div class="alert alert-info py-2 px-3">
                Already paid <strong>@Money.Peso(Model.AmountPaid)</strong> of
                @Money.Peso(Model.TotalAmount).
            </div>
        }
        <form asp-action="RecordPayment" method="post" class="pay-form">
            <input type="hidden" name="id" value="@Model.ServiceInvoiceID" />
            <div class="pay-due">
                <span class="pay-label">@(hasDeposit ? "Balance due" : "Total due")</span>
                <span class="pay-total" id="payTotal"
                      data-total="@balanceDue.ToString(System.Globalization.CultureInfo.InvariantCulture)">
                    @Money.Peso(balanceDue)
                </span>
                <span class="pay-vat">Includes @Money.Peso(vat.Amount) VAT (@Vat.RateLabel)</span>
            </div>
            @if (payModes != null)
            {
                @* What this payment came in on. A deposit by GCash and the
                   balance in cash are two modes on one invoice; it starts on
                   the invoice's own. *@
                <div class="pay-field">
                    <label class="form-label" for="paymentModeId">Paid by</label>
                    <select id="paymentModeId" name="paymentModeId" class="form-select" data-searchable="false">
                        @foreach (var m in payModes)
                        {
                            <option value="@m.PaymentModeID"
                                    data-exact="@(PaymentModes.SettlesExactly(m.PaymentModeName) ? "true" : "false")"
                                    selected="@(m.PaymentModeID == Model.PaymentModeID)">@m.PaymentModeName</option>
                        }
                    </select>
                </div>
            }
            <div class="pay-field">
                <label class="form-label" for="amountTendered">Amount tendered</label>
                @* A mode that settles exactly gives no change back, so it is
                   capped at the balance - but it may still be a deposit, which
                   is why the box is typeable rather than locked. *@
                <input type="number" step="0.01" min="0" id="amountTendered" name="amountTendered"
                       class="form-control"
                       value="@balanceDue.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)"
                       max="@(settlesExactly ? balanceDue.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture) : null)"
                       required />
                @if (settlesExactly)
                {
                    <div class="form-text">
                        @(Model.PaymentMode?.PaymentModeName) gives no change, so this cannot exceed the balance.
                        Less than the balance is a down payment.
                    </div>
                }
            </div>
            <div class="pay-field">
                <span class="form-label d-block">Change</span>
                <div class="pay-change" id="payChange">₱0.00</div>
                @if (settlesExactly)
                {
                    <div class="form-text">@(Model.PaymentMode?.PaymentModeName) never gives change.</div>
                }
            </div>
            <button type="submit" class="btn btn-zx" id="payButton">Take payment</button>
        </form>
    </div>
}

<div class="zx-card padded">
    <h6 class="mb-3">Line Items</h6>
    <div class="table-responsive">
    <table class="table zx-table mb-3">
        <thead>
            <tr>
                <th>Description</th>
                <th>Qty</th>
                <th>Unit</th>
                <th>Unit Price</th>
                <th>Discount</th>
                <th>Sub Total</th>
                @if (canUseWarranty)
                {
                    <th>Warranty</th>
                }
                <th class="text-end pe-3">Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var line in Model.Details)
            {
                <tr>
                    <td>
                        @(line.Product?.ProductName ?? line.Service?.ServiceName ?? "—")
                        @if (line.TintVariant != null || line.Shade != null || line.Panel != null)
                        {
                            <div class="text-muted small">
                                @string.Join(" · ", new[] { line.TintVariant?.VariantName, line.Shade?.ShadeName, line.Panel?.PanelName }.Where(s => !string.IsNullOrEmpty(s)))
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(line.Description))
                        {
                            <div class="text-muted small">@line.Description</div>
                        }
                    </td>
                    <td>@(line.Unit == UnitOfMeasure.PanelUnit ? "—" : line.Quantity.ToString("0.##"))</td>
                    <td>
                        <partial name="_PanelFilm" model="new PanelFilm {
                            SoldByLength = line.ProductID != null && rollProducts.Contains(line.ProductID.Value),
                            PanelID = line.PanelID,
                            VehicleClassificationID = Model.Vehicle?.VehicleClassificationID,
                            Quantity = line.Quantity,
                            StoredUnit = line.Unit }" />
                    </td>
                    <td>@Money.Peso(line.UnitPrice)</td>
                    <td>@Money.Peso(line.DiscountAmount)</td>
                    <td>@Money.Peso(line.SubTotal)</td>
                    @if (canUseWarranty)
                    {
                        <td>
                            @if (warrantyByLine.TryGetValue(line.ServiceInvoiceDetailID, out var cover))
                            {
                                <a class="warranty-chip @("status-" + (cover.WarrantyStatus ?? "none").ToLower())"
                                   asp-controller="Warranty" asp-action="Details" asp-route-id="@cover.WarrantyID" zx-return>
                                    @(cover.WarrantyStatus ?? "Linked")
                                    @if (cover.WarrantyEndDate != null)
                                    {
                                        <span class="until">until @cover.WarrantyEndDate.Value.ToString("MMM d, yyyy")</span>
                                    }
                                </a>
                            }
                            else
                            {
                                <a class="warranty-add"
                                   asp-controller="Warranty" asp-action="Create"
                                   asp-route-serviceInvoiceDetailId="@line.ServiceInvoiceDetailID" zx-return>+ Warranty</a>
                            }
                        </td>
                    }
                    <td class="text-end pe-3">
                        <button type="button" class="icon-btn danger remove-line-btn" title="Remove line item"
                                data-bs-toggle="modal" data-bs-target="#removeLineModal"
                                data-detail-id="@line.ServiceInvoiceDetailID"
                                data-detail-name="@(line.Product?.ProductName ?? line.Service?.ServiceName ?? "this line item")">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"/><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                        </button>
                    </td>
                </tr>
            }
            @if (!Model.Details.Any())
            {
                <tr>
                    <td colspan="@(canUseWarranty ? 8 : 7)" class="text-center text-muted py-3">No line items yet.</td>
                </tr>
            }
            <tr class="totals-row">
                <td colspan="5" class="text-end">Total</td>
                <td colspan="@(canUseWarranty ? 3 : 2)">@Money.Peso(Model.TotalAmount)</td>
            </tr>
        </tbody>
    </table>
    </div>

    <h6 class="mb-3">Add Line Item</h6>

    @if (TempData["LineError"] is string lineError)
    {
        <div class="alert alert-danger py-2 px-3" style="font-size:13.5px;">@lineError</div>
    }
    <form asp-action="AddLine" method="post" class="row g-2 align-items-start">
        <input type="hidden" name="serviceInvoiceId" value="@Model.ServiceInvoiceID" />

        <div class="col-md-3">
            <label class="form-label">Product</label>
            <select id="addLineProduct" name="productId" class="form-select">
                <option value="">-- None --</option>
                @foreach (var p in (List<Product>)ViewData["Products"]!)
                {
                    <option value="@p.ProductID" data-name="@p.ProductName" data-price="@((p.DefaultPrice ?? 0).ToString(System.Globalization.CultureInfo.InvariantCulture))" data-roll="@(rollProducts.Contains(p.ProductID).ToString().ToLowerInvariant())" data-stock="@((stockByProduct.TryGetValue(p.ProductID, out var onHand) ? onHand : 0).ToString(System.Globalization.CultureInfo.InvariantCulture))">@p.ProductName @(stockByProduct.TryGetValue(p.ProductID, out var sh) && sh > 0 ? $"({ZEmpireAutoAccessories.Models.UnitOfMeasure.Describe(sh, rollProducts.Contains(p.ProductID))} in stock)" : "(out of stock)")</option>
                }
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label">Service</label>
            <select id="addLineService" name="serviceId" class="form-select">
                <option value="">-- None --</option>
                @foreach (var s in (List<Service>)ViewData["Services"]!)
                {
                    <option value="@s.ServiceID" data-name="@s.ServiceName" data-price="@s.DefaultPrice.ToString(System.Globalization.CultureInfo.InvariantCulture)">@s.ServiceName</option>
                }
            </select>
        </div>
        <div class="col-md-3 line-opt" id="wrap-addLineTintVariant" style="display:none;">
            <label class="form-label" title="Only applies to products with more than one tint variant (e.g. Play/Freeze/Max)">Tint Variant</label>
            <select id="addLineTintVariant" name="tintVariantId" class="form-select" disabled>
                <option value="">-- N/A --</option>
            </select>
        </div>
        <div class="col-md-3 line-opt" id="wrap-addLineShade" style="display:none;">
            <label class="form-label" title="Which shade of the chosen tint variant was fitted - e.g. Light, Medium, Superdark">Shade</label>
            <select id="addLineShade" name="shadeId" class="form-select" disabled>
                <option value="">-- N/A --</option>
            </select>
        </div>
        <div class="col-md-3 line-opt" id="wrap-addLinePanel" style="display:none;">
            <label class="form-label" title="Which part of the vehicle this line covers - determines the matrix price for this vehicle's classification">Panel</label>
            <select id="addLinePanel" name="panelId" class="form-select" disabled>
                <option value="">-- N/A --</option>
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label">Description</label>
            <input id="addLineDescription" type="text" name="description" class="form-control"
                   placeholder="Filled in when you pick a product or service" />
        </div>
        <div class="col-md-3" id="wrap-addLineQty">
            <label class="form-label" title="How many units of this product or service">Qty</label>
            @* Quantity and unit read as one value, so they sit in one cell
               - and for film the unit is part of the measurement, not a
               separate decision. *@
            <div class="input-group">
                <input type="number" step="0.01" id="addLineQty" name="quantity" class="form-control" value="1" min="0.01" />
                <select name="unit" class="form-select line-unit" data-searchable="false"
                        data-length-units="@string.Join(",", ZEmpireAutoAccessories.Models.UnitOfMeasure.LengthUnits)"
                        data-count-units="@string.Join(",", ZEmpireAutoAccessories.Models.UnitOfMeasure.CountUnits)"
                            data-service-units="@string.Join(",", ZEmpireAutoAccessories.Models.UnitOfMeasure.ServiceUnits)">
                    @foreach (var u in ZEmpireAutoAccessories.Models.UnitOfMeasure.CountUnits)
                    {
                        <option value="@u">@u</option>
                    }
                </select>
            </div>
            <div id="lineStockNote" class="form-text mt-1"></div>
        </div>
        <div class="col-md-3">
            <label class="form-label">Price</label>
            @* Staff bill from the book; administrators set what the book
               says. The controller discards a posted price for staff and uses
               the book's own, so this box is a courtesy and not the rule. *@
            <input id="addLinePrice" type="number" step="0.01" name="unitPrice" class="form-control"
                   value="0" min="0"
                   readonly="@(canEditPrice ? null : "readonly")"
                   tabindex="@(canEditPrice ? null : "-1")" />
            @if (!canEditPrice)
            {
                <div class="form-text">Set from the price list for this vehicle's class.</div>
            }
        </div>
        <div class="col-md-3">
            <label class="form-label">Disc.</label>
            @* A discount is the other way to change what is charged, so it
               goes the same way as the price: billed in full by staff, and an
               administrator decides what comes off it. Zeroed server-side. *@
            <input type="number" step="0.01" name="discountAmount" class="form-control"
                   value="0" min="0"
                   readonly="@(canEditPrice ? null : "readonly")"
                   tabindex="@(canEditPrice ? null : "-1")" />
            @if (!canEditPrice)
            {
                <div class="form-text">An administrator sets any discount.</div>
            }
        </div>
        @* The button keeps the rightmost quarter, in line with Panel and
           Disc. above it, rather than starting a ragged fifth column. *@
        <div class="col-md-3 offset-md-9">
            <span class="form-label d-block invisible" aria-hidden="true">Add</span>
            <button type="submit" class="btn btn-zx w-100">Add</button>
        </div>
    </form>
    <div class="form-text mt-2">
        Pick either a Product or a Service for the line item. Description is required. For products priced by
        panel, pick a Tint Variant (if applicable) and a Panel to pull the exact price for this vehicle's classification.
    </div>
</div>

<div class="modal fade" id="removeLineModal" tabindex="-1" aria-labelledby="removeLineModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form asp-action="RemoveLine" method="post" id="removeLineForm">
                <input type="hidden" name="detailId" id="removeLineDetailId" value="" />
                <input type="hidden" name="serviceInvoiceId" value="@Model.ServiceInvoiceID" />
                <div class="modal-header">
                    <h5 class="modal-title" id="removeLineModalLabel">Remove Line Item</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p class="mb-0">Remove <strong id="removeLineDetailName">this line item</strong> from this invoice? This can't be undone.</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger">Remove</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Change as the amount is typed, against the BALANCE rather than the
        // total, so an invoice with a deposit on it asks for what is left.
        // The server works it out again on save; this is so the cashier sees
        // it before committing.
        (function () {
            var tendered = document.getElementById('amountTendered');
            var changeBox = document.getElementById('payChange');
            var totalBox = document.getElementById('payTotal');
            var button = document.getElementById('payButton');
            if (!tendered || !changeBox || !totalBox) { return; }

            var total = parseFloat(totalBox.dataset.total) || 0;

            function peso(value) {
                return '\u20B1' + value.toLocaleString(undefined,
                    { minimumFractionDigits: 2, maximumFractionDigits: 2 });
            }

            function update() {
                var paid = parseFloat(tendered.value);
                if (isNaN(paid)) { paid = 0; }

                var change = paid - total;

                // Short of the balance is a down payment now, not an error, so
                // the button stays live and the box says what is left owing
                // rather than refusing the figure.
                if (change < 0) {
                    changeBox.textContent = peso(-change) + ' still due';
                    changeBox.className = 'pay-change is-short';
                } else {
                    changeBox.textContent = peso(change);
                    changeBox.className = 'pay-change';
                }

                if (button) { button.disabled = !(paid > 0); }
            }

            tendered.addEventListener('input', update);

            // A mode that gives no change cannot take more than the balance;
            // which mode that is follows the Paid by box.
            var modeBox = document.getElementById('paymentModeId');
            if (modeBox) {
                var syncCap = function () {
                    var opt = modeBox.options[modeBox.selectedIndex];
                    if (opt && opt.getAttribute('data-exact') === 'true') {
                        tendered.max = total.toFixed(2);
                        if (parseFloat(tendered.value) > total) { tendered.value = total.toFixed(2); }
                    } else {
                        tendered.removeAttribute('max');
                    }
                    update();
                };
                modeBox.addEventListener('change', syncCap);
                syncCap();
            }

            update();
        })();
    </script>
    <script src="~/js/line-unit.js" asp-append-version="true"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var modalEl = document.getElementById('removeLineModal');
            if (!modalEl) return;
            modalEl.addEventListener('show.bs.modal', function (event) {
                var btn = event.relatedTarget;
                document.getElementById('removeLineDetailId').value = btn.getAttribute('data-detail-id');
                document.getElementById('removeLineDetailName').textContent = btn.getAttribute('data-detail-name');
            });
        });

        // Fill in the Price field as soon as a product or service is picked
        // on the Add Line Item form (still editable afterward). For products
        // priced by the Pricing matrix (Product x Tint Variant x this
        // vehicle's classification x Panel), the Tint Variant/Panel pickers
        // drive the exact price instead of the product's flat DefaultPrice.
        // Picking a Product or Service clears the other, since a line is
        // either one or the other.
        (function () {
            var pricingMatrix = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewData["PricingMatrix"]));

            // Every panel in the catalogue, one row per panel. The matrix
            // above only holds panels somebody has PRICED for this class of
            // vehicle; this is the list of panels that exist, which is what a
            // film line needs to be able to say what it covers.
            var allPanels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewData["AllPanels"] ?? new List<object>()));
            var $product = $('#addLineProduct');
            var $service = $('#addLineService');
            // Every tint variant each product has, from cat.TintVariant rather
            // than from the price matrix. A variant says what was fitted; it is
            // not a price driver, so a film with no price row for this class of
            // vehicle must still be able to record one.
            var variantsByProduct = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewData["VariantsByProduct"]));

            // The shades each tint variant comes in. Keyed by variant because
            // a shade belongs to one - "Superdark" on BF Stone is a different
            // row from "Superdark" on Profilm X Lite.
            var shadesByVariant = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewData["ShadesByVariant"]));

            var $tintVariant = $('#addLineTintVariant');
            var $shade = $('#addLineShade');
            var $panel = $('#addLinePanel');
            var $price = $('#addLinePrice');
            var $description = $('#addLineDescription');
            if (!$product.length || !$service.length || !$tintVariant.length || !$panel.length || !$price.length) { return; }

            function rowsForProduct(productId) {
                return pricingMatrix.filter(function (r) { return r.productId === productId; });
            }

            function resetSelect($select, placeholder) {
                $select.empty().append($('<option></option>').val('').text(placeholder)).prop('disabled', true);
                showIfUsable($select);
            }

            // A field that cannot be used is not shown at all. Variant, shade
            // and panel only mean anything once a film has been picked, and a
            // row of boxes reading "-- N/A --" asks somebody to work out which
            // of them they are meant to ignore.
            // Is the product on the form a film? Roll goods are the test:
            // tint and PPF are what the shop buys by the metre, and nothing
            // else on the product list is.
            function filmPicked() {
                return !!$product.val() && $product.find(':selected').data('roll') === true;
            }

            function showIfUsable($select) {
                var usable = !$select.prop('disabled') && $select.find('option').length > 1;

                // For a film the three boxes stay on screen whether or not
                // they have anything in them. What a film line contains -
                // panel, tint variant, shade - is the substance of the line,
                // so a box saying nothing is on file is worth more than no box
                // at all: it is the difference between a gap somebody can go
                // and fill and a screen that looks like it works.
                $('#wrap-' + $select.attr('id')).toggle(usable || filmPicked());
            }

            // A panel of film is one panel, and what it takes off the roll
            // is the cut size for that panel on this class of vehicle, worked
            // out when the document is completed. The Qty box has no say in
            // it: a 2 there doubles the price and the film both, which is a
            // second panel, not a longer cut. So the box comes off the screen
            // for those lines. ServiceInvoice, JobOrder and Quotation all
            // force the same thing server-side, so a line posted without
            // JavaScript means it too.
            function applyFixedQuantity() {
                // Two kinds of line have a quantity nobody should be typing.
                //
                // A panel of film is one panel, as above. And labour is one
                // job: the same fitting done twice is a second visit, not a
                // quantity of two on one line, and a 3 in that box multiplies
                // the price of the work by three - which is how a 500-peso
                // fitting reached a job order reading 1,500. A service is
                // already refused if it is added twice; this is the same rule
                // said once more, on the box itself.
                // Tint and film are measured, never counted: what comes off
                // the roll is the panel's cut size, from inventory. So the
                // box is not shown for them at all - a panel is picked
                // instead.
                var fixedQuantity = filmPicked() || !!$service.val();

                $('#wrap-addLineQty').toggle(!fixedQuantity);
                if (fixedQuantity) { $('#addLineQty').val(1); }
            }

            function refreshPanels() {
                refreshPanelsCore();
                applyFixedQuantity();
            }

            function refreshPanelsCore() {
                var productId = parseInt($product.val(), 10);
                var tintVariantId = $tintVariant.prop('disabled') ? null : ($tintVariant.val() || null);
                var rows = productId ? rowsForProduct(productId).filter(function (r) {
                    return String(r.tintVariantId || '') === String(tintVariantId || '');
                }) : [];

                if (rows.length === 0) {
                    // Three different situations used to read as "-- N/A --":
                    // nothing picked yet, a product that is simply not priced
                    // by panel, and a film whose panel prices nobody has
                    // entered for this vehicle's class. Only the last two are
                    // gaps somebody can go and fill, and a blank box that does
                    // not say which is why people ask whether it is broken.
                    var pricedByPanel = productId
                        ? rowsForProduct(productId).length > 0
                        : false;
                    var hasVariants = !$tintVariant.prop('disabled')
                        && $tintVariant.find('option').length > 1;

                    // A film still has to say which panel it covers, so
                    // when the matrix has no row for it the whole panel list
                    // is offered instead. These options carry no price, so the
                    // Price box keeps whatever is in it and is typed over by
                    // hand - an unpriced panel is a price to agree, not a
                    // reason to leave the job sheet silent about the glass.
                    // A film with variants waits for one: the price depends on it.
                    if (filmPicked() && hasVariants && !tintVariantId) {
                        resetSelect($panel, '-- Pick a tint variant first --');
                        // Nothing priced yet, so nothing carried over either:
                        // the last product's price must not ride along.
                        $price.val('0');
                        return;
                    }

                    // A film must say which panel it covers - the cut size
                    // comes from it, and the line is refused without one - so
                    // when nothing is priced for this product, variant and
                    // vehicle class, every panel is offered, unpriced.
                    if (filmPicked() && allPanels.length > 0) {
                        $price.val('0');
                        $panel.empty()
                              .append($('<option></option>').val('').text(pricedByPanel
                                  ? '-- Select Panel (no price for this variant) --'
                                  : '-- Select Panel (no matrix price) --'))
                              .prop('disabled', false);

                        allPanels.forEach(function (p) {
                            $panel.append($('<option></option>').val(p.panelId).text(p.panelName));
                        });

                        showIfUsable($panel);
                        return;
                    }

                    resetSelect($panel,
                        !productId ? '-- N/A --'
                            : pricedByPanel ? '-- No panel prices for this variant --'
                            : hasVariants ? '-- No panel prices for this vehicle class --'
                            : '-- N/A --');
                    return;
                }

                $panel.empty()
                      .append($('<option></option>').val('').text('-- Select Panel --'))
                      .prop('disabled', false);

                rows.forEach(function (r) {
                    $panel.append($('<option></option>').val(r.panelId).text(r.panelName).attr('data-price', r.price));
                });

                // After the options, never before them: showIfUsable counts
                // what is in the box, and a box holding only its placeholder
                // reads as nothing worth showing - so asking first hid the
                // box the panels were about to go into.
                showIfUsable($panel);

                // Only one panel option for this product/variant - skip
                // making the user pick it themselves.
                if (rows.length === 1) {
                    $panel.val(rows[0].panelId);
                    $price.val(parseFloat(rows[0].price).toFixed(2));
                }
            }

            function refreshShades() {
                var tintVariantId = $tintVariant.prop('disabled') ? null : ($tintVariant.val() || null);

                var shades = tintVariantId
                    ? shadesByVariant.filter(function (sh) {
                          return String(sh.tintVariantId) === String(tintVariantId);
                      })
                    : [];

                if (shades.length === 0) {
                    // Two different situations that looked identical: no variant
                    // picked yet, and a variant whose shades nobody has recorded.
                    resetSelect($shade, tintVariantId
                        ? '-- No shades on file for this variant --'
                        : filmPicked() ? '-- Pick a tint variant first --'
                        : '-- N/A --');
                    return;
                }

                $shade.empty()
                      .append($('<option></option>').val('').text('-- Select Shade --'))
                      .prop('disabled', false);

                shades.forEach(function (sh) {
                    $shade.append($('<option></option>').val(sh.shadeId).text(sh.shadeName));
                });

                showIfUsable($shade);

                if (shades.length === 1) {
                    $shade.val(shades[0].shadeId);
                }
            }

            function refreshTintVariants() {
                var productId = parseInt($product.val(), 10);

                var variants = productId
                    ? variantsByProduct.filter(function (v) {
                          return v.productId === productId;
                      })
                    : [];

                if (variants.length === 0) {
                    // This product genuinely has no variants - most do not.
                    // On a film that is a gap in the catalogue rather than a
                    // fact about the product, so it says so.
                    resetSelect($tintVariant, filmPicked()
                        ? '-- No tint variants on file for this film --'
                        : '-- N/A --');
                } else {
                    $tintVariant.empty().append($('<option></option>').val('').text('-- Select Variant --')).prop('disabled', false);
                    variants.forEach(function (v) {
                        $tintVariant.append($('<option></option>').val(v.tintVariantId).text(v.tintVariantName));
                    });

                    showIfUsable($tintVariant);

                    // Only one tint variant on file for this product - skip
                    // making the user pick it themselves.
                    if (variants.length === 1) {
                        $tintVariant.val(variants[0].tintVariantId);
                    }
                }

                refreshPanels();
                refreshShades();
            }

            // Guarded on $(this).val() being truthy: clearing the other field
            // sets its value to '', so its own handler sees a falsy val()
            // and skips straight past its "clear the other one" branch -
            // that's what stops this pair from bouncing back and forth.
            // Description is required by AddLine, so fill it from the item
            // that was picked - leaving it to be typed is what made Add look
            // like it did nothing. A description the user has edited is left
            // alone; clearing the box opts back into auto-fill.
            // The option's LABEL is not the product's name - it carries
            // "(98.98 m in stock)" so the picker is useful, and that was
            // landing in the description and printing on the receipt. The
            // clean name rides along on data-name; fall back to the label only
            // if some option has not got one.
            function nameOf($select) {
                var $selected = $select.find(':selected');
                return ($selected.data('name') || $selected.text() || '').toString().trim();
            }

            function autoFillDescription(text) {
                if (!$description.length) { return; }
                if ($description.data('touched')) { return; }
                $description.val(text || '');
            }

            $description.on('input', function () {
                $description.data('touched', $description.val().trim() !== '');
            });

            $product.on('change', function () {
                var productId = parseInt($(this).val(), 10) || 0;
                if (!productId) {
                    resetSelect($tintVariant, '-- N/A --');
                    resetSelect($shade, '-- N/A --');
                    resetSelect($panel, '-- N/A --');
                    return;
                }

                $service.val('').trigger('change');
                autoFillDescription(nameOf($(this)));

                // The variant and the shade come from the catalogue, so they
                // are offered whether or not this product is priced per panel.
                // Only the panel and the price depend on the matrix, and
                // refreshTintVariants refreshes both of those after itself.
                refreshTintVariants();

                var rows = rowsForProduct(productId);
                if (rows.length === 0) {
                    // No matrix pricing for this product - fall back to its own
                    // flat default price. There is still a variant and a shade
                    // to record, which is the whole point of them.
                    var flatPrice = $(this).find(':selected').data('price');
                    if (flatPrice !== undefined) { $price.val(parseFloat(flatPrice).toFixed(2)); }
                }
            });

            $tintVariant.on('change', function () {
                refreshPanels();
                refreshShades();
            });

            $panel.on('change', function () {
                var price = $(this).find(':selected').data('price');
                if ($(this).val() && price !== undefined) {
                    $price.val(parseFloat(price).toFixed(2));
                }
            });

            // Bound after the handlers above, so it sees the state they
            // leave behind rather than the one they started from.
            $product.add($service).add($panel).on('change', applyFixedQuantity);

            // A line is a product OR a service, never both - so the form asks
            // which first. One switch above the fields, Product | Service, and
            // only the chosen box on screen: nothing greyed out, nothing to
            // unlock. Switching clears what the other side had picked. The
            // server refuses a line carrying both as well.
            var $productCol = $product.closest('[class*="col-"]');
            var $serviceCol = $service.closest('[class*="col-"]');
            var $kind = $(
                '<div class="col-12 line-kind-row">' +
                  '<div class="line-kind" role="group" aria-label="What this line is">' +
                    '<button type="button" data-kind="product">Product</button>' +
                    '<button type="button" data-kind="service">Service</button>' +
                  '</div>' +
                '</div>');
            $productCol.before($kind);

            function setKind(kind, openList) {
                var isProduct = kind === 'product';
                $kind.find('button').each(function () {
                    var on = $(this).data('kind') === kind;
                    $(this).toggleClass('is-on', on).attr('aria-pressed', on ? 'true' : 'false');
                });

                // Clear the side being put away, so nothing of it is posted.
                var $away = isProduct ? $service : $product;
                if ($away.val()) {
                    $away.val('').trigger('change');
                    $price.val('0');
                }

                $productCol.toggle(isProduct);
                $serviceCol.toggle(!isProduct);
                $product.prop('disabled', !isProduct);
                $service.prop('disabled', isProduct);

                if (openList) {
                    // Straight into the list - a moment later, once the
                    // searchable box has seen its select switched back on.
                    var $want = isProduct ? $productCol : $serviceCol;
                    setTimeout(function () {
                        var box = $want.find('.ss-input').get(0);
                        if (box) { box.focus(); box.click(); }
                    }, 30);
                }
            }

            $kind.on('click', 'button', function () {
                setKind($(this).data('kind'), true);
            });

            // A form drawn again after a refused save keeps what it had.
            setKind($service.val() ? 'service' : 'product', false);

            $service.on('change', function () {
                if (!$(this).val()) { return; }

                var price = $(this).find(':selected').data('price');
                if (price !== undefined) { $price.val(parseFloat(price).toFixed(2)); }

                autoFillDescription(nameOf($(this)));
                $product.val('').trigger('change');
                resetSelect($tintVariant, '-- N/A --');
                resetSelect($shade, '-- N/A --');
                resetSelect($panel, '-- N/A --');
            });

            // The form as the page opens: nothing picked, so everything that
            // only means something once a film is picked stays off screen.
            applyFixedQuantity();
        })();
    </script>
}

@{
    ViewData["Title"] = "Dashboard";
    var fullName = User.FindFirst(AppClaims.FullName)?.Value ?? User.Identity?.Name ?? "there";
    var firstName = fullName.Split(' ', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault() ?? fullName;
    var roles = User.FindAll(ClaimTypes.Role).Select(c => c.Value).ToList();
    var modules = User.FindAll(AppClaims.ModuleAccess).Select(c => c.Value).ToList();

    // Surface the Quotation tile for Admin and Staff. Quotation is not yet part
    // of the RBAC module grants (sec.Module / sec.RolePermission), so it is added
    // here explicitly. Once it is granted in the database this block can be
    // removed and the tile will flow through the claims automatically.
    if ((User.IsInRole("Admin") || User.IsInRole("Staff")) &&
        !modules.Contains("Quotation", StringComparer.OrdinalIgnoreCase))
    {
        modules.Add("Quotation");
    }

    // Cashiering has no row in sec.Module either - it only combines Sales and
    // Service Invoices, so holding either one is what opens it, matching the
    // gate on CashieringController. No database change needed to switch it on.
    if ((modules.Contains("Sales", StringComparer.OrdinalIgnoreCase) ||
         modules.Contains("Service Invoices", StringComparer.OrdinalIgnoreCase)) &&
        !modules.Contains("Cashiering", StringComparer.OrdinalIgnoreCase))
    {
        modules.Add("Cashiering");
    }

    // Ordered category map. Modules render under the first category that lists
    // them, in the order defined here; anything not listed falls into "More".
    // Categories with no accessible modules are skipped, so a Staff role only
    // sees the sections it actually has tiles for.
    var categoryMap = new (string Name, string[] Modules)[]
    {
        ("Overview",              new[] { "Reports" }),
        ("Customers & Vehicles",  new[] { "Customers", "Vehicles", "Warranty" }),
        ("Operations",            new[] { "Job Orders", "Vehicle Checklist", "Services", "Job Types" }),
        ("Catalog & Inventory",   new[] { "Products", "Inventory", "Pricing", "Price History" }),
        ("Sales & Billing",       new[] { "Quotation", "Sales", "Service Invoices", "Cashiering" }),
        ("Administration",        new[] { "User Management", "Roles" }),    
    };

    var moduleSet = new HashSet<string>(modules, StringComparer.OrdinalIgnoreCase);
    var claimed = new HashSet<string>(StringComparer.OrdinalIgnoreCase);

    // Build each visible category with its accessible modules in defined order.
    var categories = new List<(string Name, List<string> Modules)>();
    foreach (var (name, mods) in categoryMap)
    {
        var owned = mods.Where(m => moduleSet.Contains(m)).ToList();
        foreach (var m in owned) { claimed.Add(m); }
        if (owned.Count > 0) { categories.Add((name, owned)); }
    }

    // Any module not covered by the map above.
    // var leftovers = modules.Where(m => !claimed.Contains(m)).OrderBy(m => m).ToList();
    // if (leftovers.Count > 0) { categories.Add(("More", leftovers)); }

    var stats = ViewData["Stats"] as List<DashboardStat> ?? new();
}

<style>
    /* ---------------------------------------------------------------
       The old dashboard led with a dark banner saying how many modules
       your role grants - a fact you cannot act on, in the best spot on
       the page - and put the figures you can act on underneath in grey.
       This leads with the day's state and the three things people open
       fifty times a shift, and lets the module grid be what it is: a
       directory you go to when you want something specific.
       --------------------------------------------------------------- */

    .dash-top {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 18px;
        flex-wrap: wrap;
        margin-bottom: 20px;
    }

    .dash-greet h1 {
        font-family: 'Oswald', system-ui, sans-serif;
        font-weight: 700;
        font-size: 26px;
        letter-spacing: .3px;
        margin: 0 0 4px;
        color: #0b0b0c;
    }

    .dash-greet p { margin: 0; color: #7b8290; font-size: 13.5px; }

    .role-chip {
        display: inline-block;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: .4px;
        text-transform: uppercase;
        padding: 2px 9px;
        border-radius: 999px;
        background: #f1f3f7;
        color: #5d6472;
        margin-right: 6px;
    }

    /* ---- the things people actually come here to start ---- */
    .quick-row { display: flex; gap: 10px; flex-wrap: wrap; }

    .quick-btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 10px 16px;
        border-radius: 11px;
        font-size: 13.5px;
        font-weight: 600;
        text-decoration: none;
        border: 1px solid #e3e6ec;
        background: #fff;
        color: #0b0b0c;
        transition: all .15s ease;
        white-space: nowrap;
    }

    .quick-btn:hover { border-color: #0b0b0c; color: #0b0b0c; transform: translateY(-1px); }

    .quick-btn.primary { background: var(--zx-red); border-color: var(--zx-red); color: #fff; }
    .quick-btn.primary:hover { background: var(--zx-red2); border-color: var(--zx-red2); color: #fff; }

    /* ---- figures, with a tone so a problem looks like one ---- */
    .stat-row { margin-bottom: 26px; }

    .stat-card {
        display: block;
        position: relative;
        background: #fff;
        border: 1px solid #e8ebf0;
        border-radius: 14px;
        padding: 16px 18px;
        text-decoration: none;
        height: 100%;
        transition: all .15s ease;
        overflow: hidden;
    }

    .stat-card:hover { border-color: #cfd5de; transform: translateY(-2px); box-shadow: 0 10px 22px -16px rgba(11,11,12,.45); }

    /* A coloured edge rather than a coloured card: it reads at a glance
       across the row without three different backgrounds fighting. */
    .stat-card::before {
        content: '';
        position: absolute;
        left: 0; top: 0; bottom: 0;
        width: 3px;
        background: #e3e6ec;
    }

    .stat-card.tone-waiting::before { background: #d97706; }
    .stat-card.tone-attention::before { background: var(--zx-red); }

    .stat-head { display: flex; align-items: center; gap: 8px; margin-bottom: 10px; }

    .stat-ic { color: #98a0ad; display: inline-flex; }
    .stat-card.tone-waiting .stat-ic { color: #d97706; }
    .stat-card.tone-attention .stat-ic { color: var(--zx-red); }

    .stat-label { font-size: 12px; font-weight: 700; color: #7b8290; letter-spacing: .2px; }

    .stat-value {
        font-family: 'Oswald', system-ui, sans-serif;
        font-weight: 700;
        font-size: 28px;
        line-height: 1.05;
        color: #0b0b0c;
        font-variant-numeric: tabular-nums;
    }

    .stat-card.tone-attention .stat-value { color: var(--zx-red); }

    .stat-note { font-size: 11.5px; color: #98a0ad; margin-top: 3px; }

    /* ---- the module directory, tightened up ---- */
    .mod-bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 14px;
        flex-wrap: wrap;
        margin-bottom: 16px;
        padding-top: 4px;
        border-top: 1px solid #eef0f4;
    }

    .mod-bar h2 {
        font-family: 'Oswald', system-ui, sans-serif;
        font-weight: 700;
        font-size: 15px;
        text-transform: uppercase;
        letter-spacing: .6px;
        color: #0b0b0c;
        margin: 14px 0 0;
    }

    .mod-search-wrap { position: relative; width: 300px; max-width: 100%; margin-top: 12px; }

    .mod-search-wrap svg { position: absolute; left: 12px; top: 50%; transform: translateY(-50%); color: #98a0ad; }

    .mod-search-input { padding-left: 36px; border-radius: 10px; font-size: 13.5px; }

    .mod-no-results { color: #7b8290; font-size: 13.5px; padding: 6px 2px 18px; }

    .cat-block { margin-bottom: 22px; }

    .cat-head { display: flex; align-items: baseline; gap: 9px; margin-bottom: 10px; }

    .cat-head h3 {
        font-size: 12px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .5px;
        color: #98a0ad;
        margin: 0;
    }

    .cat-rule { flex: 1; height: 1px; background: #eef0f4; }

    /* Denser than before: sixteen modules at the old tile size was a wall
       of identical cards you had to scroll past to reach anything. */
    .mod-card {
        display: flex;
        align-items: center;
        gap: 11px;
        background: #fff;
        border: 1px solid #e8ebf0;
        border-radius: 12px;
        padding: 12px 14px;
        text-decoration: none;
        height: 100%;
        transition: all .15s ease;
    }

    a.mod-card:hover { border-color: #0b0b0c; transform: translateY(-2px); box-shadow: 0 10px 20px -16px rgba(11,11,12,.5); }

    .mod-ic {
        flex: 0 0 auto;
        width: 34px;
        height: 34px;
        border-radius: 9px;
        display: grid;
        place-items: center;
        background: #f4f6f9;
        color: #4b5563;
    }

    a.mod-card:hover .mod-ic { background: var(--zx-red); color: #fff; }

    .mod-card h6 { margin: 0; font-size: 13.5px; font-weight: 600; color: #0b0b0c; line-height: 1.25; }

    .mod-card.is-soon { opacity: .55; }
    .mod-card .soon { display: block; font-size: 11px; color: #98a0ad; margin-top: 1px; }

    @@media (max-width: 575.98px) {
        .dash-top { align-items: flex-start; }
        .quick-row { width: 100%; }
        .quick-btn { flex: 1 1 auto; justify-content: center; }
        .stat-value { font-size: 24px; }
    }
</style>

@{
    // The handful of things somebody opens this screen to start. Gated on the
    // same module claims as the tiles, so nobody is offered a button that
    // answers with a 403.
    var canSell = moduleSet.Contains("Sales");
    var canJob = moduleSet.Contains("Job Orders");
    var canQuote = moduleSet.Contains("Quotation");
    var canCash = moduleSet.Contains("Cashiering");
}

<div class="dash-top">
    <div class="dash-greet">
        <h1>Hello, @firstName</h1>
        <p>
            @foreach (var r in roles)
            {
                <span class="role-chip">@r</span>
            }
            @DateTime.Now.ToString("dddd, d MMMM yyyy")
        </p>
    </div>

    <div class="quick-row">
        @if (canSell)
        {
            <a class="quick-btn primary" asp-controller="Sales" asp-action="Create">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14" /><path d="M12 5v14" /></svg>
                New Sale
            </a>
        }
        @if (canJob)
        {
            <a class="quick-btn" asp-controller="JobOrder" asp-action="Create">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><rect width="8" height="4" x="8" y="2" rx="1" /><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2" /></svg>
                New Job Order
            </a>
        }
        @if (canQuote)
        {
            <a class="quick-btn" asp-controller="Quotation" asp-action="Create">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z" /><path d="M14 2v4a2 2 0 0 0 2 2h4" /></svg>
                New Quotation
            </a>
        }
        @if (canCash)
        {
            <a class="quick-btn" asp-controller="Cashiering" asp-action="Index">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="12" x="2" y="6" rx="2" /><circle cx="12" cy="12" r="2" /></svg>
                Cashiering
            </a>
        }
    </div>
</div>

@if (stats.Count > 0)
{
    <div class="row g-3 stat-row">
        @foreach (var stat in stats)
        {
            var tone = stat.Tone switch
            {
                StatTone.Attention => "tone-attention",
                StatTone.Waiting => "tone-waiting",
                _ => null
            };
            <div class="col-6 col-lg-3">
                <a href="@stat.Link" class="stat-card @tone">
                    <div class="stat-head">
                        <span class="stat-ic">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">@Html.Raw(StatIcon(stat.Icon))</svg>
                        </span>
                        <span class="stat-label">@stat.Label</span>
                    </div>
                    <div class="stat-value">@stat.Value</div>
                    @if (!string.IsNullOrEmpty(stat.Note))
                    {
                        <div class="stat-note">@stat.Note</div>
                    }
                </a>
            </div>
        }
    </div>
}

<div class="mod-bar">
    <h2>Modules</h2>
    <div class="mod-search-wrap">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8" /><path d="m21 21-4.3-4.3" /></svg>
        <input type="text" id="modSearch" class="form-control mod-search-input" placeholder="Search modules  /" autocomplete="off" />
    </div>
</div>
<div id="modNoResults" class="mod-no-results" hidden>No modules match your search.</div>

@foreach (var (name, mods) in categories)
{
    <div class="cat-block">
        <div class="cat-head">
            <h3>@name</h3>
            <span class="cat-rule"></span>
        </div>
        <div class="row g-2">
            @foreach (var module in mods)
            {
                // Live modules link straight to their screen; the rest are still placeholders.
                string? route = module switch
                {
                    "Products" => Url.Action("Index", "Product"),
                    "Vehicles" => Url.Action("Index", "Vehicle"),
                    "Customers" => Url.Action("Index", "Customer"),
                    "User Management" => Url.Action("Index", "Employee"),
                    "Roles" => Url.Action("Index", "Security"),
                    "Quotation" => Url.Action("Index", "Quotation"),
                    "Job Types" => Url.Action("Index", "JobType"),
                    "Job Orders" => Url.Action("Index", "JobOrder"),
                    "Pricing" => Url.Action("Index", "Pricing"),
                    "Price History" => Url.Action("Index", "PriceHistory"),
                    "Inventory" => Url.Action("Index", "Inventory"),
                    "Sales" => Url.Action("Index", "Sales"),
                    "Vehicle Checklist" => Url.Action("Index", "VehicleChecklist"),
                    "Service Invoices" => Url.Action("Index", "ServiceInvoice"),
                    "Cashiering" => Url.Action("Index", "Cashiering"),
                    "Warranty" => Url.Action("Index", "Warranty"),
                    "Reports" => Url.Action("Index", "Report"),
                    "Services" => Url.Action("Index", "Service"),

                    _ => null
                };
                <div class="col-6 col-md-4 col-xl-3" data-mod-name="@module">
                    @if (route != null)
                    {
                        <a href="@route" class="mod-card">
                            <span class="mod-ic">
                                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">@Html.Raw(ModuleIcon(module))</svg>
                            </span>
                            <h6>@module</h6>
                        </a>
                    }
                    else
                    {
                        <div class="mod-card is-soon">
                            <span class="mod-ic">
                                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">@Html.Raw(ModuleIcon(module))</svg>
                            </span>
                            <div>
                                <h6>@module</h6>
                                <span class="soon">Coming soon</span>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
}

@section Scripts {
    <script>
        (function () {
            var input = document.getElementById('modSearch');
            var noResults = document.getElementById('modNoResults');
            if (!input) { return; }

            function applyFilter() {
                var term = input.value.trim().toLowerCase();
                var anyVisible = false;

                document.querySelectorAll('.cat-block').forEach(function (block) {
                    var blockHasMatch = false;
                    block.querySelectorAll('[data-mod-name]').forEach(function (card) {
                        var name = card.getAttribute('data-mod-name').toLowerCase();
                        var match = term === '' || name.indexOf(term) !== -1;
                        card.hidden = !match;
                        if (match) { blockHasMatch = true; anyVisible = true; }
                    });
                    block.hidden = !blockHasMatch;
                });

                noResults.hidden = anyVisible || term === '';
            }

            input.addEventListener('input', applyFilter);

            // Press "/" anywhere on the page to jump into the module search.
            document.addEventListener('keydown', function (e) {
                if (e.key !== '/' || e.target === input) { return; }
                var tag = (e.target.tagName || '').toUpperCase();
                if (tag === 'INPUT' || tag === 'TEXTAREA' || tag === 'SELECT') { return; }
                e.preventDefault();
                input.focus();
            });
        })();
    </script>
}


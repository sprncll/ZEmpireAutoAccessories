@model ZEmpireAutoAccessories.Models.Sale

@{
    ViewData["Title"] = "Sale Details";

    // Set by Create - the receipt opens by itself the first time this page is
    // reached after completing a sale, and never again on a revisit.
    var justCompleted = TempData["SaleCompleted"] is string;

    // Set by Create when payment was taken at the counter. sales.Sales has no
    // column for either figure, so they are shown on this one visit and not
    // again - which is honest: they were never recorded.
    // Already formatted by Create - TempData cannot carry a decimal.
    var tendered = TempData["SaleTendered"] as string;
    var change = TempData["SaleChange"] as string;

    // sales.Warranty.SalesDetailID points back at these lines, so each one can
    // show its cover or offer to create it. Only shown to users who hold the
    // Warranty module, since WarrantyController enforces it anyway.
    var warrantyByLine = ViewData["WarrantyByLine"] as Dictionary<int, ZEmpireAutoAccessories.Models.Warranty>
                         ?? new Dictionary<int, ZEmpireAutoAccessories.Models.Warranty>();
    var canUseWarranty = User.HasClaim(AppClaims.ModuleAccess, "Warranty");

    // sales.Sales has no tax column, and dbo.vw_SalesSummary reconciles
    // TotalAmount against the sum of its lines, so the 12% is shown rather
    // than stored - it is inside the price either way. See Models/Vat.cs.
    var vat = Vat.Breakdown(Model.TotalAmount);
}

<style>
    .zx-page-head { display:flex; align-items:center; justify-content:space-between; margin-bottom:18px; }
    .zx-page-head h1 { font-family:'Oswald',system-ui,sans-serif; font-weight:700; font-size:22px; margin:0; color:#0b0b0c; }
    .zx-card { background:#fff; border:1px solid #e8ebf0; border-radius:14px; padding:22px; margin-bottom:18px; }
    dt { color:#7b8290; font-weight:600; font-size:12.5px; text-transform:uppercase; letter-spacing:.3px; }
    dd { margin-bottom:14px; font-size:15px; color:#0b0b0c; }
    .zx-table thead { background:#0b0b0c; color:#fff; }
    .zx-table thead th { border-bottom:none; font-weight:600; font-size:13px; text-transform:uppercase; letter-spacing:.3px; }
    .totals-row td { font-weight:700; }
    .zx-page-head .btn-outline-secondary { display:inline-flex; align-items:center; gap:7px; }
    .btn-pdf { display:inline-flex; align-items:center; gap:7px; background:#0b0b0c; border-color:#0b0b0c; color:#fff; font-weight:600; }
    .btn-pdf:hover { background:#262626; border-color:#262626; color:#fff; }
</style>

<div class="zx-page-head">
    <h1>Sale @Model.InvoiceNumber</h1>
    <div>
        @* The receipt already opened when the sale was completed, so from
           here on this is a reprint - printer icon, not a document one. *@
        <a id="reprintLink" class="btn btn-pdf" asp-action="Pdf" asp-route-id="@Model.SalesID" target="_blank">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><path d="M6 9V4a1 1 0 0 1 1-1h10a1 1 0 0 1 1 1v5"/><rect width="12" height="8" x="6" y="14" rx="1"/></svg>
            Reprint Sales Invoice
        </a>
        <a class="btn btn-outline-secondary" asp-action="Index">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m12 19-7-7 7-7"/><path d="M19 12H5"/></svg>
            Back to list
        </a>
    </div>
</div>

<div class="zx-card">
    <dl class="row mb-0">
        <dt class="col-sm-3">Customer</dt>
        <dd class="col-sm-9">@Model.Customer.FullName</dd>

        <dt class="col-sm-3">Vehicle</dt>
        <dd class="col-sm-9">@(Model.Vehicle != null ? $"{Model.Vehicle.PlateNumber} - {Model.Vehicle.Brand} {Model.Vehicle.Model}" : "—")</dd>

        <dt class="col-sm-3">Payment Mode</dt>
        <dd class="col-sm-9">@Model.PaymentMode.PaymentModeName</dd>

        <dt class="col-sm-3">Date</dt>
        <dd class="col-sm-9">@Model.SalesDate.ToString("MMM d, yyyy h:mm tt")</dd>

        <dt class="col-sm-3">Processed By</dt>
        <dd class="col-sm-9">@Model.User.UserName</dd>
    </dl>
</div>

<div class="zx-card">
    <h6 class="mb-3">Line Items</h6>
    <div class="table-responsive">
    <table class="table zx-table mb-0">
        <thead>
            <tr>
                <th>Product</th>
                <th>Quantity</th>
                <th>Unit Price</th>
                <th>Sub Total</th>
                @if (canUseWarranty)
                {
                    <th>Warranty</th>
                }
            </tr>
        </thead>
        <tbody>
            @foreach (var line in Model.SaleDetails)
            {
                <tr>
                    <td>@line.Product.ProductName</td>
                    <td>@line.Quantity</td>
                    <td>@("₱" + line.UnitPrice.ToString("N2"))</td>
                    <td>@("₱" + line.SubTotal.ToString("N2"))</td>
                    @if (canUseWarranty)
                    {
                        <td>
                            @if (warrantyByLine.TryGetValue(line.SalesDetailID, out var cover))
                            {
                                <a class="warranty-chip @("status-" + (cover.WarrantyStatus ?? "none").ToLower())"
                                   asp-controller="Warranty" asp-action="Details" asp-route-id="@cover.WarrantyID">
                                    @(cover.WarrantyStatus ?? "Linked")
                                    @if (cover.WarrantyEndDate != null)
                                    {
                                        <span class="until">until @cover.WarrantyEndDate.Value.ToString("MMM d, yyyy")</span>
                                    }
                                </a>
                            }
                            else
                            {
                                <a class="warranty-add"
                                   asp-controller="Warranty" asp-action="Create"
                                   asp-route-salesDetailId="@line.SalesDetailID">+ Warranty</a>
                            }
                        </td>
                    }
                </tr>
            }
            <tr class="totals-row">
                <td colspan="3" class="text-end">Total</td>
                <td><strong>@("₱" + Model.TotalAmount.ToString("N2"))</strong></td>
                @if (canUseWarranty)
                {
                    <td></td>
                }
            </tr>
            <tr class="totals-row">
                <td colspan="3" class="text-end text-muted">VATable Sales</td>
                <td class="text-muted">@("₱" + vat.VatableSales.ToString("N2"))</td>
                @if (canUseWarranty)
                {
                    <td></td>
                }
            </tr>
            <tr class="totals-row">
                <td colspan="3" class="text-end text-muted">VAT (@Vat.RateLabel), included</td>
                <td class="text-muted">@("₱" + vat.Amount.ToString("N2"))</td>
                @if (canUseWarranty)
                {
                    <td></td>
                }
            </tr>
        </tbody>
    </table>
    </div>
</div>

@if (justCompleted)
{
    <div class="alert alert-success mt-3">
        <strong>Sale recorded.</strong>
        The receipt should have opened in a new tab &mdash;
        <a href="@Url.Action("Pdf", new { id = Model.SalesID })" target="_blank">open it here</a> if your browser blocked it.
        @if (tendered != null && change != null)
        {
            <div class="mt-2">
                Tendered <strong>@("₱" + tendered)</strong>
                &middot; change to give back <strong>@("₱" + change)</strong>.
                <span class="text-muted">Shown once - the sale record keeps the total only.</span>
            </div>
        }
    </div>
}

@* A section cannot live inside an @@if, so the condition goes inside it. *@
@section Scripts {
    @if (justCompleted)
    {
        <script>
            // Browsers block window.open outside a click, so the banner above
            // always carries a link - this only saves the extra click when the
            // popup is allowed.
            (function () {
                try { window.open('@Url.Action("Pdf", new { id = Model.SalesID })', '_blank'); }
                catch (e) { /* the banner link covers it */ }
            })();
        </script>
    }
}

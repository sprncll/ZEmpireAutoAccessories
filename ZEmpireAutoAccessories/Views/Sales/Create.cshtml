@using ZEmpireAutoAccessories.Models
@{
    ViewData["Title"] = "New Sale";
    var products = ViewData["Products"] as List<Product> ?? new();

    // Stock on hand per product, rendered onto each option so a line can
    // warn as it is typed. CreateSale re-checks it inside its transaction -
    // this is only to save the trip.
    var stockByProduct = ViewData["StockByProduct"] as Dictionary<int, decimal> ?? new();

    // Film and PPF lines are written in metres; data-stock is published in
    // metres to match, so the per-row stock warning compares like with like.
    // Staff sell at the price in the book; administrators set what the book
    // says. The controller refuses a line at any other price, so this box
    // being read-only is a courtesy and not the rule.
    var canEditPrice = AppRoles.CanEditCatalogPrices(User);

    var rollProducts = ViewData["RollProducts"] as HashSet<int> ?? new HashSet<int>();

    // Modes charged the exact total, for the script below - it fills the
    // tendered amount in and locks it for those.
    var exactModeIds = ViewData["ExactPaymentModeIds"] as List<int> ?? new List<int>();
}

<style>
    #grandTotal { font-weight:700; font-size:18px; }

    /* A box nobody can use is not a box. A step board has no tint variant
       and no panel, and a row of greyed "-- N/A --" controls asks somebody
       to work out which of them they are meant to ignore - the same rule
       the job order's line form keeps, in the shape a table allows. */
    td.line-na > .ss-wrap, td.line-na > select { display:none; }
    td.line-na::after { content:"\2014"; color:#9aa2ad; }

    /* The same product written on two rows. Said while it can still be
       changed, rather than discovered on the receipt. */
    #duplicateLines { font-size:12.5px; color:#8a6d1f; background:#fdf6e3;
                      border:1px solid #f0e3bd; border-radius:6px;
                      padding:7px 11px; margin-bottom:12px; display:none; }

    /* Same payment card as the service invoice, so the counter reads the
       same whichever document is being settled. */
    .pay-card { border-top:1px solid #e8ebf0; margin-top:6px; padding-top:18px; }
    .pay-form { display:flex; align-items:flex-end; gap:22px; flex-wrap:wrap; }
    .pay-due { display:flex; flex-direction:column; gap:2px; }
    .pay-label { font-size:12.5px; font-weight:600; text-transform:uppercase; letter-spacing:.3px; color:#7b8290; }
    .pay-total { font-size:26px; font-weight:700; font-variant-numeric:tabular-nums; color:#0b0b0c; }
    .pay-vat { font-size:12px; color:#7b8290; }
    .pay-field { min-width:190px; }
    .pay-change { font-size:22px; font-weight:700; font-variant-numeric:tabular-nums; color:#15803d; padding-top:2px; }
    .pay-change.is-short { color:#b91c1c; }
    .pay-note { font-size:12.5px; color:#7b8290; margin-top:8px; }
    @@media (max-width: 575.98px) { .pay-form { gap:14px; } .pay-field { min-width:0; flex:1 1 100%; } }
    .stock-warning { color:#b91c1c; font-size:11.5px; font-weight:600; margin-top:3px; }
</style>

<div class="zx-page-head">
    <h1>New Sale</h1>
</div>
<p class="zx-page-sub">Add line items, then complete the sale to deduct stock.</p>

<div class="zx-card padded narrow">
    <form asp-action="Create" method="post" id="saleForm" class="zx-form">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <div class="d-flex justify-content-between align-items-baseline">
                    <label class="form-label mb-1">Customer</label>
                    @* Added here rather than in the Customers module: a walk-in
                       is at the counter now, and leaving this page would lose
                       whatever has already been typed into the sale. *@
                    <button type="button" id="newCustomerToggle"
                            class="btn btn-link btn-sm p-0 text-decoration-none">+ New customer</button>
                </div>
                <select id="customerId" name="customerId" class="form-select" asp-items="ViewBag.CustomerID" required>
                    <option value="">-- Select Customer --</option>
                </select>

                <div id="newCustomerPanel" class="border rounded p-2 mt-2" style="display:none;background:#fbfcfd;">
                    <div class="row g-2 mb-2">
                        @* Last name first, the same way the Customers module
                           asks for it, so the two screens do not disagree
                           about what goes where. *@
                        <div class="col-6">
                            <label for="newCustomerLast" class="form-label mb-1" style="font-size:13px;">Last name</label>
                            <input type="text" id="newCustomerLast" class="form-control form-control-sm"
                                   maxlength="80" placeholder="Dela Cruz" autocomplete="family-name" />
                        </div>
                        <div class="col-6">
                            <label for="newCustomerFirst" class="form-label mb-1" style="font-size:13px;">First name</label>
                            <input type="text" id="newCustomerFirst" class="form-control form-control-sm"
                                   maxlength="60" placeholder="Juan" autocomplete="given-name" />
                        </div>
                    </div>
                    <div class="mb-2">
                        <label for="newCustomerNumber" class="form-label mb-1" style="font-size:13px;">Contact number</label>
                        <div class="input-group input-group-sm">
                            <span class="input-group-text">+63</span>
                            <input type="text" id="newCustomerNumber" class="form-control"
                                   inputmode="numeric" maxlength="10" placeholder="9121231231" />
                        </div>
                    </div>
                    <div id="newCustomerError" class="text-danger mb-2" style="font-size:12.5px;display:none;"></div>
                    <div class="d-flex gap-2">
                        <button type="button" id="newCustomerSave" class="btn btn-sm btn-zx">Add customer</button>
                        <button type="button" id="newCustomerCancel" class="btn btn-sm btn-outline-secondary">Cancel</button>
                    </div>
                    <div class="text-muted mt-2" style="font-size:12px;">
                        A vehicle can be added later from the Customers module.
                    </div>
                </div>
            </div>
            <div class="col-md-6 mb-3">
                <label class="form-label">Vehicle</label>
                <select id="vehicleId" name="vehicleId" class="form-select" disabled>
                    <option value="">-- Select Customer First --</option>
                </select>
            </div>
        </div>

        <div class="mb-3 col-md-4">
            <label class="form-label">Payment Mode</label>
            <select id="paymentModeId" name="paymentModeId" class="form-select" asp-items="ViewBag.PaymentModeID" required>
                <option value="">-- Select Payment Mode --</option>
            </select>
        </div>

        <h6 class="mt-4 mb-2">Line Items</h6>
        <p class="zx-page-sub mb-2">Products priced by panel need a Vehicle picked above to look up the matching price.</p>
        <div id="priceBlocked" class="alert alert-danger py-2 px-3" style="display:none; font-size:13px;">
            A line has no price yet. For a product priced by panel, pick the Tint Variant and Panel so the
            price can be looked up - if there is no price for that combination, an administrator sets one
            under Pricing.
        </div>
        <div id="stockBlocked" class="alert alert-danger py-2 px-3" style="display:none; font-size:13px;">
            One or more lines ask for more than there is in stock. Fix the highlighted quantities to continue.
        </div>
        <div id="pricingLoadError" class="alert alert-warning py-2 px-3" style="display:none; font-size:13px;">
            Couldn't load panel pricing for this vehicle - panel-priced products will need a manual Unit Price for now.
        </div>
        <div class="table-responsive">
        <table class="table zx-table" id="linesTable">
            <thead>
                <tr>
                    @* Percentages for the three that hold names, so they
                       share the extra width instead of the table leaving a
                       gap; fixed widths only for the numeric columns. *@
                    <th style="width:34%;">Product</th>
                    <th style="width:22%;">Tint Variant</th>
                    <th style="width:22%;">Panel</th>
                    <th style="width:90px;">Qty</th>
                    <th style="width:140px;">Unit Price</th>
                    <th style="width:52px;"></th>
                </tr>
            </thead>
            <tbody>
                <tr class="line-row">
                    <td>
                        <select name="productId" class="form-select product-select" required>
                            <option value="">-- Select Product --</option>
                            @foreach (var p in products)
                            {
                                <option value="@p.ProductID" data-price="@p.DefaultPrice" data-roll="@(rollProducts.Contains(p.ProductID).ToString().ToLowerInvariant())" data-stock="@(stockByProduct.TryGetValue(p.ProductID, out var st) ? (rollProducts.Contains(p.ProductID) ? st / 100m : st) : 0)">@p.ProductName@(stockByProduct.TryGetValue(p.ProductID, out var sa) && sa > 0 ? $" ({ZEmpireAutoAccessories.Models.UnitOfMeasure.Describe(sa, rollProducts.Contains(p.ProductID))} in stock)" : " (out of stock)")</option>
                            }
                        </select>
                    </td>
                    <td class="line-na">
                        <select class="form-select tint-variant-select" disabled>
                            <option value="">-- N/A --</option>
                        </select>
                    </td>
                    <td class="line-na">
                        <select class="form-select panel-select" disabled>
                            <option value="">-- N/A --</option>
                        </select>
                    </td>
                    <td><input type="number" name="quantity" class="form-control" value="1" min="1" required /></td>
                    <td><input type="number" step="0.01" name="unitPrice" class="form-control unit-price" min="0" required
                               readonly="@(canEditPrice ? null : "readonly")"
                               tabindex="@(canEditPrice ? null : "-1")" /></td>
                    <td><button type="button" class="btn btn-sm btn-outline-danger remove-row">&times;</button></td>
                </tr>
            </tbody>
        </table>
        </div>
        <div id="duplicateLines"></div>
        <button type="button" class="btn btn-outline-secondary btn-sm mb-3" id="addRow">+ Add Item</button>
        @if (!canEditPrice)
        {
            <div class="form-text mb-3">Prices come from the price list. An administrator sets what it says.</div>
        }

        <template id="lineRowTemplate">
            <tr class="line-row">
                <td>
                    <select name="productId" class="form-select product-select" required>
                        <option value="">-- Select Product --</option>
                        @foreach (var p in products)
                        {
                            <option value="@p.ProductID" data-price="@p.DefaultPrice" data-roll="@(rollProducts.Contains(p.ProductID).ToString().ToLowerInvariant())" data-stock="@(stockByProduct.TryGetValue(p.ProductID, out var st) ? (rollProducts.Contains(p.ProductID) ? st / 100m : st) : 0)">@p.ProductName@(stockByProduct.TryGetValue(p.ProductID, out var sa) && sa > 0 ? $" ({ZEmpireAutoAccessories.Models.UnitOfMeasure.Describe(sa, rollProducts.Contains(p.ProductID))} in stock)" : " (out of stock)")</option>
                        }
                    </select>
                </td>
                <td class="line-na">
                    <select class="form-select tint-variant-select" disabled>
                        <option value="">-- N/A --</option>
                    </select>
                </td>
                <td class="line-na">
                    <select class="form-select panel-select" disabled>
                        <option value="">-- N/A --</option>
                    </select>
                </td>
                <td><input type="number" name="quantity" class="form-control" value="1" min="1" required /></td>
                <td><input type="number" step="0.01" name="unitPrice" class="form-control unit-price" min="0" required
                           readonly="@(canEditPrice ? null : "readonly")"
                           tabindex="@(canEditPrice ? null : "-1")" /></td>
                <td><button type="button" class="btn btn-sm btn-outline-danger remove-row">&times;</button></td>
            </tr>
        </template>

        <div class="text-end mb-3">
            Total: <span id="grandTotal">₱0.00</span>
        </div>

        @* Nothing about the tender is stored - sales.Sales holds the total and
           nothing else - so this is the counter's working-out: what is due,
           what was handed over, and the change to give back. The figures reach
           the receipt page for this one visit; the sale itself records the
           line items and the total, as it always has. *@
        <div class="pay-card">
            <h6 class="mb-1">Take payment</h6>
            <p class="zx-page-sub mb-3" style="margin-top:0;">
                Enter what the customer handed over. The change is worked out for you.
            </p>
            <div class="pay-form">
                <div class="pay-due">
                    <span class="pay-label">Total due</span>
                    <span class="pay-total" id="payTotal">₱0.00</span>
                    <span class="pay-vat">Includes <span id="payVat">₱0.00</span> VAT (@Vat.RateLabel)</span>
                </div>
                <div class="pay-field">
                    <label class="form-label" for="amountTendered">Amount tendered</label>
                    <div class="input-group">
                        <input type="number" step="0.01" min="0" id="amountTendered" name="amountTendered"
                               class="form-control" placeholder="0.00"
                               data-exact-modes="@string.Join(",", exactModeIds)" />
                        @* Card and exact cash are the common case; this saves
                           retyping a figure that is already on the screen. *@
                        <button type="button" class="btn btn-outline-secondary" id="payExact">Exact</button>
                    </div>
                    <div class="form-text" id="payExactNote" style="display:none;"></div>
                </div>
                <div class="pay-field">
                    <span class="form-label d-block">Change</span>
                    <div class="pay-change" id="payChange">₱0.00</div>
                </div>
            </div>
            <div class="pay-note" id="payNote">Add a line item to take payment.</div>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn-zx">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2Z"/><path d="M17 21v-8H7v8"/><path d="M7 3v5h8"/></svg>
                Complete Sale
            </button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        $(function () {
            var $customer = $('#customerId');
            var $vehicle = $('#vehicleId');

            // Every Pricing row for the selected vehicle's classification -
            // empty until a vehicle is picked, since panel pricing depends
            // on it. Re-fetched whenever the vehicle changes.
            var pricingMatrix = [];

            function loadVehicles(customerId) {
                $vehicle.prop('disabled', true).empty();

                if (!customerId) {
                    $vehicle.append($('<option></option>').val('').text('-- Select Customer First --'));
                    return;
                }

                $.getJSON('@Url.Action("VehiclesForCustomer")', { customerId: customerId })
                    .done(function (data) {
                        $vehicle.empty();
                        $vehicle.append($('<option></option>').val('').text('-- None --'));
                        $.each(data, function (i, v) {
                            $vehicle.append($('<option></option>').val(v.value).text(v.text));
                        });
                        $vehicle.prop('disabled', false);

                        // Only one vehicle on file for this customer - skip
                        // making the user pick it themselves.
                        if (data.length === 1) {
                            $vehicle.val(data[0].value).trigger('change');
                        }
                    });
            }

            $customer.on('change', function () {
                loadVehicles($(this).val());
            });

            function loadPricingMatrix(vehicleId) {
                if (!vehicleId) {
                    pricingMatrix = [];
                    reevaluateAllRows();
                    return;
                }

                $.getJSON('@Url.Action("PricingForVehicle")', { vehicleId: vehicleId })
                    .done(function (data) {
                        pricingMatrix = data;
                        $('#pricingLoadError').hide();
                        reevaluateAllRows();
                    })
                    .fail(function (xhr) {
                        pricingMatrix = [];
                        console.error('PricingForVehicle failed:', xhr.status, xhr.responseText);
                        $('#pricingLoadError').show();
                        reevaluateAllRows();
                    });
            }

            $vehicle.on('change', function () {
                loadPricingMatrix($(this).val());
            });

            function rowsForProduct(productId) {
                return pricingMatrix.filter(function (r) { return String(r.productId) === String(productId); });
            }

            function resetSelect($select, placeholder) {
                $select.empty().append($('<option></option>').val('').text(placeholder)).prop('disabled', true);

                // "-- N/A --" means this product has no such thing, so the
                // cell reads as a dash. The other placeholders are
                // instructions - "-- Select Tint Variant First --" is worth
                // showing, and stays a box.
                $select.closest('td').toggleClass('line-na', placeholder === '-- N/A --');
            }

            // A cell with something to pick is a box again.
            function usable($select) {
                $select.prop('disabled', false).closest('td').removeClass('line-na');
            }

            // The same product written on more than one row is one line of
            // several: four rows of "Armor Rear Side Step" at 1 tell the
            // customer nothing the single row "4" does not, and they invite
            // somebody deleting a duplicate to remove a quantity that was
            // really sold. The sale folds them together when it is saved -
            // this says so while the rows can still be changed.
            function showDuplicates() {
                var counts = {};
                var names = {};

                $('#linesTable tbody .line-row').each(function () {
                    var $product = $(this).find('.product-select');
                    var id = $product.val();
                    if (!id) { return; }

                    counts[id] = (counts[id] || 0) + 1;
                    names[id] = ($product.find(':selected').text() || '').replace(/\s*\([^)]*\)\s*$/, '').trim();
                });

                var repeated = Object.keys(counts).filter(function (id) { return counts[id] > 1; });
                var $note = $('#duplicateLines');

                if (repeated.length === 0) { $note.hide().text(''); return; }

                $note.text(repeated.map(function (id) {
                    return names[id] + ' is on ' + counts[id] + ' rows';
                }).join('; ') + ' - each is added together into one line when the sale is saved.').show();
            }

            function refreshPanels($row, tintVariantId) {
                var productId = $row.find('.product-select').val();
                var $panel = $row.find('.panel-select');
                var rows = rowsForProduct(productId).filter(function (r) {
                    return tintVariantId ? String(r.tintVariantId) === String(tintVariantId) : !r.tintVariantId;
                });

                resetSelect($panel, '-- Select Panel --');
                if (rows.length === 0) return;

                $.each(rows, function (i, r) {
                    $panel.append($('<option></option>').val(r.panelId).text(r.panelName).attr('data-price', r.price));
                });
                usable($panel);

                // Only one panel option for this product/variant - skip
                // making the user pick it themselves.
                if (rows.length === 1) {
                    $panel.val(rows[0].panelId).trigger('change');
                }
            }

            function refreshTintVariants($row) {
                var productId = $row.find('.product-select').val();
                var $tint = $row.find('.tint-variant-select');
                var rows = rowsForProduct(productId);

                var variants = [];
                var seen = {};
                $.each(rows, function (i, r) {
                    if (r.tintVariantId && !seen[r.tintVariantId]) {
                        seen[r.tintVariantId] = true;
                        variants.push({ id: r.tintVariantId, name: r.tintVariantName });
                    }
                });

                if (variants.length === 0) {
                    // No tint-variant split for this product - go straight to panels.
                    resetSelect($tint, '-- N/A --');
                    refreshPanels($row, null);
                    return;
                }

                resetSelect($tint, '-- Select Tint Variant --');
                $.each(variants, function (i, v) {
                    $tint.append($('<option></option>').val(v.id).text(v.name));
                });
                usable($tint);
                resetSelect($row.find('.panel-select'), '-- Select Tint Variant First --');

                if (variants.length === 1) {
                    $tint.val(variants[0].id).trigger('change');
                }
            }

            function evaluateProductRow($row) {
                var $product = $row.find('.product-select');
                var productId = $product.val();
                var rows = rowsForProduct(productId);

                if (rows.length > 0) {
                    // Matrix-priced product - needs Tint Variant/Panel picked
                    // to resolve an exact price, so clear any stale value.
                    $row.find('.unit-price').val('');
                    refreshTintVariants($row);
                } else {
                    resetSelect($row.find('.tint-variant-select'), '-- N/A --');
                    resetSelect($row.find('.panel-select'), '-- N/A --');

                    var price = $product.find(':selected').data('price');
                    if (price !== undefined && price !== '') {
                        $row.find('.unit-price').val(parseFloat(price).toFixed(2));
                    }
                }
                recalcTotal();
            }

            function reevaluateAllRows() {
                $('.line-row').each(function () { evaluateProductRow($(this)); });
            }

            // Stock guard. CreateSale re-checks inside its transaction and is
            // the authority; this only stops the trip when the answer is
            // already known, and says how many are actually left.
            function checkStockRow($row) {
                var $product = $row.find('.product-select');
                var $qty = $row.find('input[name=quantity]');
                var $cell = $qty.closest('td');

                $cell.find('.stock-warning').remove();
                $qty.removeClass('is-invalid');

                if (!$product.val()) { return true; }

                var stock = parseFloat($product.find(':selected').attr('data-stock'));
                if (isNaN(stock)) { return true; }

                var qty = parseFloat($qty.val()) || 0;
                if (stock <= 0) {
                    $qty.addClass('is-invalid');
                    $cell.append('<div class="stock-warning">Out of stock</div>');
                    return false;
                }
                if (qty > stock) {
                    $qty.addClass('is-invalid');
                    $cell.append('<div class="stock-warning">Only ' + stock + ' left</div>');
                    return false;
                }
                return true;
            }

            // Two things can hold the sale back - a line that outruns stock,
            // and a tender that does not cover the total. One place decides
            // the button so neither can quietly re-enable it behind the other.
            var stockOk = true;
            var paymentOk = false;
            var saleTotal = 0;

            function updateSubmit() {
                $('#saleForm button[type=submit]')
                    .prop('disabled', !(stockOk && paymentOk && pricesOk()));
            }

            // Every line that names a product has to carry a price. An empty
            // Price box posts nothing at all, which used to leave the server
            // reading three columns of different lengths and walking off the
            // end of one - an unhandled exception at the counter. It is a
            // blank box, so it is said as one.
            function pricesOk() {
                var ok = true;

                $('.line-row').each(function () {
                    var $row = $(this);
                    if (!$row.find('.product-select').val()) { return; }

                    var price = $row.find('.unit-price').val();
                    if (price === '' || price === null || isNaN(parseFloat(price))) { ok = false; }
                });

                $('#priceBlocked').toggle(!ok);
                return ok;
            }

            function refreshStockState() {
                stockOk = true;
                $('.line-row').each(function () {
                    if (!checkStockRow($(this))) { stockOk = false; }
                });
                $('#stockBlocked').toggle(!stockOk);
                updateSubmit();
                return stockOk;
            }

            function peso(value) {
                return '₱' + value.toLocaleString('en-US',
                    { minimumFractionDigits: 2, maximumFractionDigits: 2 });
            }

            // The 12% is inside the price, not added to it - the same split
            // Models/Vat.cs does on the server, and the figure the receipt
            // will show, so the two have to agree to the centavo.
            //
            // Worked in whole centavos because the plain division does not.
            // The server divides in decimal, where 6.30 / 1.12 is exactly
            // 5.625 and rounds up to 5.63; in a double it comes out a hair
            // under and rounds down to 5.62, leaving the form a centavo away
            // from the receipt on about one total in fifty. Dividing by 1.12
            // is the same as multiplying by 25/28, which stays whole.
            function vatOf(total) {
                var cents = Math.round(total * 100);
                var numerator = cents * 25;
                var vatable = Math.floor(numerator / 28);

                // Half a centavo goes away from zero, as decimal.Round does.
                if ((numerator % 28) * 2 >= 28) { vatable += 1; }

                return (cents - vatable) / 100;
            }

            // Everything except cash is charged the exact total - a transfer
            // and a wallet send what they were asked for, a card terminal is
            // charged it. So the box is filled in and locked rather than
            // asking for a figure that can only have one value. The server
            // settles it again either way; this is so nobody is asked a
            // question with one answer.
            var exactModes = ($('#amountTendered').data('exact-modes') + '')
                .split(',').filter(function (id) { return id !== ''; });

            function settlesExactly() {
                return exactModes.indexOf($('#paymentModeId').val() + '') !== -1;
            }

            function applyPaymentMode() {
                var exact = settlesExactly();
                var $tendered = $('#amountTendered');

                $tendered.prop('readonly', exact);
                $('#payExact').prop('disabled', exact);
                $('#payExactNote')
                    .text(exact ? $('#paymentModeId option:selected').text() + ' settles at the exact amount \u2014 no change.' : '')
                    .toggle(exact);

                if (exact) { $tendered.val(saleTotal > 0 ? saleTotal.toFixed(2) : ''); }
                updateChange();
            }

            function updateChange() {
                // Keep the locked figure on the total as lines are added.
                if (settlesExactly()) {
                    $('#amountTendered').val(saleTotal > 0 ? saleTotal.toFixed(2) : '');
                }

                var tendered = parseFloat($('#amountTendered').val());
                var typed = !isNaN(tendered);
                if (!typed) { tendered = 0; }

                var change = tendered - saleTotal;
                var $change = $('#payChange');

                if (saleTotal <= 0) {
                    $change.text(peso(0)).removeClass('is-short');
                    $('#payNote').text('Add a line item to take payment.').show();
                    paymentOk = false;
                } else if (change < 0) {
                    $change.text(peso(-change) + ' short').addClass('is-short');
                    $('#payNote')
                        .text(typed
                            ? 'This is short of the total - the sale cannot be completed yet.'
                            : 'Enter what the customer handed over, or press Exact.')
                        .show();
                    paymentOk = false;
                } else {
                    $change.text(peso(change)).removeClass('is-short');
                    $('#payNote').hide();
                    paymentOk = true;
                }

                updateSubmit();
            }

            function recalcTotal() {
                var total = 0;
                $('.line-row').each(function () {
                    var qty = parseFloat($(this).find('input[name=quantity]').val()) || 0;
                    var price = parseFloat($(this).find('input[name=unitPrice]').val()) || 0;
                    total += qty * price;
                });

                saleTotal = total;
                $('#grandTotal').text(peso(total));
                $('#payTotal').text(peso(total));
                $('#payVat').text(peso(vatOf(total)));
                updateChange();
            }

            $('#amountTendered').on('input', updateChange);

            $('#payExact').on('click', function () {
                $('#amountTendered').val(saleTotal.toFixed(2));
                updateChange();
            });

            $(document).on('change', '#paymentModeId', applyPaymentMode);

            $(document).on('change', '.product-select', function () {
                evaluateProductRow($(this).closest('tr'));
            });

            $(document).on('change', '.tint-variant-select', function () {
                refreshPanels($(this).closest('tr'), $(this).val());
                recalcTotal();
                refreshStockState();
            });

            $(document).on('change', '.panel-select', function () {
                var $row = $(this).closest('tr');
                var price = $(this).find(':selected').data('price');
                if (price !== undefined && price !== '') {
                    $row.find('.unit-price').val(parseFloat(price).toFixed(2));
                }
                recalcTotal();
                updateSubmit();
            });

            $(document).on('input', 'input[name=quantity], input[name=unitPrice]', function () {
                updateSubmit();
                recalcTotal();
                refreshStockState();
            });

            $(document).on('change', '.product-select', refreshStockState);
            $(document).on('change', '.product-select', showDuplicates);

            $('#addRow').on('click', function () {
                // Clone from the inert <template>, not the live first row -
                // the live row's Tint Variant and Panel lists have already
                // been narrowed to whatever product it is showing, and a new
                // row should start empty rather than inherit them.
                var frag = document.getElementById('lineRowTemplate').content.cloneNode(true);
                $('#linesTable tbody').append(frag);
                refreshStockState();
                showDuplicates();
            });

            $(document).on('click', '.remove-row', function () {
                $(this).closest('tr').remove();

                // Always leave at least one row so there's somewhere to add
                // a product - but the click itself should never be a no-op.
                if ($('.line-row').length === 0) {
                    var frag = document.getElementById('lineRowTemplate').content.cloneNode(true);
                    $('#linesTable tbody').append(frag);
                }

                recalcTotal();

                // The removed row may have been the one outrunning stock, so
                // the warning and the button are worked out again rather than
                // left on the last answer.
                refreshStockState();
                showDuplicates();
            });

            // Settle the total, the change and the button before anything is
            // touched - an empty cart cannot be completed, and neither can a
            // line with no price.
            recalcTotal();
            applyPaymentMode();
            refreshStockState();

            // ---- adding a walk-in without leaving the sale ----------------
            //
            // Posted with fetch rather than by submitting, because this sits
            // inside the sale's own form and a form cannot hold another: the
            // button would submit the sale instead.
            var $panel = $('#newCustomerPanel');
            var $error = $('#newCustomerError');

            function showError(message) {
                $error.text(message).toggle(!!message);
            }

            $('#newCustomerToggle').on('click', function () {
                var opening = $panel.is(':hidden');
                $panel.toggle(opening);
                showError('');
                if (opening) { $('#newCustomerLast').trigger('focus'); }
            });

            $('#newCustomerCancel').on('click', function () {
                $panel.hide();
                showError('');
            });

            // The number is stored as +63 and ten digits, so the box beside
            // the +63 holds the ten: whatever is pasted is reduced to them.
            $('#newCustomerNumber').on('input paste', function () {
                var field = this;
                setTimeout(function () {
                    var digits = field.value.replace(/\D/g, '');
                    if (digits.length === 12 && digits.indexOf('63') === 0) { digits = digits.slice(2); }
                    else if (digits.length === 11 && digits.charAt(0) === '0') { digits = digits.slice(1); }
                    digits = digits.slice(0, 10);
                    if (digits !== field.value) { field.value = digits; }
                }, 0);
            });

            $('#newCustomerSave').on('click', function () {
                var $button = $(this);
                showError('');
                $button.prop('disabled', true);

                $.ajax({
                    url: '@Url.Action("QuickCustomer")',
                    type: 'POST',
                    data: {
                        lastName: $('#newCustomerLast').val(),
                        firstName: $('#newCustomerFirst').val(),
                        contactNumber: $('#newCustomerNumber').val(),
                        __RequestVerificationToken: $('#saleForm input[name="__RequestVerificationToken"]').val()
                    }
                }).done(function (result) {
                    if (result.error) { showError(result.error); return; }

                    var $customer = $('#customerId');

                    // Only ever a customer that did not exist a moment ago -
                    // one already on file is refused above, not resolved - so
                    // the option is always new. Guarded anyway: appending a
                    // second option for one person would be worse than the
                    // line it saves.
                    if (!$customer.find('option[value="' + result.id + '"]').length) {
                        $customer.append($('<option></option>').val(result.id).text(result.name));
                    }

                    // Selected with change(), so the vehicle list reloads for
                    // them exactly as it would had they been picked by hand.
                    $customer.val(String(result.id)).trigger('change');

                    $panel.hide();
                    $('#newCustomerLast').val('');
                    $('#newCustomerFirst').val('');
                    $('#newCustomerNumber').val('');
                }).fail(function () {
                    showError('The customer could not be added. Check the connection and try again.');
                }).always(function () {
                    $button.prop('disabled', false);
                });
            });
        });
    </script>
}

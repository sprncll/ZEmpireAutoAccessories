@using ZEmpireAutoAccessories.Models
@{
    ViewData["Title"] = "New Sale";
    var products = ViewData["Products"] as List<Product> ?? new();

    // Stock on hand per product, rendered onto each option so a line can
    // warn as it is typed. CreateSale re-checks it inside its transaction -
    // this is only to save the trip.
    var stockByProduct = ViewData["StockByProduct"] as Dictionary<int, decimal> ?? new();

    // Film and PPF lines are written in metres; data-stock is published in
    // metres to match, so the per-row stock warning compares like with like.
    // The classes of car the price list is keyed by. A film line names one
    // instead of naming a quantity - see the Qty column.
    var classifications = ViewData["Classifications"] as IEnumerable<dynamic> ?? Enumerable.Empty<dynamic>();

    var rollProducts = ViewData["RollProducts"] as HashSet<int> ?? new HashSet<int>();

    // Modes charged the exact total, for the script below - it fills the
    // tendered amount in and locks it for those.
    var exactModeIds = ViewData["ExactPaymentModeIds"] as List<int> ?? new List<int>();
}

<style>
    #grandTotal { font-weight:700; font-size:18px; }

    /* A box nobody can use is not a box. A step board has no tint variant
       and no panel, and a row of greyed "-- N/A --" controls asks somebody
       to work out which of them they are meant to ignore - the same rule
       the job order's line form keeps, in the shape a table allows. */
    td.line-na > .ss-wrap, td.line-na > select { display:none; }
    td.line-na::after { content:"\2014"; color:#9aa2ad; }

    /* The same product written on two rows. Said while it can still be
       changed, rather than discovered on the receipt. */
    .price-note { font-size:11.5px; color:#8a6d1f; margin-top:3px; line-height:1.4; }

    .qty-label { font-size:11px; font-weight:600; color:#7b8290; text-transform:uppercase;
                 letter-spacing:.3px; margin-bottom:2px; }
    .cut-note { font-size:11.5px; color:#2f7a3e; margin-top:4px; line-height:1.4; font-weight:600; }
    .cut-note.missing { color:#b91c1c; font-weight:500; }

    #duplicateLines { font-size:12.5px; color:#8a6d1f; background:#fdf6e3;
                      border:1px solid #f0e3bd; border-radius:6px;
                      padding:7px 11px; margin-bottom:12px; display:none; }

    /* Same payment card as the service invoice, so the counter reads the
       same whichever document is being settled. */
    .pay-card { border-top:1px solid #e8ebf0; margin-top:6px; padding-top:18px; }
    .pay-form { display:flex; align-items:flex-end; gap:22px; flex-wrap:wrap; }
    .pay-due { display:flex; flex-direction:column; gap:2px; }
    .pay-label { font-size:12.5px; font-weight:600; text-transform:uppercase; letter-spacing:.3px; color:#7b8290; }
    .pay-total { font-size:26px; font-weight:700; font-variant-numeric:tabular-nums; color:#0b0b0c; }
    .pay-vat { font-size:12px; color:#7b8290; }
    .pay-field { min-width:190px; }
    .pay-change { font-size:22px; font-weight:700; font-variant-numeric:tabular-nums; color:#15803d; padding-top:2px; }
    .pay-change.is-short { color:#b91c1c; }
    .pay-note { font-size:12.5px; color:#7b8290; margin-top:8px; }
    @@media (max-width: 575.98px) { .pay-form { gap:14px; } .pay-field { min-width:0; flex:1 1 100%; } }
    .stock-warning { color:#b91c1c; font-size:11.5px; font-weight:600; margin-top:3px; }
</style>

<div class="zx-page-head">
    <h1>New Sale</h1>
</div>
<p class="zx-page-sub">Add line items, then complete the sale to deduct stock.</p>

<div class="zx-card padded narrow">
    <form asp-action="Create" method="post" id="saleForm" class="zx-form">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <div class="d-flex justify-content-between align-items-baseline">
                    <label class="form-label mb-1">Customer</label>
                    @* Added here rather than in the Customers module: a walk-in
                       is at the counter now, and leaving this page would lose
                       whatever has already been typed into the sale. *@
                    <button type="button" id="newCustomerToggle"
                            class="btn btn-link btn-sm p-0 text-decoration-none">+ New customer</button>
                </div>
                <select id="customerId" name="customerId" class="form-select" asp-items="ViewBag.CustomerID" required>
                    <option value="">-- Select Customer --</option>
                </select>

                <div id="newCustomerPanel" class="border rounded p-2 mt-2" style="display:none;background:#fbfcfd;">
                    <div class="row g-2 mb-2">
                        @* Last name first, the same way the Customers module
                           asks for it, so the two screens do not disagree
                           about what goes where. *@
                        <div class="col-6">
                            <label for="newCustomerLast" class="form-label mb-1" style="font-size:13px;">Last name</label>
                            <input type="text" id="newCustomerLast" class="form-control form-control-sm"
                                   maxlength="80" placeholder="Dela Cruz" autocomplete="family-name" />
                        </div>
                        <div class="col-6">
                            <label for="newCustomerFirst" class="form-label mb-1" style="font-size:13px;">First name</label>
                            <input type="text" id="newCustomerFirst" class="form-control form-control-sm"
                                   maxlength="60" placeholder="Juan" autocomplete="given-name" />
                        </div>
                    </div>
                    <div class="mb-2">
                        <label for="newCustomerNumber" class="form-label mb-1" style="font-size:13px;">Contact number</label>
                        <div class="input-group input-group-sm">
                            <span class="input-group-text">+63</span>
                            <input type="text" id="newCustomerNumber" class="form-control"
                                   inputmode="numeric" maxlength="10" placeholder="9121231231" />
                        </div>
                    </div>
                    <div id="newCustomerError" class="text-danger mb-2" style="font-size:12.5px;display:none;"></div>
                    <div class="d-flex gap-2">
                        <button type="button" id="newCustomerSave" class="btn btn-sm btn-zx">Add customer</button>
                        <button type="button" id="newCustomerCancel" class="btn btn-sm btn-outline-secondary">Cancel</button>
                    </div>
                    <div class="text-muted mt-2" style="font-size:12px;">
                        A vehicle can be added later from the Customers module.
                    </div>
                </div>
            </div>
            <div class="col-md-6 mb-3">
                <label class="form-label">Vehicle</label>
                <select id="vehicleId" name="vehicleId" class="form-select" disabled>
                    <option value="">-- Select Customer First --</option>
                </select>
            </div>
        </div>

        <div class="mb-3 col-md-4">
            <label class="form-label">Payment Mode</label>
            <select id="paymentModeId" name="paymentModeId" class="form-select" asp-items="ViewBag.PaymentModeID" required>
                <option value="">-- Select Payment Mode --</option>
            </select>
        </div>

        <h6 class="mt-4 mb-2">Line Items</h6>
        <p class="zx-page-sub mb-2">
            Film and tint are priced by panel: on the line, say which class of car, then the tint variant,
            the shade and the panel. The price and the length off the roll follow by themselves - there is
            no quantity to type. Everything else is counted as usual.
        </p>
        <div id="priceBlocked" class="alert alert-danger py-2 px-3" style="display:none; font-size:13px;">
            A line has no price yet. For film and tint, say which class of car and pick the tint variant,
            the shade and the panel - the price comes from those. If the price list has nothing for that
            combination, an administrator sets one under Pricing.
        </div>
        <div id="stockBlocked" class="alert alert-danger py-2 px-3" style="display:none; font-size:13px;">
            One or more lines ask for more than there is in stock. Fix the highlighted quantities to continue.
        </div>
        <div id="pricingLoadError" class="alert alert-warning py-2 px-3" style="display:none; font-size:13px;">
            Couldn't load panel pricing for this vehicle - panel-priced products will need a manual Unit Price for now.
        </div>
        <div class="table-responsive">
        <table class="table zx-table" id="linesTable">
            <thead>
                <tr>
                    @* Percentages for the columns that hold names, so they
                       share the extra width instead of the table leaving a
                       gap; fixed widths only for the numeric ones. *@
                    <th style="width:22%;">Product</th>
                    @* The four that only film and tint answer. A panel price
                       is keyed to a class of car, and the variant and shade
                       say which film it is. *@
                    <th style="width:13%;">Vehicle Class</th>
                    <th style="width:14%;">Tint Variant</th>
                    <th style="width:16%;">Shade</th>
                    <th style="width:15%;">Panel</th>
                    @* And the one that everything except film answers. *@
                    <th style="width:80px;">Qty</th>
                    <th style="width:120px;">Unit Price</th>
                    <th style="width:44px;"></th>
                </tr>
            </thead>
            <tbody>
                <tr class="line-row">
                    <td>
                        <select name="productId" class="form-select product-select" required>
                            <option value="">-- Select Product --</option>
                            @foreach (var p in products)
                            {
                                <option value="@p.ProductID" data-price="@p.DefaultPrice" data-roll="@(rollProducts.Contains(p.ProductID).ToString().ToLowerInvariant())" data-stock="@(stockByProduct.TryGetValue(p.ProductID, out var st) ? (rollProducts.Contains(p.ProductID) ? st / 100m : st) : 0)">@p.ProductName@(stockByProduct.TryGetValue(p.ProductID, out var sa) && sa > 0 ? $" ({ZEmpireAutoAccessories.Models.UnitOfMeasure.Describe(sa, rollProducts.Contains(p.ProductID))} in stock)" : " (out of stock)")</option>
                            }
                        </select>
                    </td>
                    @* Film and tint are priced by the class of car. Everything else has
                       no class to be priced for, and reads as a dash. The select is
                       hidden rather than removed on those rows: every row has to post a
                       value in every column or the columns stop lining up, and the
                       panels start belonging to the wrong lines. *@
                    <td class="line-na">
                        <select name="classificationId" class="form-select classification-select" data-searchable="false">
                            <option value="">-- Select Vehicle Class --</option>
                            @foreach (var c in classifications)
                            {
                                <option value="@c.VehicleClassificationID">@c.ClassificationName</option>
                            }
                        </select>
                    </td>
                    <td class="line-na">
                        <select class="form-select tint-variant-select" disabled>
                            <option value="">-- N/A --</option>
                        </select>
                    </td>
                    @* Which shade left the rack. Recorded on the line, not just shown:
                       sales.SalesDetail.ShadeID. *@
                    <td class="line-na">
                        <select name="shadeId" class="form-select shade-select" data-searchable="false">
                            <option value="">-- N/A --</option>
                        </select>
                    </td>
                    <td class="line-na">
                        <select class="form-select panel-select" disabled>
                            <option value="">-- N/A --</option>
                        </select>
                        @* What that panel takes off the roll, under the panel it comes
                           from. *@
                        <div class="cut-note" style="display:none;"></div>
                        @* A disabled select posts nothing, so the panel's id travels in
                           here instead. *@
                        <input type="hidden" name="panelId" class="panel-id" value="" />
                    </td>
                    @* Counted goods only. A panel of film is a panel - what leaves the
                       roll is its cut size, and nobody types that. *@
                    <td>
                        <input type="number" name="quantity" class="form-control" value="1" min="1" required
                               title="How many - metres, where film is sold off the roll" />
                    </td>
                    @* The price list decides. Read-only to everybody: an administrator
                       changes what the list says, under Pricing, not what one line
                       charges. The exception is a product the list holds no price for
                       at all, which the form unlocks and says so - see the script. *@
                    <td>
                        <input type="number" step="0.01" name="unitPrice" class="form-control unit-price" min="0" required
                               readonly tabindex="-1" />
                    </td>
                    <td><button type="button" class="btn btn-sm btn-outline-danger remove-row">&times;</button></td>
            </tr>
            </tbody>
        </table>
        </div>
        <div id="duplicateLines"></div>
        <button type="button" class="btn btn-outline-secondary btn-sm mb-3" id="addRow">+ Add Item</button>
        <div class="form-text mb-3">
            Prices come from the price list and are not typed here. An administrator sets what the list
            says, under Pricing.
        </div>

        <template id="lineRowTemplate">
            <tr class="line-row">
                <td>
                    <select name="productId" class="form-select product-select" required>
                        <option value="">-- Select Product --</option>
                        @foreach (var p in products)
                        {
                            <option value="@p.ProductID" data-price="@p.DefaultPrice" data-roll="@(rollProducts.Contains(p.ProductID).ToString().ToLowerInvariant())" data-stock="@(stockByProduct.TryGetValue(p.ProductID, out var st) ? (rollProducts.Contains(p.ProductID) ? st / 100m : st) : 0)">@p.ProductName@(stockByProduct.TryGetValue(p.ProductID, out var sa) && sa > 0 ? $" ({ZEmpireAutoAccessories.Models.UnitOfMeasure.Describe(sa, rollProducts.Contains(p.ProductID))} in stock)" : " (out of stock)")</option>
                        }
                    </select>
                </td>
                @* Film and tint are priced by the class of car. Everything else has
                   no class to be priced for, and reads as a dash. The select is
                   hidden rather than removed on those rows: every row has to post a
                   value in every column or the columns stop lining up, and the
                   panels start belonging to the wrong lines. *@
                <td class="line-na">
                    <select name="classificationId" class="form-select classification-select" data-searchable="false">
                        <option value="">-- Select Vehicle Class --</option>
                        @foreach (var c in classifications)
                        {
                            <option value="@c.VehicleClassificationID">@c.ClassificationName</option>
                        }
                    </select>
                </td>
                <td class="line-na">
                    <select class="form-select tint-variant-select" disabled>
                        <option value="">-- N/A --</option>
                    </select>
                </td>
                @* Which shade left the rack. Recorded on the line, not just shown:
                   sales.SalesDetail.ShadeID. *@
                <td class="line-na">
                    <select name="shadeId" class="form-select shade-select" data-searchable="false">
                        <option value="">-- N/A --</option>
                    </select>
                </td>
                <td class="line-na">
                    <select class="form-select panel-select" disabled>
                        <option value="">-- N/A --</option>
                    </select>
                    @* What that panel takes off the roll, under the panel it comes
                       from. *@
                    <div class="cut-note" style="display:none;"></div>
                    @* A disabled select posts nothing, so the panel's id travels in
                       here instead. *@
                    <input type="hidden" name="panelId" class="panel-id" value="" />
                </td>
                @* Counted goods only. A panel of film is a panel - what leaves the
                   roll is its cut size, and nobody types that. *@
                <td>
                    <input type="number" name="quantity" class="form-control" value="1" min="1" required
                           title="How many - metres, where film is sold off the roll" />
                </td>
                @* The price list decides. Read-only to everybody: an administrator
                   changes what the list says, under Pricing, not what one line
                   charges. The exception is a product the list holds no price for
                   at all, which the form unlocks and says so - see the script. *@
                <td>
                    <input type="number" step="0.01" name="unitPrice" class="form-control unit-price" min="0" required
                           readonly tabindex="-1" />
                </td>
                <td><button type="button" class="btn btn-sm btn-outline-danger remove-row">&times;</button></td>
        </tr>
        </template>

        <div class="text-end mb-3">
            Total: <span id="grandTotal">₱0.00</span>
        </div>

        @* Nothing about the tender is stored - sales.Sales holds the total and
           nothing else - so this is the counter's working-out: what is due,
           what was handed over, and the change to give back. The figures reach
           the receipt page for this one visit; the sale itself records the
           line items and the total, as it always has. *@
        <div class="pay-card">
            <h6 class="mb-1">Take payment</h6>
            <p class="zx-page-sub mb-3" style="margin-top:0;">
                Enter what the customer handed over. The change is worked out for you.
            </p>
            <div class="pay-form">
                <div class="pay-due">
                    <span class="pay-label">Total due</span>
                    <span class="pay-total" id="payTotal">₱0.00</span>
                    <span class="pay-vat">Includes <span id="payVat">₱0.00</span> VAT (@Vat.RateLabel)</span>
                </div>
                <div class="pay-field">
                    <label class="form-label" for="amountTendered">Amount tendered</label>
                    <div class="input-group">
                        <input type="number" step="0.01" min="0" id="amountTendered" name="amountTendered"
                               class="form-control" placeholder="0.00"
                               data-exact-modes="@string.Join(",", exactModeIds)" />
                        @* Card and exact cash are the common case; this saves
                           retyping a figure that is already on the screen. *@
                        <button type="button" class="btn btn-outline-secondary" id="payExact">Exact</button>
                    </div>
                    <div class="form-text" id="payExactNote" style="display:none;"></div>
                </div>
                <div class="pay-field">
                    <span class="form-label d-block">Change</span>
                    <div class="pay-change" id="payChange">₱0.00</div>
                </div>
            </div>
            <div class="pay-note" id="payNote">Add a line item to take payment.</div>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn-zx">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2Z"/><path d="M17 21v-8H7v8"/><path d="M7 3v5h8"/></svg>
                Complete Sale
            </button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        $(function () {
            var $customer = $('#customerId');
            var $vehicle = $('#vehicleId');

            // The price list, one class of car at a time, fetched as it is
            // needed and kept.
            //
            // It used to be a single list for the vehicle on the sale, which
            // left a walk-in with no prices at all: the price list is keyed
            // by the CLASS of car, and someone who has never been here before
            // has no vehicle on file to read a class off. So a film line
            // names its own class, the prices for that class are fetched, and
            // the panel it is for gives the price and the length.
            var matrixByClass = {};
            var saleClassId = '';

            function matrixFor(classId) {
                return (classId && matrixByClass[classId]) ? matrixByClass[classId] : [];
            }

            // Fetches a class's prices once, then calls back. Calling again
            // for a class already held is free.
            function loadMatrix(classId, then) {
                if (!classId) { if (then) { then(); } return; }
                if (matrixByClass[classId]) { if (then) { then(); } return; }

                $.getJSON('@Url.Action("PricingForClassification")', { classificationId: classId })
                    .done(function (data) {
                        matrixByClass[classId] = (data && data.rows) ? data.rows : [];
                        $('#pricingLoadError').hide();
                        if (then) { then(); }
                    })
                    .fail(function (xhr) {
                        matrixByClass[classId] = [];
                        console.error('PricingForClassification failed:', xhr.status, xhr.responseText);
                        $('#pricingLoadError').show();
                        if (then) { then(); }
                    });
            }

            // The class a row is priced against: the one it names, or the
            // class of the car on the sale where there is one.
            function classOf($row) {
                return $row.find('.classification-select').val() || '';
            }

            // What is on the rack shade by shade, for the films that have
            // shades on file. A customer buying tint asks which shades there
            // are before anything else, and "92.61 m in stock" cannot answer
            // it - the ledger records a product and nothing finer.
            var shadeStock = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewData["ShadeStock"] ?? new List<object>()));

            // Every tint variant a product has, and the shades under each,
            // from the catalogue. The price list only knows the combinations
            // somebody has priced for a class of car; what a film IS does not
            // depend on which car is in front of it.
            var variantsByProduct = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewData["VariantsByProduct"] ?? new List<object>()));
            var shadesByVariant = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewData["ShadesByVariant"] ?? new List<object>()));

            // What is left of each shade, by shade, for the figures beside
            // the names.
            var shadeFigures = {};
            $.each(shadeStock, function (i, product) {
                $.each(product.shades || [], function (j, sh) {
                    shadeFigures[String(sh.shadeId)] = sh;
                });
            });

            function metres(centimetres) {
                return centimetres >= 100
                    ? (centimetres / 100).toFixed(2) + ' m'
                    : centimetres.toFixed(1) + ' cm';
            }

            // Which shade is leaving the rack, and how much of each there is
            // to leave.
            //
            // A shade belongs to a tint variant, so there is nothing to ask
            // until the variant is known - the box stays a dash until then,
            // rather than offering Freeze's shades beside a line that says
            // Play. The figures come from the last stock count and the lines
            // since, so they are an estimate; a shade with nothing left is
            // still offered, marked, because a roll nobody counted is still
            // a roll.
            function fillShades($row) {
                var $shade = $row.find('.shade-select');
                var $cell = $shade.closest('td');
                var $variant = $row.find('.tint-variant-select');
                var variantId = $variant.prop('disabled') ? '' : ($variant.val() || '');

                $shade.empty();

                var shades = variantId
                    ? $.grep(shadesByVariant, function (sh) {
                          return String(sh.tintVariantId) === String(variantId);
                      })
                    : [];

                if (shades.length === 0) {
                    // Nothing to pick, but the box still posts its blank: the
                    // columns have to stay the same length.
                    $shade.append($('<option></option>').val('').text('-- N/A --'));
                    $cell.addClass('line-na');
                    return;
                }

                $shade.append($('<option></option>').val('').text('-- Select Shade --'));

                $.each(shades, function (i, sh) {
                    var figure = shadeFigures[String(sh.shadeId)];
                    var text = sh.shadeName;

                    if (figure) {
                        if (figure.left === null || figure.left === undefined) {
                            text += ' - not counted';
                        } else if (figure.left <= 0) {
                            text += ' - none left';
                        } else {
                            text += ' - ' + metres(figure.left);
                        }
                    }

                    $shade.append($('<option></option>').val(sh.shadeId).text(text));
                });

                $cell.removeClass('line-na');

                // Only one shade under this variant - skip making the user
                // pick it themselves.
                if (shades.length === 1) {
                    $shade.val(shades[0].shadeId);
                }
            }

            function loadVehicles(customerId) {
                $vehicle.prop('disabled', true).empty();

                if (!customerId) {
                    $vehicle.append($('<option></option>').val('').text('-- Select Customer First --'));
                    return;
                }

                $.getJSON('@Url.Action("VehiclesForCustomer")', { customerId: customerId })
                    .done(function (data) {
                        $vehicle.empty();
                        $vehicle.append($('<option></option>').val('').text('-- None --'));
                        $.each(data, function (i, v) {
                            $vehicle.append($('<option></option>').val(v.value).text(v.text));
                        });
                        $vehicle.prop('disabled', false);

                        // Only one vehicle on file for this customer - skip
                        // making the user pick it themselves.
                        if (data.length === 1) {
                            $vehicle.val(data[0].value).trigger('change');
                        }
                    });
            }

            $customer.on('change', function () {
                loadVehicles($(this).val());
            });

            // Picking the customer's car is a way of saying which class the
            // film lines are for - it fills the class in on every film row
            // that has not been told otherwise. The row still decides.
            function loadPricingMatrix(vehicleId) {
                if (!vehicleId) {
                    saleClassId = '';
                    reevaluateAllRows();
                    return;
                }

                $.getJSON('@Url.Action("PricingForVehicle")', { vehicleId: vehicleId })
                    .done(function (data) {
                        saleClassId = data && data.classificationId ? String(data.classificationId) : '';
                        if (saleClassId) { matrixByClass[saleClassId] = (data.rows || []); }
                        $('#pricingLoadError').hide();

                        $('.line-row').each(function () {
                            var $select = $(this).find('.classification-select');
                            if (saleClassId && !$select.val()) { $select.val(saleClassId); }
                        });

                        reevaluateAllRows();
                    })
                    .fail(function (xhr) {
                        console.error('PricingForVehicle failed:', xhr.status, xhr.responseText);
                        $('#pricingLoadError').show();
                        reevaluateAllRows();
                    });
            }

            $vehicle.on('change', function () {
                loadPricingMatrix($(this).val());
            });

            function rowsForProduct(productId, classId) {
                return matrixFor(classId).filter(function (r) {
                    return String(r.productId) === String(productId);
                });
            }

            function resetSelect($select, placeholder) {
                $select.empty().append($('<option></option>').val('').text(placeholder)).prop('disabled', true);

                // "-- N/A --" means this product has no such thing, so the
                // cell reads as a dash. The other placeholders are
                // instructions - "-- Select Tint Variant First --" is worth
                // showing, and stays a box.
                $select.closest('td').toggleClass('line-na', placeholder === '-- N/A --');
            }

            // A cell with something to pick is a box again.
            function usable($select) {
                $select.prop('disabled', false).closest('td').removeClass('line-na');
            }

            // The same product written on more than one row is one line of
            // several: four rows of "Armor Rear Side Step" at 1 tell the
            // customer nothing the single row "4" does not, and they invite
            // somebody deleting a duplicate to remove a quantity that was
            // really sold. The sale folds them together when it is saved -
            // this says so while the rows can still be changed.
            function showDuplicates() {
                var counts = {};
                var names = {};

                $('#linesTable tbody .line-row').each(function () {
                    var $product = $(this).find('.product-select');
                    var id = $product.val();
                    if (!id) { return; }

                    counts[id] = (counts[id] || 0) + 1;
                    names[id] = ($product.find(':selected').text() || '').replace(/\s*\([^)]*\)\s*$/, '').trim();
                });

                var repeated = Object.keys(counts).filter(function (id) { return counts[id] > 1; });
                var $note = $('#duplicateLines');

                if (repeated.length === 0) { $note.hide().text(''); return; }

                $note.text(repeated.map(function (id) {
                    return names[id] + ' is on ' + counts[id] + ' rows';
                }).join('; ') + ' - each is added together into one line when the sale is saved.').show();
            }

            function refreshPanels($row, tintVariantId) {
                var productId = $row.find('.product-select').val();
                var $panel = $row.find('.panel-select');
                var rows = rowsForProduct(productId, classOf($row)).filter(function (r) {
                    return tintVariantId ? String(r.tintVariantId) === String(tintVariantId) : !r.tintVariantId;
                });

                resetSelect($panel, '-- Select Panel --');
                if (rows.length === 0) { syncPanel($row); return; }

                $.each(rows, function (i, r) {
                    // The cut size rides on the option: it is what leaves the
                    // roll, and the counter should see it before the sale.
                    $panel.append($('<option></option>')
                        .val(r.panelId)
                        .text(r.panelName)
                        .attr('data-price', r.price)
                        .attr('data-cut', r.cutCm === null || r.cutCm === undefined ? '' : r.cutCm));
                });
                usable($panel);

                // Only one panel option for this product/variant - skip
                // making the user pick it themselves.
                if (rows.length === 1) {
                    $panel.val(rows[0].panelId).trigger('change');
                }
            }

            function refreshTintVariants($row) {
                var productId = $row.find('.product-select').val();
                var $tint = $row.find('.tint-variant-select');

                // From the CATALOGUE, not the price list. Read off the price
                // list, a film with no priced row for the class in front of
                // it offered no variant at all - the box went empty exactly
                // when somebody needed to say what they were selling. What a
                // film is does not depend on which car is in front of it;
                // only the panel and the price do.
                var variants = $.grep(variantsByProduct, function (v) {
                    return String(v.productId) === String(productId);
                }).map(function (v) {
                    return { id: v.tintVariantId, name: v.tintVariantName };
                });

                if (variants.length === 0) {
                    // This product genuinely has no variants - most do not.
                    resetSelect($tint, '-- N/A --');
                    fillShades($row);
                    refreshPanels($row, null);
                    return;
                }

                resetSelect($tint, '-- Select Tint Variant --');
                $.each(variants, function (i, v) {
                    $tint.append($('<option></option>').val(v.id).text(v.name));
                });
                usable($tint);
                resetSelect($row.find('.panel-select'), '-- Select Tint Variant First --');

                if (variants.length === 1) {
                    $tint.val(variants[0].id).trigger('change');
                } else {
                    // Nothing picked yet, so there is no shade to offer.
                    fillShades($row);
                }
            }

            function evaluateProductRow($row) {
                var $product = $row.find('.product-select');
                var productId = $product.val();

                // Film and tint are priced by panel, and a panel price is
                // keyed to a class of car - so a film row asks which class
                // instead of asking how many. Everything else is counted.
                var isFilm = $product.find(':selected').data('roll') === true;
                var $class = $row.find('.classification-select');

                // The class cell is a dash on anything that is not film.
                $class.closest('td').toggleClass('line-na', !isFilm);

                // The car on the sale is a sensible first answer, but only
                // until somebody answers for themselves: picking "By the
                // metre" has to stick, or the next refresh would put the
                // class back and take the Qty box away again.
                if (isFilm && !$class.val() && saleClassId && !$class.data('touched')) {
                    $class.val(saleClassId);
                }

                if (!isFilm) { $class.val('').removeData('touched'); }

                // The prices for this row's class may not be in hand yet.
                // Fetch them, then come back and do the rest.
                var classId = classOf($row);
                if (isFilm && classId && !matrixByClass[classId]) {
                    loadMatrix(classId, function () { evaluateProductRow($row); });
                    return;
                }

                var rows = rowsForProduct(productId, classId);

                if (isFilm || rows.length > 0) {
                    // Film goes through the pickers whatever the price list
                    // holds: the variant and the shade say what is being
                    // sold, and the panel and the class give the price and
                    // the length. Any stale price is cleared, since the panel
                    // is what will fill it.
                    $row.find('.unit-price').val('');
                    refreshTintVariants($row);
                } else {
                    resetSelect($row.find('.tint-variant-select'), '-- N/A --');
                    resetSelect($row.find('.panel-select'), '-- N/A --');
                    fillShades($row);

                    var price = $product.find(':selected').data('price');
                    if (price !== undefined && price !== '') {
                        $row.find('.unit-price').val(parseFloat(price).toFixed(2));
                    }
                }

                syncPanel($row);
                allowTypedPriceWhereThereIsNone($row);
                recalcTotal();
                updateSubmit();
            }

            // What the row posts for its panel, and what the panel means for
            // the roll.
            //
            // For film and tint the quantity is not the question - a panel is
            // a panel. What matters is how much film that panel takes on that
            // class of car, which is the cut size, and that is what comes off
            // the inventory. So the Qty box steps aside and the length is
            // shown in its place.
            //
            // The id goes in a hidden input rather than being read off the
            // select, because a disabled select posts nothing and these
            // columns have to stay the same length as the rows beside them.
            function syncPanel($row) {
                var $panel = $row.find('.panel-select');
                var $selected = $panel.find(':selected');
                var panelId = $panel.prop('disabled') ? '' : ($panel.val() || '');

                $row.find('.panel-id').val(panelId);

                var $qty = $row.find('input[name=quantity]');
                var $note = $row.find('.cut-note');
                var cut = parseFloat($selected.attr('data-cut'));

                // Film has no quantity box at all. How many is not the
                // question anybody asks about tint: what is bought is a panel
                // on a class of car, and how much film that takes is the cut
                // size, which nobody types. The box stays in the form holding
                // a 1, because the columns have to post the same number of
                // values, but it is not on screen to be answered.
                var isFilm = $row.find('.product-select :selected').data('roll') === true;
                var classChosen = !!classOf($row);

                // Whether the price list holds anything at all for this film
                // on this class of car.
                //
                // Asked of the price list, not of the Panel box. The Panel
                // box is also empty while it waits for a tint variant to be
                // picked, and reading that as "no prices for this class"
                // dropped a row into selling by the metre - with a quantity
                // of 1 sitting there - before anybody had been given the
                // chance to answer the two boxes in front of it.
                var priced = isFilm && classChosen
                    && rowsForProduct($row.find('.product-select').val(), classOf($row)).length > 0;

                // The one case film still goes by the metre: a class of car
                // the price list has nothing for. Refusing the sale there
                // would mean a customer turned away over a gap in a table, so
                // the Qty box comes back and the price is typed - but only
                // once somebody has named a class and there is genuinely
                // nothing for it.
                var byLength = isFilm && classChosen && !priced;

                var counted = !isFilm || byLength;

                $qty.toggle(counted);
                $qty.closest('td').toggleClass('line-na', !counted);
                if (!counted) { $qty.val(1); }

                // Where the box IS the answer on a film row, it is counting
                // metres off the roll - and a bare "1" in a column headed Qty
                // does not say that.
                var $qtyLabel = $row.find('.qty-label');
                if (byLength) {
                    if ($qtyLabel.length === 0) { $qty.before('<div class="qty-label">Metres</div>'); }
                } else {
                    $qtyLabel.remove();
                }

                if (!panelId) {
                    var waitingForVariant = priced
                        && $row.find('.tint-variant-select').is(':enabled')
                        && !$row.find('.tint-variant-select').val();

                    $note.toggleClass('missing', false)
                         .text(!isFilm ? ''
                             : byLength ? 'No panel prices for this class - sold by the metre'
                             : waitingForVariant ? 'Pick a tint variant first'
                             : classChosen ? 'The length comes from the panel'
                             : 'Say which class of car first')
                         .toggle(isFilm);
                    return;
                }

                $note.text(isNaN(cut) || cut <= 0
                        ? 'No cut size for this panel - set one under Inventory, Cut Sizes'
                        : metres(cut) + ' off the roll')
                     .toggleClass('missing', isNaN(cut) || cut <= 0)
                     .show();
            }

            // The price is the price list's, and the box is read-only to
            // everybody: an administrator changes what the list says, under
            // Pricing, not what one line at the counter charges.
            //
            // One exception, and the server keeps the same line - it accepts
            // a typed price only where it finds no price of its own. A
            // product the list holds nothing for would otherwise be a locked
            // empty box: nobody could ring the sale up, with the customer
            // standing at the counter. The job order has the same carve-out.
            function allowTypedPriceWhereThereIsNone($row) {
                var $price = $row.find('.unit-price');
                var productId = $row.find('.product-select').val();
                var flat = parseFloat($row.find('.product-select :selected').data('price'));
                var hasBookPrice = rowsForProduct(productId, classOf($row)).length > 0
                    || (!isNaN(flat) && flat > 0);

                if (hasBookPrice) {
                    $price.prop('readonly', true).attr('tabindex', '-1').removeAttr('placeholder');
                    $row.find('.price-note').remove();
                } else {
                    $price.prop('readonly', false).removeAttr('tabindex')
                          .attr('placeholder', 'No price on file');

                    if ($row.find('.price-note').length === 0) {
                        $price.closest('td').append(
                            '<div class="price-note">Nothing in the price list for this - type what was agreed.</div>');
                    }
                }
            }

            function reevaluateAllRows() {
                $('.line-row').each(function () { evaluateProductRow($(this)); });
            }

            // Stock guard. CreateSale re-checks inside its transaction and is
            // the authority; this only stops the trip when the answer is
            // already known, and says how many are actually left.
            function checkStockRow($row) {
                var $product = $row.find('.product-select');
                var $qty = $row.find('input[name=quantity]');
                var $cell = $qty.closest('td');

                $cell.find('.stock-warning').remove();
                $qty.removeClass('is-invalid');

                if (!$product.val()) { return true; }

                var stock = parseFloat($product.find(':selected').attr('data-stock'));
                if (isNaN(stock)) { return true; }

                // A panel line takes the cut size, not the quantity: "1" of
                // a Full Wrap is several metres of film, and comparing the 1
                // against the metres on the rack would call an empty roll
                // plenty. Both are in metres here, as the product list reads.
                var cut = parseFloat($row.find('.panel-select :selected').attr('data-cut'));
                var typed = parseFloat($qty.val()) || 0;
                var onPanel = !!$row.find('.panel-id').val();

                // A panel nobody has measured cannot be taken off the roll:
                // the sale would have to guess how much film left, and the
                // server refuses it anyway. Said here, before the customer is
                // told a price.
                if (onPanel && (isNaN(cut) || cut <= 0)) {
                    $cell.append('<div class="stock-warning">No cut size for this panel</div>');
                    return false;
                }

                var qty = (onPanel && !isNaN(cut) && cut > 0)
                    ? (cut / 100) * (typed || 1)
                    : typed;

                if (stock <= 0) {
                    $qty.addClass('is-invalid');
                    $cell.append('<div class="stock-warning">Out of stock</div>');
                    return false;
                }
                if (qty > stock) {
                    $qty.addClass('is-invalid');
                    $cell.append('<div class="stock-warning">This takes '
                        + qty.toFixed(2) + ' - only ' + stock + ' left</div>');
                    return false;
                }
                return true;
            }

            // Two things can hold the sale back - a line that outruns stock,
            // and a tender that does not cover the total. One place decides
            // the button so neither can quietly re-enable it behind the other.
            var stockOk = true;
            var paymentOk = false;
            var saleTotal = 0;

            function updateSubmit() {
                $('#saleForm button[type=submit]')
                    .prop('disabled', !(stockOk && paymentOk && pricesOk()));
            }

            // Every line that names a product has to carry a price. An empty
            // Price box posts nothing at all, which used to leave the server
            // reading three columns of different lengths and walking off the
            // end of one - an unhandled exception at the counter. It is a
            // blank box, so it is said as one.
            function pricesOk() {
                var ok = true;

                $('.line-row').each(function () {
                    var $row = $(this);
                    if (!$row.find('.product-select').val()) { return; }

                    var price = $row.find('.unit-price').val();
                    if (price === '' || price === null || isNaN(parseFloat(price))) { ok = false; }
                });

                $('#priceBlocked').toggle(!ok);
                return ok;
            }

            function refreshStockState() {
                stockOk = true;
                $('.line-row').each(function () {
                    if (!checkStockRow($(this))) { stockOk = false; }
                });
                $('#stockBlocked').toggle(!stockOk);
                updateSubmit();
                return stockOk;
            }

            function peso(value) {
                return '₱' + value.toLocaleString('en-US',
                    { minimumFractionDigits: 2, maximumFractionDigits: 2 });
            }

            // The 12% is inside the price, not added to it - the same split
            // Models/Vat.cs does on the server, and the figure the receipt
            // will show, so the two have to agree to the centavo.
            //
            // Worked in whole centavos because the plain division does not.
            // The server divides in decimal, where 6.30 / 1.12 is exactly
            // 5.625 and rounds up to 5.63; in a double it comes out a hair
            // under and rounds down to 5.62, leaving the form a centavo away
            // from the receipt on about one total in fifty. Dividing by 1.12
            // is the same as multiplying by 25/28, which stays whole.
            function vatOf(total) {
                var cents = Math.round(total * 100);
                var numerator = cents * 25;
                var vatable = Math.floor(numerator / 28);

                // Half a centavo goes away from zero, as decimal.Round does.
                if ((numerator % 28) * 2 >= 28) { vatable += 1; }

                return (cents - vatable) / 100;
            }

            // Everything except cash is charged the exact total - a transfer
            // and a wallet send what they were asked for, a card terminal is
            // charged it. So the box is filled in and locked rather than
            // asking for a figure that can only have one value. The server
            // settles it again either way; this is so nobody is asked a
            // question with one answer.
            var exactModes = ($('#amountTendered').data('exact-modes') + '')
                .split(',').filter(function (id) { return id !== ''; });

            function settlesExactly() {
                return exactModes.indexOf($('#paymentModeId').val() + '') !== -1;
            }

            function applyPaymentMode() {
                var exact = settlesExactly();
                var $tendered = $('#amountTendered');

                $tendered.prop('readonly', exact);
                $('#payExact').prop('disabled', exact);
                $('#payExactNote')
                    .text(exact ? $('#paymentModeId option:selected').text() + ' settles at the exact amount \u2014 no change.' : '')
                    .toggle(exact);

                if (exact) { $tendered.val(saleTotal > 0 ? saleTotal.toFixed(2) : ''); }
                updateChange();
            }

            function updateChange() {
                // Keep the locked figure on the total as lines are added.
                if (settlesExactly()) {
                    $('#amountTendered').val(saleTotal > 0 ? saleTotal.toFixed(2) : '');
                }

                var tendered = parseFloat($('#amountTendered').val());
                var typed = !isNaN(tendered);
                if (!typed) { tendered = 0; }

                var change = tendered - saleTotal;
                var $change = $('#payChange');

                if (saleTotal <= 0) {
                    $change.text(peso(0)).removeClass('is-short');
                    $('#payNote').text('Add a line item to take payment.').show();
                    paymentOk = false;
                } else if (change < 0) {
                    $change.text(peso(-change) + ' short').addClass('is-short');
                    $('#payNote')
                        .text(typed
                            ? 'This is short of the total - the sale cannot be completed yet.'
                            : 'Enter what the customer handed over, or press Exact.')
                        .show();
                    paymentOk = false;
                } else {
                    $change.text(peso(change)).removeClass('is-short');
                    $('#payNote').hide();
                    paymentOk = true;
                }

                updateSubmit();
            }

            function recalcTotal() {
                var total = 0;
                $('.line-row').each(function () {
                    var qty = parseFloat($(this).find('input[name=quantity]').val()) || 0;
                    var price = parseFloat($(this).find('input[name=unitPrice]').val()) || 0;
                    total += qty * price;
                });

                saleTotal = total;
                $('#grandTotal').text(peso(total));
                $('#payTotal').text(peso(total));
                $('#payVat').text(peso(vatOf(total)));
                updateChange();
            }

            $('#amountTendered').on('input', updateChange);

            $('#payExact').on('click', function () {
                $('#amountTendered').val(saleTotal.toFixed(2));
                updateChange();
            });

            $(document).on('change', '#paymentModeId', applyPaymentMode);

            // A product already on the sale is added to, not written again.
            //
            // Picking the same step board on a fourth row made four lines of
            // one where the customer is buying four of a thing - and four
            // rows invite somebody voiding "a duplicate" to take off a
            // quantity that was really sold. The quantity goes onto the line
            // that is already there and the row just filled in goes away.
            //
            // Returns whether it merged, so the handlers that follow can be
            // skipped: the row they would work on no longer exists.
            function mergeIfAlreadyOnSale($row) {
                var $product = $row.find('.product-select');
                var productId = $product.val();
                if (!productId) { return false; }

                // The shade and the panel are part of what has to match.
                // Two shades of one film, or two panels of it, are different
                // things - merging them would put a quantity against
                // something nobody sold, and on a panel line the quantity is
                // not even the figure that matters.
                var shade = $row.find('.shade-select').val() || '';
                var panel = $row.find('.panel-id').val() || '';
                var klass = classOf($row);

                var $match = null;
                $('#linesTable tbody .line-row').each(function () {
                    if ($match || this === $row[0]) { return; }

                    var $other = $(this);
                    if ($other.find('.product-select').val() === productId
                        && ($other.find('.shade-select').val() || '') === shade
                        && ($other.find('.panel-id').val() || '') === panel
                        && classOf($other) === klass) {
                        $match = $other;
                    }
                });

                if (!$match) { return false; }

                var $qty = $match.find('input[name=quantity]');
                var added = parseFloat($row.find('input[name=quantity]').val()) || 1;
                var now = (parseFloat($qty.val()) || 0) + added;

                $qty.val(now);
                $row.remove();

                var name = ($product.find(':selected').text() || '')
                    .replace(/\s*\([^)]*\)\s*$/, '')
                    .trim();

                $('#duplicateLines')
                    .html(name + ' is already on this sale &mdash; that line now reads ' + now + '.')
                    .show();

                recalcTotal();
                refreshStockState();
                return true;
            }

            $(document).on('change', '.product-select', function (e) {
                if (mergeIfAlreadyOnSale($(this).closest('tr'))) {
                    // The row is gone; nothing after this has one to work on.
                    e.stopImmediatePropagation();
                }
            });

            // Picking a shade can be the thing that makes two rows the same
            // line - the film was already there, waiting to be told which.
            $(document).on('change', '.shade-select', function () {
                mergeIfAlreadyOnSale($(this).closest('tr'));
            });

            $(document).on('change', '.panel-select', function () {
                mergeIfAlreadyOnSale($(this).closest('tr'));
            });

            $(document).on('change', '.product-select', function () {
                evaluateProductRow($(this).closest('tr'));
            });

            $(document).on('change', '.tint-variant-select', function () {
                var $row = $(this).closest('tr');

                // The shades on offer are this variant's, not the film's as a
                // whole - Freeze's shades beside a line that says Play is a
                // line nobody can read.
                fillShades($row);
                refreshPanels($row, $(this).val());
                recalcTotal();
                refreshStockState();
            });

            $(document).on('change', '.panel-select', function () {
                var $row = $(this).closest('tr');
                var price = $(this).find(':selected').data('price');
                if (price !== undefined && price !== '') {
                    $row.find('.unit-price').val(parseFloat(price).toFixed(2));
                }
                syncPanel($row);
                recalcTotal();
                refreshStockState();
                updateSubmit();
            });

            // Saying which class of car re-prices the row: the price list is
            // keyed by it, and so is the cut size.
            $(document).on('change', '.classification-select', function () {
                var $row = $(this).closest('tr');
                $(this).data('touched', true);
                syncPanel($row);
                loadMatrix($(this).val(), function () {
                    evaluateProductRow($row);
                    refreshStockState();
                });
            });

            $(document).on('input', 'input[name=quantity], input[name=unitPrice]', function () {
                updateSubmit();
                recalcTotal();
                refreshStockState();
            });

            $(document).on('change', '.product-select', refreshStockState);
            $(document).on('change', '.product-select', showDuplicates);

            $('#addRow').on('click', function () {
                // Clone from the inert <template>, not the live first row -
                // the live row's Tint Variant and Panel lists have already
                // been narrowed to whatever product it is showing, and a new
                // row should start empty rather than inherit them.
                var frag = document.getElementById('lineRowTemplate').content.cloneNode(true);
                $('#linesTable tbody').append(frag);
                refreshStockState();
                showDuplicates();
            });

            $(document).on('click', '.remove-row', function () {
                $(this).closest('tr').remove();

                // Always leave at least one row so there's somewhere to add
                // a product - but the click itself should never be a no-op.
                if ($('.line-row').length === 0) {
                    var frag = document.getElementById('lineRowTemplate').content.cloneNode(true);
                    $('#linesTable tbody').append(frag);
                }

                recalcTotal();

                // The removed row may have been the one outrunning stock, so
                // the warning and the button are worked out again rather than
                // left on the last answer.
                refreshStockState();
                showDuplicates();
            });

            // Settle the total, the change and the button before anything is
            // touched - an empty cart cannot be completed, and neither can a
            // line with no price.
            recalcTotal();
            applyPaymentMode();
            refreshStockState();

            // ---- adding a walk-in without leaving the sale ----------------
            //
            // Posted with fetch rather than by submitting, because this sits
            // inside the sale's own form and a form cannot hold another: the
            // button would submit the sale instead.
            var $panel = $('#newCustomerPanel');
            var $error = $('#newCustomerError');

            function showError(message) {
                $error.text(message).toggle(!!message);
            }

            $('#newCustomerToggle').on('click', function () {
                var opening = $panel.is(':hidden');
                $panel.toggle(opening);
                showError('');
                if (opening) { $('#newCustomerLast').trigger('focus'); }
            });

            $('#newCustomerCancel').on('click', function () {
                $panel.hide();
                showError('');
            });

            // The number is stored as +63 and ten digits, so the box beside
            // the +63 holds the ten: whatever is pasted is reduced to them.
            $('#newCustomerNumber').on('input paste', function () {
                var field = this;
                setTimeout(function () {
                    var digits = field.value.replace(/\D/g, '');
                    if (digits.length === 12 && digits.indexOf('63') === 0) { digits = digits.slice(2); }
                    else if (digits.length === 11 && digits.charAt(0) === '0') { digits = digits.slice(1); }
                    digits = digits.slice(0, 10);
                    if (digits !== field.value) { field.value = digits; }
                }, 0);
            });

            $('#newCustomerSave').on('click', function () {
                var $button = $(this);
                showError('');
                $button.prop('disabled', true);

                $.ajax({
                    url: '@Url.Action("QuickCustomer")',
                    type: 'POST',
                    data: {
                        lastName: $('#newCustomerLast').val(),
                        firstName: $('#newCustomerFirst').val(),
                        contactNumber: $('#newCustomerNumber').val(),
                        __RequestVerificationToken: $('#saleForm input[name="__RequestVerificationToken"]').val()
                    }
                }).done(function (result) {
                    if (result.error) { showError(result.error); return; }

                    var $customer = $('#customerId');

                    // Only ever a customer that did not exist a moment ago -
                    // one already on file is refused above, not resolved - so
                    // the option is always new. Guarded anyway: appending a
                    // second option for one person would be worse than the
                    // line it saves.
                    if (!$customer.find('option[value="' + result.id + '"]').length) {
                        $customer.append($('<option></option>').val(result.id).text(result.name));
                    }

                    // Selected with change(), so the vehicle list reloads for
                    // them exactly as it would had they been picked by hand.
                    $customer.val(String(result.id)).trigger('change');

                    $panel.hide();
                    $('#newCustomerLast').val('');
                    $('#newCustomerFirst').val('');
                    $('#newCustomerNumber').val('');
                }).fail(function () {
                    showError('The customer could not be added. Check the connection and try again.');
                }).always(function () {
                    $button.prop('disabled', false);
                });
            });
        });
    </script>
}

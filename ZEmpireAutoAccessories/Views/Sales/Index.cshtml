@model IEnumerable<ZEmpireAutoAccessories.Models.Sale>

@{
    ViewData["Title"] = "Sales";
    var search = ViewData["Search"] as string;
    var dateFrom = ViewData["DateFrom"] as DateOnly?;
    var dateTo = ViewData["DateTo"] as DateOnly?;
    var unitsSold = ViewData["UnitsSold"] as int?;
}

<style>
    .search-actions { display:flex; gap:8px; margin-top:8px; margin-bottom:18px; }
    .filter-row { display:flex; flex-wrap:wrap; gap:10px; align-items:flex-end; margin-bottom:10px; }
    .filter-row .field { display:flex; flex-direction:column; gap:4px; }
    .filter-row label { font-size:12px; font-weight:600; color:#7b8290; text-transform:uppercase; letter-spacing:.3px; }
    .units-sold-card { background:#fff; border:1px solid #e8ebf0; border-radius:14px; padding:16px 20px; margin-bottom:14px;
                        display:flex; align-items:center; gap:12px; }
    .units-sold-card .figure { font-family:'Oswald',system-ui,sans-serif; font-weight:700; font-size:26px; color:var(--zx-red); }
</style>

<div class="zx-page-head">
    <h1>Sales</h1>
    <a class="btn btn-zx" asp-action="Create">+ New Sale</a>
</div>

<form asp-action="Index" method="get">
    <div class="search-wrap">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
        <input type="text" name="q" value="@search" class="form-control search-input" placeholder="Search invoice number or customer" />
    </div>
    <div class="filter-row">
        <div class="field">
            <label>Product</label>
            <select name="productId" class="form-select" asp-items="ViewBag.ProductID" style="min-width:220px;">
                <option value="">-- Any Product --</option>
            </select>
        </div>
        <div class="field">
            <label>From</label>
            <input type="date" name="dateFrom" value="@(dateFrom?.ToString("yyyy-MM-dd"))" class="form-control" />
        </div>
        <div class="field">
            <label>To</label>
            <input type="date" name="dateTo" value="@(dateTo?.ToString("yyyy-MM-dd"))" class="form-control" />
        </div>
    </div>
    <div class="search-actions">
        <button type="submit" class="btn btn-outline-secondary btn-sm">Filter</button>
        @if (Context.Request.Query.Count > 0)
        {
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Clear</a>
        }
    </div>
</form>

@if (unitsSold.HasValue)
{
    <div class="units-sold-card">
        <div>
            <div class="text-muted small text-uppercase">Units Sold</div>
            <div class="figure">@unitsSold.Value.ToString("N0")</div>
        </div>
        <div class="text-muted small">for the selected product@(dateFrom.HasValue || dateTo.HasValue ? " and date range" : "")</div>
    </div>
}

<div class="zx-card">
    <div class="table-responsive">
    <table class="table zx-table mb-0">
        <thead>
            <tr>
                <th>Invoice #</th>
                <th>Customer</th>
                <th>Payment Mode</th>
                <th>Date</th>
                <th>Total</th>
                <th class="text-end pe-3">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.InvoiceNumber</td>
                    <td>@item.Customer.FullName</td>
                    <td>@item.PaymentMode.PaymentModeName</td>
                    <td>@item.SalesDate.ToString("MMM d, yyyy")</td>
                    <td>@("₱" + item.TotalAmount.ToString("N2"))</td>
                    <td class="text-end pe-3">
                        <a asp-action="Pdf" asp-route-id="@item.SalesID" class="icon-btn" title="Reprint sales invoice" target="_blank">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><path d="M6 9V4a1 1 0 0 1 1-1h10a1 1 0 0 1 1 1v5"/><rect width="12" height="8" x="6" y="14" rx="1"/></svg>
                        </a>
                        <a asp-action="Details" asp-route-id="@item.SalesID" class="icon-btn" title="View details">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2.062 12.348a1 1 0 0 1 0-.696 10.75 10.75 0 0 1 19.876 0 1 1 0 0 1 0 .696 10.75 10.75 0 0 1-19.876 0"/><circle cx="12" cy="12" r="3"/></svg>
                        </a>
                        <a asp-action="Delete" asp-route-id="@item.SalesID" class="icon-btn danger" title="Delete">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"/><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                        </a>
                    </td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="6" class="text-center text-muted py-4">No sales yet.</td>
                </tr>
            }
        </tbody>
    </table>
    </div>
</div>

@model IEnumerable<ZEmpireAutoAccessories.Models.InventoryRow>

@{
    ViewData["Title"] = "Inventory";
    const decimal lowStockThreshold = 5;
    var currentStatus = ViewData["Status"] as string;
    var search = ViewData["Search"] as string;

    var countAll = ViewData["CountAll"] as int? ?? 0;
    var countIn = ViewData["CountIn"] as int? ?? 0;
    var countLow = ViewData["CountLow"] as int? ?? 0;
    var countOut = ViewData["CountOut"] as int? ?? 0;

    @* A row here is a product, but this module only ever shows what is left
       of it. The way to its details and to what it is charged at is the
       Products and Pricing modules, so link out rather than restate them -
       a tint has no single price to restate anyway, it has one per variant,
       vehicle class and panel. Offered only to someone who holds the module
       the link lands in. *@
    var canSeeProduct = User.HasClaim(AppClaims.ModuleAccess, "Products");
    var canSeePrices = User.HasClaim(AppClaims.ModuleAccess, "Pricing");

    var success = TempData["Success"] as string;
    var inventoryError = TempData["InventoryError"] as string;

}

<style>

    .status-filters {
        display: flex;
        gap: 8px;
        margin-bottom: 18px;
        flex-wrap: wrap;
    }

        .status-filters a {
            padding: 7px 16px;
            border-radius: 999px;
            font-size: 13.5px;
            font-weight: 600;
            color: #4b5563;
            background: #fff;
            border: 1px solid #e8ebf0;
            text-decoration: none;
        }

            .status-filters a.active, .status-filters a:hover {
                background: #0b0b0c;
                color: #fff;
                border-color: #0b0b0c;
            }

    .badge-in {
        background: rgba(34,197,94,.15);
        color: #15803d;
        font-weight: 600;
    }

    .badge-low {
        background: rgba(245,158,11,.15);
        color: #b45309;
        font-weight: 600;
    }

    .badge-out {
        background: rgba(239,68,68,.15);
        color: #b91c1c;
        font-weight: 600;
    }
</style>

<style>
    .btn-zx { background:var(--zx-red); border-color:var(--zx-red); color:#fff; font-weight:600; }
    .btn-zx:hover { background:var(--zx-red2); border-color:var(--zx-red2); color:#fff; }

    .zx-page-sub { color:#7b8290; font-size:13.5px; margin:-8px 0 18px; }

    .search-bar { display:flex; align-items:center; gap:8px; margin-bottom:16px; flex-wrap:wrap; }
    .search-wrap { position:relative; flex:1 1 320px; max-width:420px; }
    .search-wrap svg { position:absolute; left:13px; top:50%; transform:translateY(-50%); color:#98a0ad; }
    .search-input { padding-left:38px; border-radius:10px; }


    /* Count beside each filter, so "4 low" is visible without clicking in. */
    .status-filters .tab-count {
        display:inline-block; margin-left:7px; padding:1px 7px; border-radius:999px;
        font-size:11.5px; background:rgba(0,0,0,.07);
    }
    .status-filters a.active .tab-count { background:rgba(255,255,255,.22); }

    /* Move stock straight from the row rather than opening the product. */
    .move-form { display:flex; gap:6px; justify-content:flex-end; align-items:center; }

    .move-qty { min-width:0; }
    .move-unit { width:62px; flex:0 0 auto; }

    /* A fixed width on the amount and its unit, because a .form-control
       inside an .input-group takes flex:1 1 auto and grows to whatever the
       cell gives it - which is how a box for "5" ended up as wide as the
       product name beside it.

       Only where there is width to spare. On a phone the row is laid out
       again further down this file, with the amount on its own line, and a
       width pinned here would fight it. */
    @@media (min-width: 576px) {
        .move-input { flex:0 0 auto; width:86px; }
        .move-input.has-unit { width:148px; }
    }

    /* The two that change stock, then the three that only look at it. */
    .move-links { display:flex; gap:2px; align-items:center; padding-left:8px;
                  margin-left:4px; border-left:1px solid #e8ebf0; }

    /* Category bands, so the list reads as shelves rather than one long run. */
    .cat-row td {
        background: #f7f8fa;
        font-weight: 700;
        font-size: 11.5px;
        text-transform: uppercase;
        letter-spacing: .5px;
        color: #6b7280;
        padding-top: 9px;
        padding-bottom: 9px;
    }

    .cat-measure {
        float: right;
        font-weight: 600;
        text-transform: none;
        letter-spacing: 0;
        color: #98a0ad;
        font-size: 11.5px;
    }

    /* The figure and its unit are separate so the numbers line up in a
       column and the unit stays quiet beside them - a column mixing
       "4.32 m" with "100" is unreadable when both are the same weight. */
    /* Widths on everything except the name, so the figures and the controls
       sit together on the right and the name takes whatever is left. Without
       them the browser shares the table out evenly and leaves a hand's width
       of nothing between the status and the buttons.

       Only where there is width to share: on a phone these same figures turn
       the row into a sideways scroll with the buttons off the end of it,
       which is what the rules at the bottom of this file exist to prevent. */
    @@media (min-width: 576px) {
        .onhand-col { width: 120px; }
        .status-col { width: 130px; }
        .move-col { width: 330px; }
    }

    .onhand-col { text-align: right; white-space: nowrap; padding-right: 18px !important; }
    .onhand-value { font-variant-numeric: tabular-nums; font-weight: 600; font-size: 15px; color: #0b0b0c; }
    .onhand-value.is-zero { color: #b91c1c; }
    .onhand-unit { color: #98a0ad; font-size: 12px; margin-left: 3px; display: inline-block; min-width: 24px; text-align: left; }
    .move-form .btn { padding:4px 10px; font-weight:600; min-width:46px; }

    .list-meta { display:flex; justify-content:space-between; align-items:baseline; gap:12px;
                 flex-wrap:wrap; font-size:12.5px; color:#7b8290; margin:0 2px 8px; }
    .list-hint kbd { background:#eef0f4; border:1px solid #dfe3ea; border-bottom-width:2px;
                     border-radius:5px; padding:0 5px; font-size:11px; color:#4b5563; }

    /* The row a movement was just made on: find it again without reading. */
    @@keyframes just-moved {
        from { background:#e8f6ed; }
        to { background:transparent; }
    }
    .stock-row.just-moved td { animation: just-moved 2.2s ease-out; }

    /* A row is a thing to act on, so it answers the pointer. */
    .zx-table tbody tr:not(.cat-row):hover { background:#fbfcfd; }

    /* Seventy-four products is a scroll, and a scroll with the headings
       gone is four columns of unlabelled figures. */
    /* The background has to go on the cell, not the row: a sticky th with
       nothing behind it has the list scrolling through the headings. */
    .zx-table thead th { position:sticky; top:0; z-index:2; background:#0b0b0c; }

    /* On a phone the four columns plus a quantity box and two buttons are
       wider than the screen, which pushes the buttons out of reach inside the
       table's own sideways scroll. Tighten the row so the whole thing fits
       without scrolling. */
    @@media (max-width: 575.98px) {
        .zx-table td, .zx-table th { padding-left:.4rem; padding-right:.4rem; font-size:12.5px; }
        .move-form { gap:4px; }
        .move-qty { width:54px; }
        .move-form .btn { padding:3px 7px; font-size:12px; }
        .move-form .icon-btn { display:none; }
        /* And the rule they were separated from, which would otherwise be a
           stray border taking a row's width for nothing. */
        .move-links { display:none; }

        /* The stock figure and the filter tabs already say whether a product
           is low or out, so the badge column earns its space back for the
           In/Out buttons. */
        .status-col { display:none; }
        .cat-row td { font-size:10.5px; }
        .cat-measure { display:none; }
        /* The figure needs room for "366.32 m" and no more; what it gives
           up goes to the amount box, which was down to the width of two
           digits with the unit picker beside it. */
        .onhand-col { padding-right:6px !important; width:74px; }
        .move-col { width:140px; }
        .onhand-value { font-size:13px; }
        /* Qty and its unit on one line, In/Out beneath: with a unit picker
           in the row there is not enough width for all four side by side,
           and pushing the buttons into the table's sideways scroll puts
           them out of reach. */
        .move-form { flex-wrap:wrap; justify-content:flex-end; row-gap:6px; }
        /* The amount takes the whole line, so In and Out stay together
           underneath rather than one of them dangling on a line of its own. */
        .move-input { flex:1 0 100%; }
        .move-qty { width:auto; flex:1 1 auto; }
        .move-unit { width:52px; padding-left:5px; padding-right:14px; }

        /* In and Out share the line under the amount. Left to size
           themselves they each took a line of their own, which made a row
           three deep for two buttons. */
        .move-form .btn { padding:3px 8px; flex:1 1 0; min-width:0; }
    }
</style>

<div class="zx-page-head">
    <h1>Inventory</h1>
    <div>
        @* Cut sizes decide what a tint or film job takes off a roll, so the
           screen that shows those rolls is where someone goes looking. *@
        <a class="btn btn-outline-secondary" asp-controller="CutSize" asp-action="Index" zx-return>Cut sizes</a>
        @* This list is per product, because the ledger is. Shade Stock is the
           breakdown behind it, worked out from the last count. *@
        <a class="btn btn-outline-secondary" asp-action="Shades">Shade stock</a>
        <a class="btn btn-outline-secondary" asp-controller="InventoryCheck" asp-action="Index" zx-return>Stock counts</a>
        <a class="btn btn-zx" asp-controller="InventoryCheck" asp-action="Create" zx-return>+ New stock count</a>
    </div>
</div>
<p class="zx-page-sub">
    Stock in or out straight from a row when you know the movement. Use a stock count when you want to
    check the whole shelf against the system and correct whatever is off.
</p>

@if (!string.IsNullOrEmpty(success))
{
    <div class="alert alert-success py-2 px-3">@success</div>
}
@if (!string.IsNullOrEmpty(inventoryError))
{
    <div class="alert alert-danger py-2 px-3">@inventoryError</div>
}

@* The box and its buttons on one line. They were stacked, which put a
   lone "Search" button under a lone box and spent two rows of the screen
   saying what one says. *@
<form asp-action="Index" method="get" class="search-bar">
    @* Keep the tab you are on while searching within it. *@
    <input type="hidden" name="status" value="@currentStatus" />
    <div class="search-wrap">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8" /><path d="m21 21-4.3-4.3" /></svg>
        @* Focused on arrival, and filtering as it is typed. Nobody opens
           this screen to admire it: they open it to find one product out of
           seventy-four. The form still posts for anyone without JavaScript,
           and the address bar still carries the search. *@
        <input type="text" id="inventorySearch" name="q" value="@search" autofocus
               class="form-control search-input" placeholder="Search product   /" autocomplete="off" data-live-noun="products" />
    </div>
    <button type="submit" class="btn btn-outline-secondary">Search</button>
    @if (!string.IsNullOrEmpty(search))
    {
        <a asp-action="Index" asp-route-status="@currentStatus" class="btn btn-outline-secondary">Clear</a>
    }
</form>

<div class="status-filters">
    <a asp-action="Index" asp-route-q="@search" class="@(string.IsNullOrEmpty(currentStatus) ? "active" : "")">All <span class="tab-count">@countAll</span></a>
    <a asp-action="Index" asp-route-status="InStock" asp-route-q="@search" class="@(currentStatus == "InStock" ? "active" : "")">In Stock <span class="tab-count">@countIn</span></a>
    <a asp-action="Index" asp-route-status="LowStock" asp-route-q="@search" class="@(currentStatus == "LowStock" ? "active" : "")">Low Stock <span class="tab-count">@countLow</span></a>
    <a asp-action="Index" asp-route-status="OutOfStock" asp-route-q="@search" class="@(currentStatus == "OutOfStock" ? "active" : "")">Out of Stock <span class="tab-count">@countOut</span></a>
</div>

<p class="list-meta" id="listMeta">
    <span id="listCount"></span>
    <span class="list-hint">Type an amount in a row and press <kbd>Enter</kbd> to stock in.</span>
</p>

<div class="zx-card">
    <div class="table-responsive">
    <table class="table zx-table mb-0">
        <thead>
            @* Widths on everything except the name, so the figures and the
               controls sit together on the right and the name takes whatever
               is left. Without them the browser shared the table out evenly
               and left a hand's width of nothing between the status and the
               buttons. *@
            <tr>
                <th>Product</th>
                <th class="onhand-col">On Hand</th>
                <th class="status-col">Status</th>
                <th class="move-col text-end pe-3">Move Stock</th>
            </tr>
        </thead>
        <tbody id="linesBody">
            @{ string? currentCategory = null; }
            @foreach (var item in Model)
            {
                var stock = item.StockOnHand;
                var roll = item.SoldByLength;
                var figure = ZEmpireAutoAccessories.Models.UnitOfMeasure.Split(stock, roll);

                @* Grouped by category so the shelves read in the order they
                   are walked, rather than 14 unrelated products in one run. *@
                @if (item.CategoryName != currentCategory)
                {
                    currentCategory = item.CategoryName;
                    <tr class="cat-row" data-cat="@currentCategory">
                        <td colspan="4">
                            @currentCategory
                            <span class="cat-measure">@(roll ? "measured by length" : "counted in pieces")</span>
                        </td>
                    </tr>
                }
                <tr class="stock-row" data-name="@item.ProductName.ToLowerInvariant()"
                    data-cat="@item.CategoryName" data-product="@item.ProductID">
                    <td>@item.ProductName</td>
                    <td class="onhand-col">
                        <span class="onhand-value @(stock <= 0 ? "is-zero" : "")">@figure.Value</span>
                        <span class="onhand-unit">@figure.Unit</span>
                    </td>
                    <td class="status-col">
                        @if (stock <= 0)
                        {
                            <span class="badge badge-out">Out of Stock</span>
                        }
                        else if (stock <= lowStockThreshold)
                        {
                            <span class="badge badge-low">Low Stock</span>
                        }
                        else
                        {
                            <span class="badge badge-in">In Stock</span>
                        }
                    </td>
                    <td class="text-end pe-3">
                        @* One form, two submit buttons: the Out button posts to
                           the other action through formaction, so a row needs
                           only a single quantity box. *@
                        <form asp-action="StockIn" method="post" class="move-form">
                            <input type="hidden" name="productId" value="@item.ProductID" />
                            <input type="hidden" name="returnTo" value="index" />
                            <input type="hidden" name="status" value="@currentStatus" />
                            <input type="hidden" name="q" value="@search" />
                            @* Amount and unit are one control, so on a narrow
                               screen they wrap as a pair and leave In/Out
                               together on the line below. *@
                            <div class="input-group input-group-sm move-input @(roll ? "has-unit" : "")">
                                <input type="number" name="quantity" step="0.01" min="0.01"
                                       class="form-control move-qty" placeholder="Qty"
                                       aria-label="Amount to move for @item.ProductName" />
                                @if (roll)
                                {
                                    <select name="unit" class="form-select move-unit"
                                            data-searchable="false" title="Unit">
                                        @foreach (var u in ZEmpireAutoAccessories.Models.UnitOfMeasure.LengthUnits)
                                        {
                                            <option value="@u">@u</option>
                                        }
                                    </select>
                                }
                            </div>
                            <button type="submit" class="btn btn-sm btn-outline-success" title="Stock in">In</button>
                            @* Stocking out of an empty shelf can only be
                               refused, so don't offer the click. *@
                            <button type="submit" class="btn btn-sm btn-outline-danger"
                                    formaction="@Url.Action("StockOut")"
                                    disabled="@(stock <= 0)"
                                    title="@(stock <= 0 ? "Nothing in stock to take out" : "Stock out")">Out</button>
                            <span class="move-links">
                            <a asp-action="Details" asp-route-id="@item.ProductID" class="icon-btn" title="Stock history">
                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="5" x="2" y="3" rx="1" /><path d="M4 8v11a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1V8" /><path d="M10 12h4" /></svg>
                            </a>
                            @if (canSeeProduct)
                            {
                                <a asp-controller="Product" asp-action="Details" asp-route-id="@item.ProductID"
                                   class="icon-btn" title="Product details" zx-return>
                                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2.062 12.348a1 1 0 0 1 0-.696 10.75 10.75 0 0 1 19.876 0 1 1 0 0 1 0 .696 10.75 10.75 0 0 1-19.876 0" /><circle cx="12" cy="12" r="3" /></svg>
                                </a>
                            }
                            @if (canSeePrices)
                            {
                                @* Pricing's list filters on the same term the search box takes,
                                   and a product name matches it, so this lands on that product's
                                   rows - every variant, class and panel it is priced for. *@
                                <a asp-controller="Pricing" asp-action="Index" asp-route-q="@item.ProductName"
                                   class="icon-btn" title="Prices for this product" zx-return>
                                    @* Peso, not dollar - the shop prices in PHP. *@
                                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 4v16" /><path d="M8 4h5.5a4 4 0 0 1 0 8H8" /><path d="M4.5 8h13" /><path d="M4.5 12h13" /></svg>
                                </a>
                            }
                            </span>
                        </form>
                    </td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="4" class="text-center text-muted py-4">
                        @(string.IsNullOrEmpty(search) ? "No products yet." : $"No product matches \"{search}\".")
                    </td>
                </tr>
            }
            @* The same thing said when the filter in the page empties the
               list, which the server never hears about. *@
            <tr id="noMatch" hidden>
                <td colspan="4" class="text-center text-muted py-4">No product matches what you typed.</td>
            </tr>
        </tbody>
    </table>
    </div>
</div>

@section Scripts {
    <script>
        // Filtering, "/" and Escape are in wwwroot/js/live-filter.js, which
        // every list screen gets. This is the part only this one needs.
        (function () {
            // Back from a movement: put the cursor where it was and say which
            // row changed. Taking in a delivery is ten movements one after
            // another, and the reload used to forget where you were - which
            // left the next one to be hunted down the page.
            var focusId = @(ViewData["Focus"] is int f ? f : 0);
            if (!focusId) { return; }

            var row = document.querySelector('.stock-row[data-product="' + focusId + '"]');
            if (!row) { return; }

            row.classList.add('just-moved');
            row.scrollIntoView({ block: 'center' });

            var box = row.querySelector('.move-qty');
            if (box) { box.focus(); }
        })();
    </script>
}

@model List<ZEmpireAutoAccessories.Models.ShadeStockProduct>
@using ZEmpireAutoAccessories.Models

@{
    ViewData["Title"] = "Shade Stock";

    string Cm(decimal value) => UnitOfMeasure.Describe(value, true);
}

<style>
    .zx-page-head { display:flex; align-items:center; justify-content:space-between; gap:12px; flex-wrap:wrap; margin-bottom:4px; }
    .zx-page-head h1 { font-family:'Oswald',system-ui,sans-serif; font-weight:700; font-size:22px; margin:0; color:#0b0b0c; }
    .zx-page-sub { color:#7b8290; font-size:13.5px; margin:0 0 18px; max-width:70ch; }
    .btn-zx { background:var(--zx-red); border-color:var(--zx-red); color:#fff; font-weight:600; }
    .btn-zx:hover { background:var(--zx-red2); border-color:var(--zx-red2); color:#fff; }

    .prod-card { background:#fff; border:1px solid #e8ebf0; border-radius:14px; overflow:hidden; margin-bottom:16px; }
    .prod-head { display:flex; align-items:baseline; justify-content:space-between; gap:12px; flex-wrap:wrap;
                 padding:14px 18px; border-bottom:1px solid #eef0f4; background:#fafbfc; }
    .prod-name { font-weight:700; font-size:15px; color:#0b0b0c; }
    .prod-cat { font-size:12px; text-transform:uppercase; letter-spacing:.4px; color:#9aa1ad; }
    .prod-total { font-variant-numeric:tabular-nums; font-size:13px; color:#4b5563; }
    .prod-total strong { color:#0b0b0c; }

    .shade-table { width:100%; margin:0; }
    .shade-table th { font-size:11.5px; text-transform:uppercase; letter-spacing:.3px; color:#9aa1ad;
                      font-weight:600; padding:9px 18px; border-bottom:1px solid #eef0f4; }
    .shade-table td { padding:10px 18px; border-bottom:1px solid #f4f6f8; vertical-align:middle; font-size:13.5px; }
    .shade-table tr:last-child td { border-bottom:none; }
    .num { text-align:right; font-variant-numeric:tabular-nums; }
    .left-figure { font-weight:700; }
    .left-figure.low { color:#b45309; }
    .left-figure.out { color:#b91c1c; }
    .muted { color:#9aa1ad; }

    .note { padding:11px 18px; font-size:12.5px; border-top:1px solid #eef0f4; background:#fcfcfd; color:#7b8290; }
    .note.warn { background:#fffbeb; color:#92400e; }
    .note strong { font-weight:600; }
</style>

<div class="zx-page-head">
    <h1>Shade Stock</h1>
    <div>
        <a class="btn btn-outline-secondary" asp-action="Index">All stock</a>
        <a class="btn btn-zx" asp-controller="InventoryCheck" asp-action="Create">New stock count</a>
    </div>
</div>
<p class="zx-page-sub">
    What should be left of each shade, from the last stock count that recorded it
    less what has been fitted since. Stock itself is kept per product, so these are
    worked out rather than counted &mdash; good enough to see what is running low,
    and only ever as accurate as the last count.
</p>

@if (!Model.Any())
{
    <div class="prod-card">
        <div class="note">
            No film has shades on file yet, so there is nothing to break down.
            Shades are added to a tint variant in the catalogue.
        </div>
    </div>
}

@foreach (var product in Model)
{
    <div class="prod-card">
        <div class="prod-head">
            <div>
                <div class="prod-cat">@product.CategoryName</div>
                <div class="prod-name">@product.ProductName</div>
            </div>
            <div class="prod-total">
                Stock on hand, all shades: <strong>@Cm(product.SystemStock)</strong>
                @if (product.HasBaseline)
                {
                    <span class="muted"> &middot; counted @product.CountedOn!.Value.ToString("MMM d, yyyy")</span>
                }
            </div>
        </div>

        @if (!product.HasBaseline)
        {
            <div class="note warn">
                No stock count has recorded a shade for this film, so there is nothing to
                work forward from. Take a count and each shade will be tracked from there.
            </div>
        }
        else
        {
            <table class="shade-table">
                <thead>
                    <tr>
                        <th style="text-align:left">Shade</th>
                        <th class="num">Counted</th>
                        <th class="num">Used since</th>
                        <th class="num">Should be left</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var shade in product.Shades)
                    {
                        <tr>
                            <td>@shade.Label</td>
                            <td class="num">
                                @if (shade.Counted == null)
                                {
                                    <span class="muted">not counted</span>
                                }
                                else
                                {
                                    @Cm(shade.Counted.Value)
                                }
                            </td>
                            <td class="num">@(shade.Used == 0 ? "—" : Cm(shade.Used))</td>
                            <td class="num">
                                @if (shade.Left == null)
                                {
                                    <span class="muted">—</span>
                                }
                                else
                                {
                                    @* Under a metre is worth flagging: that is less
                                       than a single windshield on any class of car. *@
                                    <span class="left-figure @(shade.Left <= 0 ? "out" : shade.Left < 100 ? "low" : null)">
                                        @Cm(shade.Left.Value)
                                    </span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            @if (!product.Reconciles)
            {
                <div class="note">
                    @* The shade figures cannot be expected to add up to the ledger
                       once either of these has happened, so say which rather than
                       showing a gap and leaving it to be puzzled over. *@
                    These add up to @Cm(product.AccountedFor ?? 0) against @Cm(product.SystemStock) on the ledger.
                    @if (product.UnattributedUsed > 0)
                    {
                        <text><strong>@Cm(product.UnattributedUsed)</strong> went out on lines with no shade recorded, so it could not be taken off any one shade. </text>
                    }
                    @if (product.ReceivedSince > 0)
                    {
                        <text><strong>@Cm(product.ReceivedSince)</strong> came in since the count, and a delivery is recorded against the film rather than a shade. </text>
                    }
                    The next count will bring them back together.
                </div>
            }
        }
    </div>
}

@using ZEmpireAutoAccessories.Models
@model VehicleChecklist

@{
    ViewData["Title"] = "Vehicle Checklist";

    var rows = ViewData["Rows"] as List<WalkaroundRow> ?? new List<WalkaroundRow>();
    var f = ViewData["Findings"] as ChecklistFindings ?? ChecklistFindings.For(Model.Details, rows.Count);

    var successMessage = TempData["Success"] as string;
    var saveError = TempData["SaveError"] as string;
}

<style>
    .finding-strip { display:flex; flex-wrap:wrap; gap:26px; }
    .finding { min-width:86px; }
    .finding-num { font-size:22px; font-weight:700; color:#0b0b0c; line-height:1.1; font-variant-numeric:tabular-nums; }
    .finding-num.bad { color:#b91c1c; }
    .finding-num.good { color:#15803d; }
    .finding-num.muted { color:#98a0ad; }
    .finding-label { font-size:11.5px; font-weight:600; text-transform:uppercase; letter-spacing:.3px; color:#7b8290; margin-top:2px; }
    .finding-detail { margin-top:16px; padding-top:13px; border-top:1px solid #eef1f5; font-size:13.5px; color:#5d6472; }
</style>

<div class="zx-page-head">
    <h1>Vehicle Checklist</h1>
    <div>
        <a class="btn btn-pdf" asp-action="Pdf" asp-route-id="@Model.ChecklistID" target="_blank">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8Z" /><path d="M14 2v6h6" /></svg>
            Customer's copy
        </a>
        <a class="btn btn-outline-secondary" asp-action="Index">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m12 19-7-7 7-7" /><path d="M19 12H5" /></svg>
            Back to list
        </a>
    </div>
</div>
<p class="zx-page-sub">
    @Model.JobOrder.JobOrderNumber &middot; @Model.JobOrder.Customer.FullName &middot;
    @(string.IsNullOrWhiteSpace(Model.JobOrder.Vehicle.PlateNumber) ? "No plate" : Model.JobOrder.Vehicle.PlateNumber)
</p>

@if (!string.IsNullOrEmpty(successMessage))
{
    <div class="alert alert-success">@successMessage</div>
}
@if (!string.IsNullOrEmpty(saveError))
{
    <div class="alert alert-danger">@saveError</div>
}

<div class="zx-card padded">
    <div class="finding-strip">
        <div class="finding">
            <div class="finding-num @(f.Issues > 0 ? "bad" : f.Started ? "good" : "muted")">@f.Issues</div>
            <div class="finding-label">Issues found</div>
        </div>
        <div class="finding">
            <div class="finding-num @(f.Complete ? "good" : "muted")">@f.Recorded<span style="font-size:14px;color:#98a0ad;font-weight:600;"> / @f.Offered</span></div>
            <div class="finding-label">Panels walked</div>
        </div>
        <div class="finding">
            <div class="finding-num muted">@f.NotApplicable</div>
            <div class="finding-label">Not on this car</div>
        </div>
    </div>

    @if (f.IssueConditions.Count > 0)
    {
        <div class="finding-detail">Found on arrival: @string.Join(", ", f.IssueConditions)</div>
    }
    else if (f.Started && f.Issues == 0)
    {
        <div class="finding-detail">Nothing was found wrong with this car on arrival.</div>
    }
    else if (!f.Started)
    {
        <div class="finding-detail">Nobody has walked this car yet. Record the panels below.</div>
    }
</div>

<div class="zx-card padded">
    <dl class="row mb-0 zx-dl tight">
        <dt class="col-sm-3">Job Order</dt>
        <dd class="col-sm-9">
            <a asp-controller="JobOrder" asp-action="Details" asp-route-id="@Model.JobOrderID">@Model.JobOrder.JobOrderNumber</a>
            @if (Model.JobOrder.JobType != null)
            {
                <span class="text-muted"> &middot; @Model.JobOrder.JobType.JobTypeName</span>
            }
        </dd>

        <dt class="col-sm-3">Customer</dt>
        <dd class="col-sm-9">@Model.JobOrder.Customer.FullName</dd>

        <dt class="col-sm-3">Vehicle</dt>
        <dd class="col-sm-9">
            @(string.IsNullOrWhiteSpace(Model.JobOrder.Vehicle.PlateNumber) ? "No plate" : Model.JobOrder.Vehicle.PlateNumber)
            &mdash; @Model.JobOrder.Vehicle.Brand @Model.JobOrder.Vehicle.Model
        </dd>

        <dt class="col-sm-3">Inspected</dt>
        <dd class="col-sm-9">@Model.ChecklistDate.ToString("dd MMM yyyy, h:mm tt")</dd>

        <dt class="col-sm-3">Recorded By</dt>
        <dd class="col-sm-9">@(Model.User.FullName ?? Model.User.UserName)</dd>
    </dl>
</div>

@*
    One form over the whole sheet and the two header fields that cannot be
    known at intake. The client signs after seeing the walkaround, so the
    confirmation has to be editable here - before this it could only be set
    on the create form and never again.
*@
<form asp-action="SaveDetails" method="post">
    <input type="hidden" name="id" value="@Model.ChecklistID" />

    <div class="zx-card padded">
        <h6 class="mb-1">Panel conditions</h6>
        <p class="text-muted" style="font-size:13px;">
            Clearing a panel back to <em>not inspected</em> removes what was recorded against it.
        </p>

        <partial name="_Walkaround" model="rows" />
    </div>

    <div class="zx-card padded">
        <div class="row g-3">
            <div class="col-md-7">
                <label for="additionalNotes" class="form-label">Additional notes</label>
                <textarea id="additionalNotes" name="additionalNotes" class="form-control" rows="2" maxlength="400"
                          placeholder="Anything that is not about one panel">@Model.AdditionalNotes</textarea>
            </div>
            <div class="col-md-5">
                <label for="clientSignature" class="form-label">
                    Client confirmation <span class="text-muted fw-normal">(typed name)</span>
                </label>
                <input id="clientSignature" name="clientSignature" class="form-control" maxlength="200"
                       value="@Model.ClientSignature" placeholder="Who agreed to this" />
                <div class="text-muted" style="font-size:12px;margin-top:4px;">
                    Printed on the customer's copy beside the signature line.
                </div>
            </div>
        </div>
    </div>

    <div class="form-actions">
        <button type="submit" class="btn btn-zx">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2Z" /><path d="M17 21v-8H7v8" /><path d="M7 3v5h8" /></svg>
            Save checklist
        </button>
        <a asp-action="Delete" asp-route-id="@Model.ChecklistID" class="btn btn-outline-danger">Delete</a>
    </div>
</form>

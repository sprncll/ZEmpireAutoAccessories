@model IEnumerable<ZEmpireAutoAccessories.Models.VehicleChecklist>

@{
    ViewData["Title"] = "Vehicle Checklists";
}


<div class="zx-page-head">
    <h1>Vehicle Checklists</h1>
    <a class="btn btn-zx" asp-action="Create">+ New Checklist</a>
</div>

<div class="zx-card">
    <div class="table-responsive">
    <table class="table zx-table mb-0">
        <thead>
            <tr>
                <th>Job Order</th>
                <th>Customer</th>
                <th>Vehicle</th>
                <th>Date</th>
                <th>Recorded By</th>
                <th class="text-end pe-3">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.JobOrder.JobOrderNumber</td>
                    <td>@item.JobOrder.Customer.FullName</td>
                    <td>@(item.JobOrder.Vehicle.PlateNumber ?? "—")</td>
                    <td>@item.ChecklistDate.ToString("MMM d, yyyy")</td>
                    <td>@item.User.UserName</td>
                    <td class="text-end pe-3">
                        <a asp-action="Details" asp-route-id="@item.ChecklistID" class="icon-btn" title="View details">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2.062 12.348a1 1 0 0 1 0-.696 10.75 10.75 0 0 1 19.876 0 1 1 0 0 1 0 .696 10.75 10.75 0 0 1-19.876 0" /><circle cx="12" cy="12" r="3" /></svg>
                        </a>
                        <a asp-action="Delete" asp-route-id="@item.ChecklistID" class="icon-btn danger" title="Delete">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18" /><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6" /><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" /></svg>
                        </a>
                    </td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="6" class="text-center text-muted py-4">No checklists yet.</td>
                </tr>
            }
        </tbody>
    </table>
    </div>
</div>
@{
    var signedIn = User.Identity?.IsAuthenticated == true;

    var fullName = User.FindFirst(AppClaims.FullName)?.Value
                   ?? User.Identity?.Name ?? "User";
    var role = User.FindFirst(ClaimTypes.Role)?.Value ?? "";
    var initials = string.Join("", fullName.Split(' ', StringSplitOptions.RemoveEmptyEntries)
                        .Take(2).Select(p => char.ToUpper(p[0])));
    if (string.IsNullOrEmpty(initials)) { initials = "U"; }

    // The menu, already narrowed to what this user may open - see AppNav.
    var navGroups = signedIn ? AppNav.For(User) : Array.Empty<NavGroup>();

    // Which screen this is, so its link can be lit and the top bar can say
    // where you are. Null on the dashboard and on Change Password.
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var onDashboard = string.Equals(controller, "Home", StringComparison.OrdinalIgnoreCase);
    var here = AppNav.Locate(controller);
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · ZEmpire</title>
    <link rel="icon" href="~/images/ZEmpireLogo.png" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Oswald:wght@600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/searchable-select.css" asp-append-version="true" />
    @* Whether the menu was folded to icons last time. Applied before the
       page paints, so it does not open wide and then snap shut on every
       navigation. *@
    <script>
        try {
            if (localStorage.getItem('zx-nav-rail') === '1') {
                document.documentElement.classList.add('zx-rail');
            }
        } catch (e) { }
    </script>
</head>
<body class="@(signedIn ? "zx-app" : null)">
    @if (signedIn)
    {
        <a class="zx-skip" href="#zxMain">Skip to content</a>

        <aside class="zx-side" id="zxSide" aria-label="Main navigation">
            <a class="zx-brand" asp-controller="Home" asp-action="Index">
                <img src="~/images/ZEmpireLogo.png" alt="" />
                <span class="wm">Z<b>-</b>EMPIRE</span>
            </a>

            <div class="zx-side-find">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8" /><path d="m21 21-4.3-4.3" /></svg>
                <input type="search" id="zxNavFind" placeholder="Find a screen" autocomplete="off" aria-label="Find a screen" />
                <kbd>Ctrl K</kbd>
            </div>

            <nav class="zx-side-nav" id="zxNavList">
                <a class="zx-side-link @(onDashboard ? "is-active" : null)" asp-controller="Home" asp-action="Index"
                   title="Dashboard" data-nav-name="dashboard" aria-current="@(onDashboard ? "page" : null)">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">@Html.Raw(AppNav.DashboardIcon)</svg>
                    <span>Dashboard</span>
                </a>

                @foreach (var group in navGroups)
                {
                    <div class="zx-side-group">
                        <div class="zx-side-head">@group.Name</div>
                        @foreach (var item in group.Items)
                        {
                            var active = item.Owns(controller);
                            <a class="zx-side-link @(active ? "is-active" : null)" asp-controller="@item.Controller" asp-action="Index"
                               title="@item.Label" data-nav-name="@item.Label.ToLowerInvariant()" aria-current="@(active ? "page" : null)">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">@Html.Raw(item.Icon)</svg>
                                <span>@item.Label</span>
                            </a>
                        }
                    </div>
                }

                <div class="zx-side-none" id="zxNavNone" hidden>No screen matches.</div>
            </nav>
        </aside>

        <div class="zx-backdrop" id="zxBackdrop"></div>
    }

    <div class="zx-shell">
        @if (signedIn)
        {
            <header class="zx-top">
                <button type="button" class="zx-top-btn" id="zxNavToggle" aria-controls="zxSide" aria-expanded="false" aria-label="Toggle navigation">
                    <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 6h16" /><path d="M4 12h16" /><path d="M4 18h16" /></svg>
                </button>

                <nav class="zx-crumbs" aria-label="You are here">
                    @if (here is { } spot)
                    {
                        <span class="zx-crumb-group">@spot.Group.Name</span>
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6" /></svg>
                        <a asp-controller="@spot.Item.Controller" asp-action="Index">@spot.Item.Label</a>
                    }
                    else
                    {
                        <span class="zx-crumb-here">@(onDashboard ? "Dashboard" : ViewData["Title"])</span>
                    }
                </nav>

                <div class="dropdown ms-auto">
                    <button class="zx-userbtn dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                        <span class="zx-avatar">@initials</span>
                        <span class="text-start d-none d-sm-block">
                            <span class="zx-user-name">@fullName</span>
                            <span class="zx-role">@role</span>
                        </span>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end zx-user-menu">
                        <li><span class="dropdown-item-text small text-muted">Signed in as<br><strong>@User.Identity?.Name</strong></span></li>
                        <li><hr class="dropdown-divider"></li>
                        <li>
                            <a class="dropdown-item" asp-controller="Account" asp-action="ChangePassword">Change Password</a>
                        </li>
                        <li><hr class="dropdown-divider"></li>
                        <li>
                            <form asp-controller="Account" asp-action="Logout" method="post">
                                <button type="submit" class="dropdown-item text-danger">Sign out</button>
                            </form>
                        </li>
                    </ul>
                </div>
            </header>
        }

        <div class="container">
            <main role="main" id="zxMain" class="pb-3">
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/searchable-select.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @* Every list screen has a search box and a table under it; this filters
       the one with the other as the letters are typed. It finds its own work
       and does nothing on a page with no search box. *@
    <script src="~/js/live-filter.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

@model ZEmpireAutoAccessories.Models.Vehicle

@{
    ViewData["Title"] = "New Vehicle";
}

<style>

    .form-label {
        font-weight: 600;
        font-size: 13.5px;
        color: #0b0b0c;
    }
</style>

<div class="zx-page-head">
    <h1>New Vehicle</h1>
    <a href="@BackLink.For(Context.Request, Url.Action("Index"))" class="btn btn-outline-secondary">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m12 19-7-7 7-7" /><path d="M19 12H5" /></svg>
        @BackLink.Label(Context.Request, "Back to list")
    </a>
</div>
<p class="zx-page-sub">Register a vehicle under an existing customer.</p>

@* "Customer added. Now add their vehicle." - set when this form was opened
   straight from saving a new customer, so it says why it is here. *@
@if (TempData["Success"] is string added)
{
    <div class="alert alert-success">@added</div>
}

<div class="zx-card padded narrow">
    <form asp-action="Create" method="post" class="zx-form">
        @* Carried through the save, so a vehicle added from a customer's
           page - or a warranty from an invoice - goes back to the page it
           was started from rather than to a list. *@
        @if (BackLink.Given(Context.Request) is string cameFrom)
        {
            <input type="hidden" name="returnUrl" value="@cameFrom" />
        }
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="CustomerID" class="form-label"></label>
                <select asp-for="CustomerID" class="form-select" asp-items="ViewBag.CustomerID">
                    <option value="">-- Select Customer --</option>
                </select>
                <span asp-validation-for="CustomerID" class="text-danger"></span>
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="VehicleClassificationID" class="form-label"></label>
                <select asp-for="VehicleClassificationID" class="form-select" asp-items="ViewBag.VehicleClassificationID">
                    <option value="">-- Select Classification --</option>
                </select>
                <span asp-validation-for="VehicleClassificationID" class="text-danger"></span>
            </div>
        </div>

        <div class="row">
            <div class="col-md-4 mb-3">
                @* The pattern below must stay in step with the regular expression
                   on the model. The two have already drifted apart once, and the
                   form silently refused what the server would have accepted. *@
                <label asp-for="PlateNumber" class="form-label"></label>
                <input asp-for="PlateNumber" class="form-control" placeholder="e.g. ABC 1234"
                       style="text-transform:uppercase" maxlength="8"
                       required
                       pattern="[A-Za-z]{3}[- ]?\d{3,4}"
                       title="Philippine car plate - three letters then three or four numbers, e.g. ABC 1234 or ABC 123." />
                <span asp-validation-for="PlateNumber" class="text-danger"></span>
                <div class="form-text">Car plate: three letters then three or four numbers (e.g. ABC 1234, or the older ABC 123).</div>
            </div>
            <div class="col-md-4 mb-3">
                <label asp-for="Brand" class="form-label"></label>
                <input asp-for="Brand" class="form-control" placeholder="e.g. Toyota" />
                <span asp-validation-for="Brand" class="text-danger"></span>
            </div>
            <div class="col-md-4 mb-3">
                <label asp-for="Model" class="form-label"></label>
                <input asp-for="Model" class="form-control" placeholder="e.g. Vios" />
                <span asp-validation-for="Model" class="text-danger"></span>
            </div>
        </div>

        <div class="mb-3 col-md-4">
            <label asp-for="ManufacturingYear" class="form-label"></label>
            <input asp-for="ManufacturingYear" class="form-control" />
            <span asp-validation-for="ManufacturingYear" class="text-danger"></span>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn-zx">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2Z" /><path d="M17 21v-8H7v8" /><path d="M7 3v5h8" /></svg>
                Save
            </button>
            <a href="@BackLink.For(Context.Request, Url.Action("Index"))" class="btn btn-outline-secondary">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
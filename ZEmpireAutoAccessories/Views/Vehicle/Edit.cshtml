@model ZEmpireAutoAccessories.Models.Vehicle

@{
    ViewData["Title"] = "Edit Vehicle";
}

<style>
    .zx-page-head h1 {
        font-family: 'Oswald',system-ui,sans-serif;
        font-weight: 700;
        font-size: 22px;
        margin: 0 0 4px;
        color: #0b0b0c;
    }

    .zx-page-sub {
        color: #7b8290;
        font-size: 13.5px;
        margin: 0 0 18px;
    }

    .zx-card {
        background: #fff;
        border: 1px solid #e8ebf0;
        border-radius: 14px;
        padding: 24px;
        max-width: 640px;
    }

    .btn-zx {
        background: var(--zx-red);
        border-color: var(--zx-red);
        color: #fff;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 7px;
    }

        .btn-zx:hover {
            background: var(--zx-red2);
            border-color: var(--zx-red2);
            color: #fff;
        }

    .form-label {
        font-weight: 600;
        font-size: 13.5px;
        color: #0b0b0c;
    }
</style>

<div class="zx-page-head">
    <h1>Edit Vehicle</h1>
</div>
<p class="zx-page-sub">Update @(Model.PlateNumber ?? "this vehicle")'s details.</p>

<div class="zx-card">
    <form asp-action="Edit" method="post" class="zx-form">
        <input type="hidden" asp-for="VehicleID" />
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="CustomerID" class="form-label"></label>
                <select asp-for="CustomerID" class="form-select" asp-items="ViewBag.CustomerID">
                    <option value="">-- Select Customer --</option>
                </select>
                <span asp-validation-for="CustomerID" class="text-danger"></span>
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="VehicleClassificationID" class="form-label"></label>
                <select asp-for="VehicleClassificationID" class="form-select" asp-items="ViewBag.VehicleClassificationID">
                    <option value="">-- Select Classification --</option>
                </select>
                <span asp-validation-for="VehicleClassificationID" class="text-danger"></span>
            </div>
        </div>

        <div class="row">
            <div class="col-md-4 mb-3">
                @* The pattern below must stay in step with the regular expression
                   on the model. When the server rule was widened to admit motorcycle
                   plates this attribute was left behind, so the browser went on
                   refusing "295 XBB" and the widened rule could not be reached
                   through the form at all. *@
                <label asp-for="PlateNumber" class="form-label"></label>
                <input asp-for="PlateNumber" class="form-control" placeholder="e.g. ABC 1234"
                       style="text-transform:uppercase" maxlength="8"
                       pattern="([A-Za-z]{1,3}[- ]?\d{1,4}|\d{1,4}[- ]?[A-Za-z]{1,3})"
                       title="Philippine plate - up to three letters and four numbers, in either order. For example ABC 1234, ABC 123 or 295 XBB." />
                <span asp-validation-for="PlateNumber" class="text-danger"></span>
                <div class="form-text">Up to three letters and four numbers, in either order (e.g. ABC 1234, the older ABC 123, or a motorcycle plate like 295 XBB). Leave blank if unknown.</div>
            </div>
            <div class="col-md-4 mb-3">
                <label asp-for="Brand" class="form-label"></label>
                <input asp-for="Brand" class="form-control" />
                <span asp-validation-for="Brand" class="text-danger"></span>
            </div>
            <div class="col-md-4 mb-3">
                <label asp-for="Model" class="form-label"></label>
                <input asp-for="Model" class="form-control" />
                <span asp-validation-for="Model" class="text-danger"></span>
            </div>
        </div>

        <div class="mb-3 col-md-4">
            <label asp-for="ManufacturingYear" class="form-label"></label>
            <input asp-for="ManufacturingYear" class="form-control" />
            <span asp-validation-for="ManufacturingYear" class="text-danger"></span>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn-zx">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2Z" /><path d="M17 21v-8H7v8" /><path d="M7 3v5h8" /></svg>
                Save Changes
            </button>
            <a asp-action="Details" asp-route-id="@Model.VehicleID" class="btn btn-outline-secondary">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
@model ZEmpireAutoAccessories.Models.Vehicle

@{
    ViewData["Title"] = "Delete Vehicle";
}

<style>

    dt {
        color: #7b8290;
        font-weight: 600;
        font-size: 12.5px;
        text-transform: uppercase;
        letter-spacing: .3px;
    }

    dd {
        margin-bottom: 14px;
        font-size: 15px;
        color: #0b0b0c;
    }

    .alert-danger {
        display: flex;
        align-items: flex-start;
        gap: 10px;
    }

        .alert-danger svg {
            flex: none;
            margin-top: 2px;
        }

    .btn-danger, .btn-outline-secondary {
        display: inline-flex;
        align-items: center;
        gap: 7px;
    }
</style>

<div class="zx-page-head">
    <h1>Delete Vehicle</h1>
</div>

<div class="alert alert-danger">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z" /><path d="M12 9v4" /><path d="M12 17h.01" /></svg>
    <div>Are you sure you want to delete this vehicle? This cannot be undone.</div>
</div>

<div class="zx-card padded narrow danger">
    <dl class="row mb-0">
        <dt class="col-sm-4">@Html.DisplayNameFor(m => m.PlateNumber)</dt>
        <dd class="col-sm-8">@(Model.PlateNumber ?? "—")</dd>

        <dt class="col-sm-4">Vehicle</dt>
        <dd class="col-sm-8">@Model.Brand @Model.Model (@(Model.ManufacturingYear?.ToString() ?? "—"))</dd>

        <dt class="col-sm-4">Classification</dt>
        <dd class="col-sm-8">@Model.VehicleClassification.ClassificationName</dd>

        <dt class="col-sm-4">Owner</dt>
        <dd class="col-sm-8">@Model.Customer.FullName</dd>
    </dl>
</div>

<form asp-action="Delete" method="post" class="mt-3">
    <input type="hidden" asp-for="VehicleID" />
    <button type="submit" class="btn btn-danger">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18" /><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6" /><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" /></svg>
        Delete
    </button>
    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
</form>
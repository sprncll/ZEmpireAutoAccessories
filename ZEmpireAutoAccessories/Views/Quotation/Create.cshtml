@model ZEmpireAutoAccessories.Models.Quotation

@{
    ViewData["Title"] = "New Quotation";
}


<div class="zx-page-head">
    <h1>New Quotation</h1>
</div>
<p class="zx-page-sub">Create the quotation header, then add line items on the next screen.</p>

<div class="zx-card padded narrow">
    <form asp-action="Create" method="post" class="zx-form">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <div class="d-flex justify-content-between align-items-baseline">
                    <label asp-for="CustomerID" class="form-label mb-1"></label>
                    @* Added here rather than in the Customers module: the
                       customer is in front of somebody now, and leaving this
                       page would lose whatever has been typed into the
                       quotation. The same panel the sale screen has. *@
                    <button type="button" id="newCustomerToggle"
                            data-endpoint="@Url.Action("QuickCustomer")"
                            data-customer-select="CustomerID"
                            class="btn btn-link btn-sm p-0 text-decoration-none">+ New customer</button>
                </div>
                <select asp-for="CustomerID" class="form-select" asp-items="ViewBag.CustomerID">
                    <option value="">-- Select Customer --</option>
                </select>
                <span asp-validation-for="CustomerID" class="text-danger"></span>

                <div id="newCustomerPanel" class="border rounded p-2 mt-2" style="display:none;background:#fbfcfd;">
                    <div class="row g-2 mb-2">
                        @* Last name first, the same way the Customers module
                           asks for it, so the two screens do not disagree
                           about what goes where. *@
                        <div class="col-6">
                            <label for="newCustomerLast" class="form-label mb-1" style="font-size:13px;">Last name</label>
                            <input type="text" id="newCustomerLast" class="form-control form-control-sm"
                                   maxlength="80" placeholder="Dela Cruz" autocomplete="family-name" />
                        </div>
                        <div class="col-6">
                            <label for="newCustomerFirst" class="form-label mb-1" style="font-size:13px;">First name</label>
                            <input type="text" id="newCustomerFirst" class="form-control form-control-sm"
                                   maxlength="60" placeholder="Juan" autocomplete="given-name" />
                        </div>
                    </div>
                    <div class="mb-2">
                        <label for="newCustomerNumber" class="form-label mb-1" style="font-size:13px;">Contact number</label>
                        <div class="input-group input-group-sm">
                            <span class="input-group-text">+63</span>
                            @* No maxlength. The browser cuts a value to it as
                               it arrives, so pasting 09121231231 - the same
                               number in the form everybody writes it - was
                               truncated to 0912123123 before the script could
                               take the leading zero off, and a digit went
                               missing in silence. The script trims to ten
                               itself, after it has understood what was
                               pasted. *@
                            <input type="text" id="newCustomerNumber" class="form-control"
                                   inputmode="numeric" placeholder="9121231231" />
                        </div>
                    </div>
                    <div id="newCustomerError" class="text-danger mb-2" style="font-size:12.5px;display:none;"></div>
                    <div class="d-flex gap-2">
                        <button type="button" id="newCustomerSave" class="btn btn-sm btn-zx">Add customer</button>
                        <button type="button" id="newCustomerCancel" class="btn btn-sm btn-outline-secondary">Cancel</button>
                    </div>
                    <div class="text-muted mt-2" style="font-size:12px;">
                        A vehicle can be added later from the Customers module.
                    </div>
                </div>
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="VehicleID" class="form-label"></label>
                <select asp-for="VehicleID" class="form-select" asp-items="ViewBag.VehicleID">
                    <option value="">-- Select Vehicle --</option>
                </select>
                <span asp-validation-for="VehicleID" class="text-danger"></span>
            </div>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="JobTypeID" class="form-label">Job Type</label>
                <select asp-for="JobTypeID" class="form-select" asp-items="ViewBag.JobTypeID">
                    <option value="">-- None --</option>
                </select>
            </div>
            <div class="col-md-6 mb-3">
                <label class="form-label">Valid Until</label>
                <input type="text" class="form-control" value="@DateOnly.FromDateTime(PhTime.Now.AddDays(7)).ToString("MMM d, yyyy")" disabled />
                <div class="form-text">Automatically set to 7 days from today.</div>
            </div>
        </div>

        <div class="mb-3">
            <label asp-for="Remarks" class="form-label"></label>
            <textarea asp-for="Remarks" class="form-control" rows="3"></textarea>
            <span asp-validation-for="Remarks" class="text-danger"></span>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn-zx">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2Z"/><path d="M17 21v-8H7v8"/><path d="M7 3v5h8"/></svg>
                Save &amp; Add Line Items
            </button>
            <a href="@BackLink.For(Context.Request, Url.Action("Index"))" class="btn btn-outline-secondary">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    @* The + New customer panel above. Shared with the sale screen, which
       asks the same question for the same reason. *@
    <script src="~/js/quick-customer.js" asp-append-version="true"></script>
    <script>
        (function () {
            var $customer = $('#CustomerID');
            var $vehicle = $('#VehicleID');

            function loadVehicles(customerId, selectedVehicleId) {
                $vehicle.prop('disabled', true).empty();

                if (!customerId) {
                    $vehicle.append($('<option></option>').val('').text('-- Select Customer First --'));
                    return;
                }

                $.getJSON('@Url.Action("VehiclesForCustomer")', { customerId: customerId })
                    .done(function (data) {
                        $vehicle.empty();
                        if (!data.length) {
                            $vehicle.append($('<option></option>').val('').text('-- No vehicles for this customer --'));
                            return;
                        }
                        $vehicle.append($('<option></option>').val('').text('-- Select Vehicle --'));
                        $.each(data, function (i, v) {
                            var $opt = $('<option></option>').val(v.value).text(v.text);
                            if (selectedVehicleId && String(v.value) === String(selectedVehicleId)) {
                                $opt.prop('selected', true);
                            }
                            $vehicle.append($opt);
                        });
                        $vehicle.prop('disabled', false);

                        // Only one vehicle on file for this customer - skip
                        // making the user pick it themselves.
                        if (!selectedVehicleId && data.length === 1) {
                            $vehicle.val(data[0].value).trigger('change');
                        }
                    });
            }

            $customer.on('change', function () {
                loadVehicles($(this).val(), null);
            });

            var startingCustomerId = $customer.val();
            if (startingCustomerId) {
                loadVehicles(startingCustomerId, '@Model.VehicleID');
            } else {
                $vehicle.prop('disabled', true);
            }
        })();
    </script>
}

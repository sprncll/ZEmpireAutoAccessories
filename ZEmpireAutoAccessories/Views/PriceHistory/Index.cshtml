@model IEnumerable<ZEmpireAutoAccessories.Models.PriceHistory>

@{
    ViewData["Title"] = "Price History";
}

<style>

    .up {
        color: #b91c1c;
        font-weight: 600;
    }

    .down {
        color: #15803d;
        font-weight: 600;
    }
</style>

<div class="zx-page-head">
    <h1>Price History</h1>
</div>

<div class="zx-card">
    <div class="table-responsive">
    <table class="table zx-table mb-0">
        <thead>
            <tr>
                <th>Date</th>
                <th>Product</th>
                <th>Classification</th>
                <th>Panel</th>
                <th>Old Price</th>
                <th>New Price</th>
                <th>Changed By</th>
                <th class="text-end pe-3">Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var h in Model)
            {
                <tr>
                    <td>@h.DateChanged.ToString("MMM d, yyyy h:mm tt")</td>
                    <td>@h.Pricing.Product.ProductName</td>
                    <td>@h.Pricing.VehicleClassification.ClassificationName</td>
                    <td>@h.Pricing.Panel.PanelName</td>
                    <td>@("₱" + h.OldPrice.ToString("N2"))</td>
                    <td class="@(h.NewPrice > h.OldPrice ? "up" : "down")">@("₱" + h.NewPrice.ToString("N2"))</td>
                    <td>@h.User.UserName</td>
                    <td class="text-end pe-3">
                        <a asp-controller="Pricing" asp-action="Details" asp-route-id="@h.PricingID" class="icon-btn" title="View pricing">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2.062 12.348a1 1 0 0 1 0-.696 10.75 10.75 0 0 1 19.876 0 1 1 0 0 1 0 .696 10.75 10.75 0 0 1-19.876 0" /><circle cx="12" cy="12" r="3" /></svg>
                        </a>
                    </td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="8" class="text-center text-muted py-4">No price changes recorded yet.</td>
                </tr>
            }
        </tbody>
    </table>
    </div>
</div>
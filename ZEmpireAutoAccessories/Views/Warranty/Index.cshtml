@model IEnumerable<ZEmpireAutoAccessories.Models.Warranty>

@{
    ViewData["Title"] = "Warranty";
    var status = ViewData["Status"] as string;
    var search = ViewData["Search"] as string;
    var successMessage = ViewData["Success"] as string;
    var claimError = ViewData["ClaimError"] as string;
}

<style>
    .icon-btn.claim:hover { background:#16a34a; color:#fff; border-color:#16a34a; }
    .badge-active { background:rgba(34,197,94,.15); color:#15803d; font-weight:600; }
    .badge-expired { background:rgba(148,163,184,.2); color:#64748b; font-weight:600; }
    .badge-voided { background:rgba(239,68,68,.15); color:#b91c1c; font-weight:600; }
    .badge-claimed { background:rgba(245,158,11,.15); color:#b45309; font-weight:600; }

    .status-filters { display:flex; gap:8px; margin-bottom:20px; flex-wrap:wrap; }
    .status-pill { padding:7px 16px; border-radius:999px; font-size:13.5px; font-weight:600; text-decoration:none;
                   border:1px solid #e8ebf0; background:#fff; color:#4b5563; transition:all .15s ease; }
    .status-pill:hover { border-color:#c7ccd6; color:#0b0b0c; }
    .status-pill.active { color:#fff; border-color:transparent; }
    .status-pill.all.active { background:#0b0b0c; }
    .status-pill.status-active.active { background:#16a34a; }
    .status-pill.status-expired.active { background:#64748b; }
    .status-pill.status-claimed.active { background:#d97706; }
    .status-pill.status-voided.active { background:#dc2626; }
    .search-actions { display:flex; gap:8px; margin-top:8px; margin-bottom:18px; }
</style>

<div class="zx-page-head">
    <h1>Warranty</h1>
    <a class="btn btn-zx" asp-action="Create">+ New Warranty</a>
</div>

@if (!string.IsNullOrEmpty(successMessage))
{
    <div class="alert alert-success">@successMessage</div>
}
@if (!string.IsNullOrEmpty(claimError))
{
    <div class="alert alert-danger">@claimError</div>
}

<form asp-action="Index" method="get">
    <input type="hidden" name="status" value="@status" />
    <div class="search-wrap">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
        <input type="text" name="q" value="@search" class="form-control search-input" placeholder="Search invoice, product, job order, or customer" />
    </div>
    <div class="search-actions">
        <button type="submit" class="btn btn-outline-secondary btn-sm">Search</button>
        @if (!string.IsNullOrEmpty(search))
        {
            <a asp-action="Index" asp-route-status="@status" class="btn btn-outline-secondary btn-sm">Clear</a>
        }
    </div>
</form>

<div class="status-filters">
    <a asp-action="Index" asp-route-q="@search" class="status-pill all @(status == null ? "active" : "")">All</a>
    <a asp-action="Index" asp-route-status="Active" asp-route-q="@search" class="status-pill status-active @(status == "Active" ? "active" : "")">Active</a>
    <a asp-action="Index" asp-route-status="Expired" asp-route-q="@search" class="status-pill status-expired @(status == "Expired" ? "active" : "")">Expired</a>
    <a asp-action="Index" asp-route-status="Claimed" asp-route-q="@search" class="status-pill status-claimed @(status == "Claimed" ? "active" : "")">Claimed</a>
    <a asp-action="Index" asp-route-status="Voided" asp-route-q="@search" class="status-pill status-voided @(status == "Voided" ? "active" : "")">Voided</a>
</div>

<div class="zx-card">
    <div class="table-responsive">
    <table class="table zx-table mb-0">
        <thead>
            <tr>
                <th>Linked To</th>
                <th>Start Date</th>
                <th>End Date</th>
                <th>Status</th>
                <th class="text-end pe-3">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        @if (item.SalesDetail != null)
                        {
                            @($"Sale {item.SalesDetail.Sale.InvoiceNumber} — {item.SalesDetail.Product.ProductName}")
                        }
                        else if (item.ServiceInvoiceDetail != null)
                        {
                            @($"Invoice {item.ServiceInvoiceDetail.ServiceInvoice.InvoiceNumber}")
                        }
                        else if (item.JobOrder != null)
                        {
                            @($"Job Order {item.JobOrder.JobOrderNumber}")
                        }
                        else
                        {
                            @:—
                        }
                    </td>
                    <td>@(item.WarrantyStartDate?.ToString("MMM d, yyyy") ?? "—")</td>
                    <td>@(item.WarrantyEndDate?.ToString("MMM d, yyyy") ?? "—")</td>
                    <td>
                        @if (!string.IsNullOrEmpty(item.WarrantyStatus))
                        {
                            <span class="badge badge-@item.WarrantyStatus.ToLower()">@item.WarrantyStatus</span>
                        }
                        else
                        {
                            @:—
                        }
                    </td>
                    <td class="text-end pe-3">
                        @if (item.WarrantyStatus == "Active")
                        {
                            <a asp-action="Claim" asp-route-id="@item.WarrantyID" class="icon-btn claim" title="Claim warranty">
                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/><path d="m9 12 2 2 4-4"/></svg>
                            </a>
                        }
                        <a asp-action="Details" asp-route-id="@item.WarrantyID" class="icon-btn" title="View details">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2.062 12.348a1 1 0 0 1 0-.696 10.75 10.75 0 0 1 19.876 0 1 1 0 0 1 0 .696 10.75 10.75 0 0 1-19.876 0"/><circle cx="12" cy="12" r="3"/></svg>
                        </a>
                        <a asp-action="Edit" asp-route-id="@item.WarrantyID" class="icon-btn" title="Edit">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/><path d="m15 5 4 4"/></svg>
                        </a>
                        <a asp-action="Delete" asp-route-id="@item.WarrantyID" class="icon-btn danger" title="Delete">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"/><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                        </a>
                    </td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="5" class="text-center text-muted py-4">No warranty records yet.</td>
                </tr>
            }
        </tbody>
    </table>
    </div>
</div>

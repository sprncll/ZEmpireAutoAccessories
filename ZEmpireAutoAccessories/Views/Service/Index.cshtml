@model IEnumerable<ZEmpireAutoAccessories.Models.Service>

@{
    ViewData["Title"] = "Services";
}

<style>

    .badge-active {
        background: rgba(34,197,94,.15);
        color: #15803d;
        font-weight: 600;
    }

    .badge-inactive {
        background: rgba(148,163,184,.2);
        color: #64748b;
        font-weight: 600;
    }
</style>

<div class="zx-page-head">
    <h1>Services</h1>
    <a class="btn btn-zx" asp-action="Create">+ New Service</a>
</div>

<div class="zx-card">
    <div class="table-responsive">
    <table class="table zx-table mb-0">
        <thead>
            <tr>
                <th>Name</th>
                <th>Category</th>
                <th>Default Price</th>
                <th>Status</th>
                <th class="text-end pe-3">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.ServiceName</td>
                    <td>@item.ServiceCategory.CategoryName</td>
                    <td>@("₱" + item.DefaultPrice.ToString("N2"))</td>
                    <td>
                        @if (item.IsActive)
                        {
                            <span class="badge badge-active">Active</span>
                        }
                        else
                        {
                            <span class="badge badge-inactive">Inactive</span>
                        }
                    </td>
                    <td class="text-end pe-3">
                        <a asp-action="Details" asp-route-id="@item.ServiceID" class="icon-btn" title="View details">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2.062 12.348a1 1 0 0 1 0-.696 10.75 10.75 0 0 1 19.876 0 1 1 0 0 1 0 .696 10.75 10.75 0 0 1-19.876 0" /><circle cx="12" cy="12" r="3" /></svg>
                        </a>
                        <a asp-action="Edit" asp-route-id="@item.ServiceID" class="icon-btn" title="Edit">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z" /><path d="m15 5 4 4" /></svg>
                        </a>
                        <a asp-action="Delete" asp-route-id="@item.ServiceID" class="icon-btn danger" title="Delete">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18" /><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6" /><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" /></svg>
                        </a>
                    </td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="5" class="text-center text-muted py-4">No services yet.</td>
                </tr>
            }
        </tbody>
    </table>
    </div>
</div>
erDiagram
    %% ---------- crm ----------
    CUSTOMER {
        int CustomerID PK
        string FullName
        string ContactNumber
        datetime CreatedAt
    }
    VEHICLE_CLASSIFICATION {
        int VehicleClassificationID PK
        string ClassificationName
    }
    VEHICLE {
        int VehicleID PK
        int CustomerID FK
        int VehicleClassificationID FK
        string PlateNumber
        string Brand
        string Model
        short ManufacturingYear
    }
    VEHICLE_MODEL_GUIDE {
        int VehicleModelGuideID PK
        int VehicleClassificationID FK
        string Brand
        string ModelName
    }

    %% ---------- cat ----------
    PRODUCT_CATEGORY {
        int CategoryID PK
        string CategoryName
    }
    PRODUCT {
        int ProductID PK
        int CategoryID FK
        string ProductName
        decimal DefaultPrice
        bool IsActive
    }
    TINT_VARIANT {
        int TintVariantID PK
        int ProductID FK
        string VariantName
    }
    SHADE {
        int ShadeID PK
        int TintVariantID FK
        string ShadeName
    }
    PANEL {
        int PanelID PK
        string PanelName
    }
    SERVICE_CATEGORY {
        int ServiceCategoryID PK
        string CategoryName
    }
    SERVICE {
        int ServiceID PK
        int ServiceCategoryID FK
        string ServiceName
        decimal DefaultPrice
        bool IsActive
    }
    JOB_TYPE {
        int JobTypeID PK
        string JobTypeName
    }
    PRICING {
        int PricingID PK
        int ProductID FK
        int TintVariantID FK
        int VehicleClassificationID FK
        int PanelID FK
        decimal Price
    }
    PRICE_HISTORY {
        int HistoryID PK
        int PricingID FK
        string UserId FK
        decimal OldPrice
        decimal NewPrice
        datetime DateChanged
    }

    %% ---------- inv ----------
    INVENTORY_TRANSACTION {
        int InventoryTransactionID PK
        int ProductID FK
        string UserId FK
        string TransactionType
        decimal Quantity
        datetime TransactionDate
    }
    INVENTORY_CHECK {
        int InventoryCheckID PK
        string UserId FK
        datetime CheckDate
    }
    INVENTORY_CHECK_DETAIL {
        int InventoryCheckDetailID PK
        int InventoryCheckID FK
        int ProductID FK
        int TintVariantID FK
        int ShadeID FK
        decimal PhysicalStock
        string StockLevel
        string Unit
    }

    %% ---------- sales ----------
    PAYMENT_MODE {
        int PaymentModeID PK
        string PaymentModeName
    }
    INVOICE_NO_SERIES {
        int InvoiceNoSeriesID PK
        string UserId FK
        int SeriesYear
        string Prefix
        int CurrentNumber
        bool IsActive
    }
    QUOTATION {
        int QuotationID PK
        string QuotationNumber
        int CustomerID FK
        int VehicleID FK
        string UserId FK
        int JobTypeID FK
        decimal TotalAmount
        string Status
    }
    QUOTATION_DETAIL {
        int QuotationDetailID PK
        int QuotationID FK
        int ProductID FK
        int ServiceID FK
        int TintVariantID FK
        int ShadeID FK
        int PanelID FK
        int PricingID FK
        int Quantity
        decimal UnitPrice
    }
    SALES {
        int SalesID PK
        string InvoiceNumber
        int CustomerID FK
        int VehicleID FK
        string UserId FK
        int PaymentModeID FK
        datetime SalesDate
        decimal TotalAmount
    }
    SALES_DETAIL {
        int SalesDetailID PK
        int SalesID FK
        int ProductID FK
        int Quantity
        decimal UnitPrice
    }
    SERVICE_INVOICE {
        int ServiceInvoiceID PK
        string InvoiceNumber
        int InvoiceNoSeriesID FK
        int JobOrderID FK
        int CustomerID FK
        int VehicleID FK
        string UserId FK
        int PaymentModeID FK
        decimal TotalAmount
        decimal AmountPaid
        string Status
    }
    SERVICE_INVOICE_DETAIL {
        int ServiceInvoiceDetailID PK
        int ServiceInvoiceID FK
        int ProductID FK
        int ServiceID FK
        int TintVariantID FK
        int ShadeID FK
        int PanelID FK
        decimal Quantity
        decimal UnitPrice
    }
    WARRANTY {
        int WarrantyID PK
        int SalesDetailID FK
        int ServiceInvoiceDetailID FK
        int JobOrderID FK
        date WarrantyStartDate
        date WarrantyEndDate
        string WarrantyStatus
    }

    %% ---------- ops ----------
    JOB_ORDER {
        int JobOrderID PK
        string JobOrderNumber
        int CustomerID FK
        int VehicleID FK
        string UserId FK
        int JobTypeID FK
        int AssignedEmployeeID FK
        int QuotationID FK "unique"
        string Status
        datetime InstallationDate
    }
    JOB_ORDER_DETAIL {
        int JobOrderDetailID PK
        int JobOrderID FK
        int ProductID FK
        int ServiceID FK
        int TintVariantID FK
        int ShadeID FK
        int PanelID FK
        int PricingID FK
        int Quantity
        decimal UnitPrice
    }
    VEHICLE_CHECKLIST {
        int ChecklistID PK
        int JobOrderID FK
        string UserId FK
        datetime ChecklistDate
    }
    VEHICLE_CHECKLIST_DETAIL {
        int VehicleChecklistDetailID PK
        int ChecklistID FK
        int PanelID FK
        string ExistingCondition
    }

    %% ---------- sec / asp ----------
    EMPLOYEE {
        int EmployeeID PK
        string UserId FK
        string EmployeeNumber
        string FirstName
        string LastName
        bool IsActive
    }
    MODULE {
        int ModuleID PK
        string ModuleName
    }
    ROLE_PERMISSION {
        string RoleId PK,FK
        int ModuleID PK,FK
    }
    ASPNETUSERS {
        string Id PK
        string UserName
        string FullName
    }
    ASPNETROLES {
        string Id PK
        string Name
    }
    ASPNETUSERROLES {
        string UserId PK,FK
        string RoleId PK,FK
    }


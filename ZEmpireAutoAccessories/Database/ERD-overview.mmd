        string Unit
    }

    %% ---------- sales ----------
    PAYMENT_MODE {
        int PaymentModeID PK
        string PaymentModeName
    }
    INVOICE_NO_SERIES {
        int InvoiceNoSeriesID PK
        int SeriesYear

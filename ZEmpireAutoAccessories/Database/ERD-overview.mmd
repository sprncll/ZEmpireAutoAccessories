        int VehicleClassificationID PK
        string ClassificationName
    }
    VEHICLE {
        int VehicleID PK
        string PlateNumber
        string Brand
        string Model
        short ManufacturingYear
    }
    VEHICLE_MODEL_GUIDE {
        int VehicleModelGuideID PK
        string Brand
        string ModelName
    }

    %% ---------- cat ----------
    PRODUCT_CATEGORY {
        int CategoryID PK
        string CategoryName
    }
    PRODUCT {
        int ProductID PK
        string ProductName
        decimal DefaultPrice
        bool IsActive
    }
    TINT_VARIANT {
        int TintVariantID PK
        string VariantName
    }
    SHADE {
        int ShadeID PK
        string ShadeName
    }
    PANEL {
        int PanelID PK
        string PanelName
    }

        string Id PK
        string UserName
        string FullName
    }
    ASPNETROLES {
        string Id PK
        string Name
    }
    ASPNETUSERROLES {
    }

    %% ---------- relationships ----------
    CUSTOMER ||--o{ VEHICLE : owns
    VEHICLE_CLASSIFICATION ||--o{ VEHICLE : classifies
    VEHICLE_CLASSIFICATION ||--o{ VEHICLE_MODEL_GUIDE : guides

    PRODUCT_CATEGORY ||--o{ PRODUCT : groups
    PRODUCT ||--o{ TINT_VARIANT : has
    TINT_VARIANT ||--o{ SHADE : has
    SERVICE_CATEGORY ||--o{ SERVICE : groups

    PRODUCT ||--o{ PRICING : priced_by
    TINT_VARIANT o|--o{ PRICING : variant_of
    VEHICLE_CLASSIFICATION ||--o{ PRICING : for_class
    PANEL ||--o{ PRICING : for_panel
    PRICING ||--o{ PRICE_HISTORY : journals

    PRODUCT ||--o{ INVENTORY_TRANSACTION : moves
    INVENTORY_CHECK ||--|{ INVENTORY_CHECK_DETAIL : lists
    PRODUCT ||--o{ INVENTORY_CHECK_DETAIL : counts

    CUSTOMER ||--o{ QUOTATION : requests
    VEHICLE ||--o{ QUOTATION : for
    JOB_TYPE o|--o{ QUOTATION : typed
    QUOTATION ||--|{ QUOTATION_DETAIL : lists
    PRODUCT o|--o{ QUOTATION_DETAIL : line
    SERVICE o|--o{ QUOTATION_DETAIL : line

    QUOTATION o|--o| JOB_ORDER : becomes
    CUSTOMER ||--o{ JOB_ORDER : places
    VEHICLE ||--o{ JOB_ORDER : serviced
    JOB_TYPE o|--o{ JOB_ORDER : typed
    EMPLOYEE o|--o{ JOB_ORDER : assigned
    JOB_ORDER ||--|{ JOB_ORDER_DETAIL : lists
    PRODUCT o|--o{ JOB_ORDER_DETAIL : line
    SERVICE o|--o{ JOB_ORDER_DETAIL : line
    JOB_ORDER ||--o{ VEHICLE_CHECKLIST : inspected
    VEHICLE_CHECKLIST ||--|{ VEHICLE_CHECKLIST_DETAIL : lists
    PANEL ||--o{ VEHICLE_CHECKLIST_DETAIL : panel

    CUSTOMER ||--o{ SALES : buys
    VEHICLE o|--o{ SALES : for
    PAYMENT_MODE ||--o{ SALES : paid_by
    SALES ||--|{ SALES_DETAIL : lists
    PRODUCT ||--o{ SALES_DETAIL : sold

    JOB_ORDER o|--o{ SERVICE_INVOICE : billed
    INVOICE_NO_SERIES ||--o{ SERVICE_INVOICE : numbers
    CUSTOMER ||--o{ SERVICE_INVOICE : billed_to
    VEHICLE o|--o{ SERVICE_INVOICE : for
    PAYMENT_MODE ||--o{ SERVICE_INVOICE : paid_by
    SERVICE_INVOICE ||--|{ SERVICE_INVOICE_DETAIL : lists
    PRODUCT o|--o{ SERVICE_INVOICE_DETAIL : line
    SERVICE o|--o{ SERVICE_INVOICE_DETAIL : line

    SALES_DETAIL o|--o{ WARRANTY : covers
    SERVICE_INVOICE_DETAIL o|--o{ WARRANTY : covers
    JOB_ORDER o|--o{ WARRANTY : covers

    ASPNETUSERS ||--o{ EMPLOYEE : is
    ASPNETROLES ||--o{ ROLE_PERMISSION : granted
    MODULE ||--o{ ROLE_PERMISSION : allows
    ASPNETUSERS ||--o{ ASPNETUSERROLES : has
    ASPNETROLES ||--o{ ASPNETUSERROLES : in
